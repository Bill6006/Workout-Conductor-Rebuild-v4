+        continue
+    path = ROOT / rel
+    original = path.read_bytes().decode("utf-8")
+    mutated, bad = apply(original, old, new, nth)
+    if bad:
+        results.append((name, bad, ""))
+        print(f"{bad:9} {name}", flush=True)
+        continue
+    if check:
+        continue
+    try:
+        path.write_bytes(mutated.encode("utf-8"))
