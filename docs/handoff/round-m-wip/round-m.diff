+++ b/src/engine/recalibration/catchUpOneSetStandIn.test.ts
@@ -0,0 +1,144 @@
+import { describe, expect, it } from 'vitest';
+import { CATCH_UP, type CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+} from '../../engine/recalibration/recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationRequest,
+  RecalibrationResult,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+} from '../../engine/recalibration/types';
+import { allEntries, isStopped, type GeneratedWorkout } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import {
+  at,
+  describeWorkout,
+  directSets,
+  gym,
+  profileOf,
+  session,
+  working,
+} from '../../test/clockDays';
+
+/**
+ * Maintenance 31 (the twelfth review of round M): what comes in for a lift begun in a catch-up counts the sets
+ * the lift has done as given, as the plan's own budget counts a stopped lift's (the eleventh review's
+ * `givenBeside` passes over the lift itself). Two of the back squat's three sets done, the quads and
+ * the glutes have one set left: no lift takes it (CATCH_UP.MIN_SETS), as the plan's own picks do not.
+ * Before: a stand-in with one working set came in, and the next rebuild left it out. Synthetic data
+ * only.
+ */
+
+// A row last Thursday: nothing the day is for rests on Wednesday the 9th, at 6 pm, a day the default
+// profile does not tick.
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['quads', 'glutes', 'chest'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+const succeeded = (result: RecalibrationResult): RecalibrationSuccess => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+const request = (
+  trigger: RecalibrationTrigger,
+  workout: GeneratedWorkout,
+  options: Partial<RecalibrationRequest> = {},
+): RecalibrationRequest => ({
+  trigger,
+  workout,
+  completed: emptyCompleted(),
+  lockedEntryIds: [],
+  currentEntryId: null,
+  duration: 'default',
+  profile: profileOf(),
+  location: gym,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints: { ...emptyConstraints(), catchUp: spec },
+  reason: 'test',
+  timestamp: NOW,
+  ...options,
+});
+
+describe('what comes in for a lift begun counts its sets done, the twelfth review of round M', () => {
+  it.each([
+    [
+      '"Uncomfortable"',
+      (entryId: string): RecalibrationTrigger => ({ type: 'uncomfortable', entryId }),
+    ],
+    [
+      '"Hurts" (knee)',
+      (entryId: string): RecalibrationTrigger => ({ type: 'pain', entryId, joint: 'knee' }),
+    ],
+  ])('two of the back squat’s three sets done, then %s, then "45 min"', (_, tap) => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const squat = allEntries(plan.blocks).find((entry) => entry.exerciseId === 'back-squat');
+    expect(squat, lifts(plan)).toBeDefined();
+    expect(working(squat!).length, lifts(plan)).toBe(3);
+    const completed: CompletedWork = {
+      ...emptyCompleted(),
+      startedAt: NOW,
+      elapsedSeconds: 600,
+      sets: working(squat!)
+        .slice(0, 2)
+        .map((set, index) => ({
+          entryId: squat!.id,
+          exerciseId: squat!.exerciseId,
+          setIndex: set.index,
+          kind: 'working' as const,
+          reps: 5,
+          weight: set.targetWeight,
+          rir: 2,
+          completedAt: at(9, 18, index * 4),
+        })),
+    };
+    const tapped = recalibrate(
+      request(tap(squat!.id), plan, { completed, currentEntryId: squat!.id }),
+    );
+    expect(tapped.ok ? 'changed' : tapped.error).toBe('changed');
+    const after = succeeded(tapped).workout;
+    // No lift still to do takes fewer than two working sets. Before: "back-squat x3 (2 done,
+    // stopped); leg-press x1" ("Uncomfortable"), "trap-bar-deadlift x1" ("Hurts").
+    expect(
+      allEntries(after.blocks)
+        .filter((entry) => !isStopped(entry) && working(entry).length < CATCH_UP.MIN_SETS)
+        .map((entry) => `${entry.exerciseId} x${working(entry).length}`),
+      lifts(after),
+    ).toEqual([]);
+    expect(directSets(after, 'quads'), lifts(after)).toBeLessThanOrEqual(3);
+    // The next rebuild, a length picked, leaves nothing out. Before: "Recalibrated to 45 min with 10
+    // min done: 1 exercise removed." ("Left out Leg Press.").
+    const shorter = succeeded(
+      recalibrate(
+        request({ type: 'duration', choice: 45 }, after, {
+          completed,
+          constraints: succeeded(tapped).constraints,
+        }),
+      ),
+    );
+    expect(
+      shorter.changes.filter((change) => change.kind === 'removed').map((change) => change.detail),
+      `${shorter.summary.headline} ${lifts(after)} -> ${lifts(shorter.workout)}`,
+    ).toEqual([]);
+  });
+});
diff --git a/src/engine/recalibration/catchUpPlaceStopAfterSkip.test.ts b/src/engine/recalibration/catchUpPlaceStopAfterSkip.test.ts
new file mode 100644
index 0000000..1d70e03
--- /dev/null
+++ b/src/engine/recalibration/catchUpPlaceStopAfterSkip.test.ts
@@ -0,0 +1,161 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, isStopped, type GeneratedWorkout, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Seventeenth review of round M: a regression from the sixteenth pass. A lift stopped because a
+ * place could not equip it "picks up again where it fits" (`StoppedWork`, `why: 'place'`), and the
+ * round keeps "a lift picked up again back at the gym" to the catch-up's sets. The sixteenth pass
+ * marks a lift stopped with nothing to come in, off the plan, `why: 'skip'` (owes nothing more). The
+ * generator reads what a slot owes as the least any of its stopped lifts owes (`owedBySlot`,
+ * `reopened`), so a stand-in stopped that way zeroes the slot: the plan's own lift, stopped only by
+ * the place, never picks up again back where it fits, and its muscle loses the set the stand-in
+ * could not take. On 89dfb39 the bench press picked up its last set at the gym.
+ *
+ * Steps (synthetic data only): a catch-up at the gym for the chest and the side delts, the bench
+ * press for three sets. One set done, the lifter moves home (dumbbells): the bench press stops at its
+ * set, the push-up stands in for two. A set of it done, "Uncomfortable": "Push-Up stops at the sets
+ * done: one set left is too few for another lift to take over." Back at the gym: the bench press,
+ * which fits there, stays stopped ("Rebuilt for Gym: no changes needed."), the chest at two sets of
+ * its three.
+ *
+ * Passes on 89dfb39 (the bench press picks up again: barbell-bench-press x2, one set more).
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const NOW = at(9, 18);
+const profile = profileOf();
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [
+    { muscle: 'chest', sets: 3, minRir: 1, why: 'behind' },
+    { muscle: 'side-delts', sets: 3, minRir: 1, why: 'behind' },
+  ],
+  sitOut: [],
+};
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+
+function day() {
+  let location: LocationProfile = gym!;
+  let workout: GeneratedWorkout = generateWorkout({
+    profile,
+    location,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+  let constraints: SessionConstraints = { ...emptyConstraints(), catchUp: spec };
+  let completed: CompletedWork = { ...emptyCompleted(), startedAt: NOW, elapsedSeconds: 60 };
+  let clock = 1;
+  const steps: string[] = [lifts(workout)];
+  return {
+    get workout() {
+      return workout;
+    },
+    get completed() {
+      return completed;
+    },
+    steps,
+    log(entry: WorkoutEntry) {
+      const set = working(entry).find(
+        (each) =>
+          !completed.sets.some((done) => done.entryId === entry.id && done.setIndex === each.index),
+      )!;
+      clock += 3;
+      completed = {
+        ...completed,
+        elapsedSeconds: completed.elapsedSeconds + 180,
+        currentEntryId: entry.id,
+        sets: [
+          ...completed.sets,
+          {
+            entryId: entry.id,
+            exerciseId: entry.exerciseId,
+            setIndex: set.index,
+            kind: 'working',
+            reps: 8,
+            weight: set.targetWeight,
+            rir: 2,
+            completedAt: at(9, 18, clock),
+          },
+        ],
+      };
+      steps.push(`log ${entry.exerciseId}`);
+    },
+    run(trigger: RecalibrationTrigger, at_?: LocationProfile): RecalibrationSuccess {
+      if (at_) location = at_;
+      const result = recalibrate({
+        trigger,
+        workout,
+        completed,
+        lockedEntryIds: [],
+        currentEntryId: completed.currentEntryId,
+        duration: 'default',
+        profile,
+        location,
+        loading: { missingPlates: [] },
+        history: records,
+        constraints,
+        reason: 'test',
+        timestamp: at(9, 18, clock + 1),
+      });
+      if (!result.ok) throw new Error(result.error);
+      workout = result.workout;
+      constraints = result.constraints;
+      steps.push(`${trigger.type}: ${result.summary.headline} => ${lifts(workout)}`);
+      return result;
+    },
+  };
+}
+
+describe('a lift stopped by a place picks up again where it fits, its stand-in stopped since', () => {
+  it('the bench press stopped at home, the push-up stopped there for comfort, back at the gym', () => {
+    const today = day();
+    expect(lifts(today.workout)).toBe(
+      'barbell-bench-press x3 @RIR 2/2/2; lateral-raise x3 @RIR 1/1/1',
+    );
+    const bench = allEntries(today.workout.blocks)[0]!;
+    today.log(bench);
+    today.run({ type: 'location' }, home);
+    const pushUp = allEntries(today.workout.blocks).find(
+      (entry) => entry.exerciseId === 'push-up',
+    )!;
+    expect(working(pushUp)).toHaveLength(2);
+    today.log(pushUp);
+    const stop = today.run({ type: 'uncomfortable', entryId: pushUp.id });
+    expect(stop.summary.headline).toBe(
+      'Push-Up stops at the sets done: one set left is too few for another lift to take over.',
+    );
+    today.run({ type: 'location' }, gym!);
+    const benchNow = allEntries(today.workout.blocks).find((entry) => entry.id === bench.id)!;
+    // On 532aba6: the bench press stays stopped at its one set ("no changes needed").
+    expect(isStopped(benchNow), today.steps.join(' | ')).toBe(false);
+    // The chest's three sets, no more: the bench press's set, the push-up's, the bench press's last.
+    const done = new Set(today.completed.sets.map((set) => `${set.entryId}:${set.setIndex}`));
+    const chest = allEntries(today.workout.blocks)
+      .filter((entry) => ['barbell-bench-press', 'push-up'].includes(entry.exerciseId))
+      .reduce(
+        (sum, entry) =>
+          sum +
+          working(entry).filter((set) => !isStopped(entry) || done.has(`${entry.id}:${set.index}`))
+            .length,
+        0,
+      );
+    expect(chest, today.steps.join(' | ')).toBe(3);
+  });
+});
diff --git a/src/engine/recalibration/catchUpSheetDone.test.ts b/src/engine/recalibration/catchUpSheetDone.test.ts
