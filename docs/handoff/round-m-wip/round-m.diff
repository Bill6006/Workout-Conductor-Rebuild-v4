+      workout: plan,
+      completed,
+      lockedEntryIds: [],
+      currentEntryId: squat.id,
+      duration: 'default',
+      profile: profileOf(),
+      location: home,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints: { ...emptyConstraints(), catchUp: lower },
+      reason: 'test',
+      timestamp: NOW,
