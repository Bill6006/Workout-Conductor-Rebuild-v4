+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import type { CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+} from '../../engine/recalibration/recalibrate';
+import type { RecalibrationTrigger } from '../../engine/recalibration/types';
+import { allEntries, type GeneratedWorkout } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, directSets, profileOf, session } from '../../test/clockDays';
+
+/**
+ * Maintenance 31 (the twelfth review of round M): what comes in for a lift in a catch-up or a second workout
+ * takes no more sets than the day's muscles it works have left, as the plan's own pick would (the
+ * fewest left of any muscle it works directly). It kept the sets of the lift it replaced: the
+ * Romanian deadlift in for the back squat, the glutes' three sets, gave the hamstrings three for two
+ * (in a second workout, three for the two left of this morning's leg curls); the rear-delt fly in
+ * for the dumbbell row, the upper back's three, gave the rear delts three for two. Synthetic data
+ * only.
+ */
+
+// A row last Thursday: nothing the day is for rests on Wednesday the 9th, at 6 pm, a day the default
+// profile does not tick.
+const lastWeek = [session(at(3, 18), [['barbell-row', 3]])];
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const place = (equipment: string[]) =>
+  createDefaultLocations(
+    { gymAccess: false, homeEquipment: equipment as never },
+    at(1),
+  )[0] as LocationProfile;
+const short = (three: 'glutes' | 'upper-back', two: 'hamstrings' | 'rear-delts'): CatchUpSpec => ({
+  kind: 'catch-up',
+  muscles: [
+    { muscle: three, sets: 3, minRir: 1, why: 'behind' },
+    // Two sets short of its week: two today.
+    { muscle: two, sets: 2, minRir: 1, why: 'behind' },
+  ],
+  sitOut: [],
+});
+/** Thursday the 10th, 6 pm: leg curls this morning, two sets left of the hamstrings' dose. */
+const second: CatchUpSpec = {
+  kind: 'second',
+  muscles: [
+    { muscle: 'glutes', sets: 3, minRir: 1, why: 'behind' },
+    { muscle: 'hamstrings', sets: 2, minRir: 3, why: 'remainder' },
+  ],
+  sitOut: [],
+};
+const thisMorning = [...lastWeek, session(at(10, 8), [['leg-curl', 2]])];
+
+describe('what comes in for a lift keeps to its muscles’ sets, the twelfth review of round M', () => {
+  it.each([
+    [
+      '"Hurts" (knee) on the back squat, for the glutes: the Romanian deadlift, hamstrings two',
+      short('glutes', 'hamstrings'),
+      place(['barbell', 'squat-rack']),
+      'back-squat',
+      (entryId: string): RecalibrationTrigger => ({ type: 'pain', entryId, joint: 'knee' }),
+      lastWeek,
+      at(9, 18),
+    ],
+    [
+      '"Uncomfortable" on the dumbbell row, for the upper back: the rear-delt fly, rear delts two',
+      short('upper-back', 'rear-delts'),
+      place(['dumbbells']),
+      'dumbbell-row',
+      (entryId: string): RecalibrationTrigger => ({ type: 'uncomfortable', entryId }),
+      lastWeek,
+      at(9, 18),
+    ],
+    [
+      'a second workout, "Hurts" (knee) on the back squat: the hamstrings, trained this morning, two left',
+      second,
+      place(['barbell', 'squat-rack']),
+      'back-squat',
+      (entryId: string): RecalibrationTrigger => ({ type: 'pain', entryId, joint: 'knee' }),
+      thisMorning,
+      at(10, 18),
+    ],
+  ] as [
+    string,
+    CatchUpSpec,
+    LocationProfile,
+    string,
+    (id: string) => RecalibrationTrigger,
+    WorkoutRecord[],
+    string,
+  ][])('%s', (_, spec, location, tappedId, tap, history, now) => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location,
+      history,
+      now,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const tapped = allEntries(plan.blocks).find((entry) => entry.exerciseId === tappedId);
+    expect(tapped, lifts(plan)).toBeDefined();
+    for (const item of spec.muscles) {
+      expect(directSets(plan, item.muscle), `${item.muscle}: ${lifts(plan)}`).toBeLessThanOrEqual(
+        item.sets,
+      );
+    }
+    const result = recalibrate({
+      trigger: tap(tapped!.id),
+      workout: plan,
+      completed: emptyCompleted(),
+      lockedEntryIds: [],
+      currentEntryId: null,
+      duration: 'default',
+      profile: profileOf(),
+      location,
+      loading: { missingPlates: [] },
+      history,
+      constraints: { ...emptyConstraints(), catchUp: spec },
+      reason: 'test',
+      timestamp: now,
+    });
+    if (!result.ok) throw new Error(result.error);
+    // Before: "romanian-deadlift x3" (hamstrings 3 for 2), "rear-delt-fly x3" (rear delts 3 for 2).
+    for (const item of spec.muscles) {
+      expect(
+        directSets(result.workout, item.muscle),
+        `${item.muscle}: ${result.summary.headline} ${lifts(result.workout)}`,
+      ).toBeLessThanOrEqual(item.sets);
+    }
+  });
+
+  it('a lift begun, a ramp done: what comes in after it keeps to its muscles’ sets too', () => {
+    const spec = short('glutes', 'hamstrings');
+    const location = place(['barbell', 'squat-rack']);
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location,
+      history: lastWeek,
+      now: at(9, 18),
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const squat = allEntries(plan.blocks).find((entry) => entry.exerciseId === 'back-squat');
+    const ramp = squat?.sets.find((set) => set.kind === 'warmup');
+    expect(ramp, lifts(plan)).toBeDefined();
+    const result = recalibrate({
+      trigger: { type: 'pain', entryId: squat!.id, joint: 'knee' },
+      workout: plan,
+      completed: {
+        ...emptyCompleted(),
+        startedAt: at(9, 18),
+        elapsedSeconds: 120,
+        sets: [
+          {
+            entryId: squat!.id,
+            exerciseId: squat!.exerciseId,
+            setIndex: ramp!.index,
+            kind: 'warmup',
+            reps: 5,
+            weight: ramp!.targetWeight,
+            rir: null,
+            completedAt: at(9, 18),
+          },
+        ],
+      },
+      lockedEntryIds: [],
+      currentEntryId: squat!.id,
+      duration: 'default',
+      profile: profileOf(),
+      location,
+      loading: { missingPlates: [] },
+      history: lastWeek,
+      constraints: { ...emptyConstraints(), catchUp: spec },
+      reason: 'test',
+      timestamp: at(9, 18),
+    });
+    if (!result.ok) throw new Error(result.error);
+    for (const item of spec.muscles) {
+      expect(
+        directSets(result.workout, item.muscle),
+        `${item.muscle}: ${result.summary.headline} ${lifts(result.workout)}`,
+      ).toBeLessThanOrEqual(item.sets);
+    }
+  });
+});
diff --git a/src/engine/recalibration/catchUpComfortEasier.test.ts b/src/engine/recalibration/catchUpComfortEasier.test.ts
new file mode 100644
index 0000000..83cbf56
--- /dev/null
+++ b/src/engine/recalibration/catchUpComfortEasier.test.ts
@@ -0,0 +1,145 @@
+import { describe, expect, it } from 'vitest';
+import type { CatchUpSpec } from '../../engine/planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  RecalibrationRequest,
+  RecalibrationResult,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+} from './types';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Maintenance 31 (the fourteenth review of round M): the day's settings ("Make it easier", a
+ * check-in) reach what came in for comfort in a catch-up, as they reach the lifter's own pick.
+ * Synthetic data only.
+ */
+
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const succeeded = (result: RecalibrationResult): RecalibrationSuccess => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['chest', 'biceps', 'quads'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+const request = (
+  trigger: RecalibrationTrigger,
+  workout: GeneratedWorkout,
+  options: Partial<RecalibrationRequest> = {},
+): RecalibrationRequest => ({
+  trigger,
+  workout,
+  completed: emptyCompleted(),
+  lockedEntryIds: [],
+  currentEntryId: null,
+  duration: 'default',
+  profile: profileOf(),
+  location: gym,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints: { ...emptyConstraints(), catchUp: spec },
+  reason: 'test',
+  timestamp: NOW,
+  ...options,
+});
+const byId = (workout: GeneratedWorkout, id: string) =>
+  allEntries(workout.blocks).find((entry) => entry.id === id) as WorkoutEntry;
+const dose = (entry: WorkoutEntry) =>
+  `${entry.exerciseId} x${working(entry).length} @RIR ${Math.min(...working(entry).map((set) => set.targetRir))}`;
+/** Eased: a set fewer, or a rep more in reserve, as every other lift not begun takes it. */
+const eased = (before: WorkoutEntry, after: WorkoutEntry) =>
+  working(after).length < working(before).length ||
+  Math.min(...working(after).map((set) => set.targetRir)) >
+    Math.min(...working(before).map((set) => set.targetRir));
+const plan = () =>
+  generateWorkout({
+    profile: profileOf(),
+    location: gym,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+const comfortable = () => {
+  const workout = plan();
+  const curl = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'ez-bar-curl');
+  expect(curl, lifts(workout)).toBeDefined();
+  const comfort = succeeded(
+    recalibrate(request({ type: 'uncomfortable', entryId: curl!.id }, workout)),
+  );
+  const standIn = byId(comfort.workout, curl!.id);
+  expect(standIn.exerciseId, lifts(comfort.workout)).not.toBe('ez-bar-curl');
+  return { comfort, id: curl!.id };
+};
+/**
+ * The same lift asked of the plan as a swap the lifter makes: the swap sheet's own swap to it,
+ * which is locked on the entry and so settled to the new setting.
+ */
+const swapped = (exerciseId: string, id: string) =>
+  succeeded(recalibrate(request({ type: 'replace', entryId: id, exerciseId }, plan())));
+
+describe('"Make it easier" eases what came in for comfort, the fourteenth review of round M', () => {
+  it('the curl in for the EZ-bar curl, nothing begun', () => {
+    const { comfort, id } = comfortable();
+    const easier = succeeded(
+      recalibrate(
+        request({ type: 'intensity', direction: 'easier' }, comfort.workout, {
+          constraints: comfort.constraints,
+        }),
+      ),
+    );
+    // The same curl swapped in by the lifter, then "Make it easier": as a fresh plan holds it.
+    const own = swapped(byId(comfort.workout, id).exerciseId, id);
+    const ownEasier = succeeded(
+      recalibrate(
+        request({ type: 'intensity', direction: 'easier' }, own.workout, {
+          constraints: own.constraints,
+        }),
+      ),
+    );
+    const details = `${lifts(comfort.workout)} -> ${easier.summary.headline} ${lifts(easier.workout)} | the lifter's swap: ${lifts(own.workout)} -> ${lifts(ownEasier.workout)}`;
+    // On d361edf the curl that came in for comfort keeps the dose it had ("barbell-curl x3 @RIR 1"),
+    // while the lifts beside it are eased, and the same curl swapped in by the lifter goes to
+    // "barbell-curl x2 @RIR 2".
+    expect(eased(byId(own.workout, id), byId(ownEasier.workout, id)), details).toBe(true);
+    expect(eased(byId(comfort.workout, id), byId(easier.workout, id)), details).toBe(true);
+  });
+
+  it('the curl in for the EZ-bar curl, then a low check-in', () => {
+    const { comfort, id } = comfortable();
+    const low = succeeded(
+      recalibrate(
+        request(
+          {
+            type: 'readiness',
+            readiness: {
+              energy: 2,
+              soreness: 2,
+              sleep: 3,
+              motivation: 3,
+              jointDiscomfort: [],
+              timePressure: false,
+            },
+          },
+          comfort.workout,
+          { constraints: comfort.constraints },
+        ),
+      ),
+    );
+    const details = `${lifts(comfort.workout)} -> ${low.summary.headline} ${lifts(low.workout)} | ${dose(byId(low.workout, id))}`;
+    // On d361edf: "barbell-curl x3 @RIR 1" before and after, the bench press and the squat eased.
+    expect(eased(byId(comfort.workout, id), byId(low.workout, id)), details).toBe(true);
+  });
+});
