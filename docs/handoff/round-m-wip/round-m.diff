+    const history = [
+      session(at(3, 18), [
+        ['back-squat', 4],
+        ['romanian-deadlift', 3],
+        ['leg-extension', 3],
+      ]),
+      session(at(4, 18), [
+        ['barbell-bench-press', 4],
+        ['barbell-row', 4],
+      ]),
