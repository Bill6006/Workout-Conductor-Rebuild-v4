+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import { rankAlternatives } from '../alternatives/rankAlternatives';
+import type { CatchUpSpec } from '../planning/catchUp';
+import {
+  contextFor,
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+  swapsOffered,
+} from './recalibrate';
+import type { CompletedWork } from './types';
+import { allEntries, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Seventeenth review of round M. The fourteenth pass settled that "a lift with one set left in a
+ * catch-up has nothing come in for it, and the swap sheet and "Uncomfortable" say so, not that
+ * nothing fits". The sixteenth pass made the sheet of a finished lift say it is done "though nothing
+ * ranked" (`swapsOffered` checks the lift's own refusal first), but left the one-set case where it
+ * was: with no lift ranked at all, `swapsOffered` hands back the ranking's own reason untouched. A
+ * catch-up is often a lift with no alternative where the lifter is, so the sheet of the standing calf
+ * raise at a bare home, two of its three sets done, says "No safe alternative fits Home and your
+ * limitations.", while "Uncomfortable" on it says "Standing Calf Raise stops at the sets done: one
+ * set left is too few for another lift to take over." (found by the random runs too: a standing calf
+ * raise at a home with dumbbells, one of its two sets done).
+ *
+ * Steps (synthetic data only): a catch-up for the calves at a home with no equipment, the standing
+ * calf raise for three sets; two sets of it done; open its sheet.
+ *
+ * Also fails on 89dfb39.
+ */
+
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const [bare] = createDefaultLocations({ gymAccess: false, homeEquipment: [] }, at(1)) as [
+  LocationProfile,
+];
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [{ muscle: 'calves', sets: 3, minRir: 1, why: 'behind' }],
+  sitOut: [],
+};
+const constraints = { ...emptyConstraints(), catchUp: spec };
+const twoDone = (entry: WorkoutEntry): CompletedWork => ({
+  ...emptyCompleted(),
+  startedAt: NOW,
+  elapsedSeconds: 600,
+  currentEntryId: entry.id,
+  sets: working(entry)
+    .slice(0, 2)
+    .map((set, index) => ({
+      entryId: entry.id,
+      exerciseId: entry.exerciseId,
+      setIndex: set.index,
+      kind: 'working' as const,
+      reps: 15,
+      weight: set.targetWeight,
+      rir: 2,
+      completedAt: at(9, 18, index * 3),
+    })),
+});
+
+describe('the swap sheet of a lift with one set left and no alternative ranked', () => {
+  it('the standing calf raise at a bare home, two of its three sets done', () => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: bare,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const calf = allEntries(plan.blocks).find(
+      (entry) => entry.exerciseId === 'standing-calf-raise',
+    );
+    expect(describeWorkout(plan)).toEqual(['standing-calf-raise x3 @RIR 1/1/1']);
+    const completed = twoDone(calf!);
+    // As the Today and workout screens build the sheet.
+    const sheet = swapsOffered(
+      rankAlternatives({
+        current: requireExercise(calf!.exerciseId),
+        context: contextFor({ profile: profileOf(), location: bare }, constraints),
+        otherExercises: [],
+        plannedSets: { sets: calf!.sets.length, restSeconds: calf!.restSeconds },
+        limit: 6,
+      }),
+      { constraints, completed, history: records, timestamp: NOW },
+      plan,
+      calf!,
+    );
+    // The engine's own words for the lift.
+    const tried = recalibrate({
+      trigger: { type: 'uncomfortable', entryId: calf!.id },
+      workout: plan,
+      completed,
+      lockedEntryIds: [],
+      currentEntryId: calf!.id,
+      duration: 'default',
+      profile: profileOf(),
+      location: bare,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints,
+      reason: 'test',
+      timestamp: NOW,
+    });
+    expect(tried.ok ? tried.summary.headline : tried.error).toBe(
+      'Standing Calf Raise stops at the sets done: one set left is too few for another lift to take over.',
+    );
+    expect(sheet.candidates).toEqual([]);
+    // On 532aba6: "No safe alternative fits Home and your limitations."
+    expect(sheet.emptyReason).toBe(
+      'Standing Calf Raise has one set left, too few for another lift to take over.',
+    );
+  });
+});
diff --git a/src/engine/recalibration/catchUpSheetReason.test.ts b/src/engine/recalibration/catchUpSheetReason.test.ts
new file mode 100644
index 0000000..55df97a
--- /dev/null
+++ b/src/engine/recalibration/catchUpSheetReason.test.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import { rankAlternatives } from '../../engine/alternatives/rankAlternatives';
+import type { CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  contextFor,
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+  swapsOffered,
+} from './recalibrate';
+import type { CompletedWork } from './types';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Maintenance 31 (the fourteenth review of round M): a lift with one set left in a catch-up has
+ * nothing come in for it, and the swap sheet and "Uncomfortable" say so, not that nothing fits.
+ * Synthetic data only.
+ */
+
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const lower: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['quads', 'glutes', 'hamstrings'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+const constraints = { ...emptyConstraints(), catchUp: lower };
+const setsDone = (entry: WorkoutEntry, count: number): CompletedWork => ({
+  ...emptyCompleted(),
+  startedAt: NOW,
+  elapsedSeconds: 300 * count,
+  sets: working(entry)
+    .slice(0, count)
+    .map((set, index) => ({
+      entryId: entry.id,
+      exerciseId: entry.exerciseId,
+      setIndex: set.index,
+      kind: 'working' as const,
+      reps: 8,
+      weight: set.targetWeight,
+      rir: 2,
+      completedAt: at(9, 18, index * 4),
+    })),
+});
+
+describe('the swap sheet gives the refusal’s own reason, the fourteenth review of round M', () => {
+  it('the back squat, two of its three sets done: the sheet names its one set left', () => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: lower },
+    });
+    const squat = allEntries(plan.blocks).find((entry) => entry.exerciseId === 'back-squat')!;
+    expect(squat, lifts(plan)).toBeDefined();
+    expect(working(squat).length).toBe(3);
+    const completed = setsDone(squat, 2);
+    const sheet = swapsOffered(
+      rankAlternatives({
+        current: requireExercise(squat.exerciseId),
+        context: contextFor({ profile: profileOf(), location: gym }, constraints),
+        otherExercises: allEntries(plan.blocks)
+          .filter((other) => other.id !== squat.id)
+          .map((other) => requireExercise(other.exerciseId)),
+        plannedSets: { sets: squat.sets.length, restSeconds: squat.restSeconds },
+        limit: 6,
+      }),
+      { constraints, completed, history: records, timestamp: NOW },
+      plan,
+      squat,
+    );
+    // What the engine says when one of them is tried: the lift's one set left.
+    const tried = recalibrate({
+      trigger: { type: 'replace', entryId: squat.id, exerciseId: 'leg-press' },
+      workout: plan,
+      completed,
+      lockedEntryIds: [],
+      currentEntryId: squat.id,
+      duration: 'default',
+      profile: profileOf(),
+      location: gym,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints,
+      reason: 'test',
+      timestamp: NOW,
+    });
+    expect(tried.ok).toBe(false);
+    expect(tried.ok ? '' : tried.error).toMatch(/one set left/);
+    expect(sheet.candidates).toEqual([]);
+    // On d361edf: "Every alternative would give the catch-up’s muscles more than they lack today."
+    expect(sheet.emptyReason).not.toMatch(/more than they lack/);
+    expect(sheet.emptyReason).toMatch(/one set/i);
+  });
+
+  it('the back squat, two of its three sets done, "Uncomfortable": the headline names its one set left', () => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: lower },
+    });
+    const squat = allEntries(plan.blocks).find((entry) => entry.exerciseId === 'back-squat')!;
+    const completed = setsDone(squat, 2);
+    const result = recalibrate({
+      trigger: { type: 'uncomfortable', entryId: squat.id },
+      workout: plan,
+      completed,
+      lockedEntryIds: [],
+      currentEntryId: squat.id,
+      duration: 'default',
+      profile: profileOf(),
+      location: gym,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints,
+      reason: 'test',
+      timestamp: NOW,
+    });
+    if (!result.ok) throw new Error(result.error);
+    // On d361edf: "Back Squat stops at the sets done: no comfortable alternative fits Gym." — the
+    // gym has comfortable squats aplenty (the leg press, the hack squat); what stops it is the one
+    // set it owes.
+    expect(result.summary.headline).not.toMatch(/no comfortable alternative fits/);
+  });
+});
diff --git a/src/engine/recalibration/catchUpSlotOwnName.test.ts b/src/engine/recalibration/catchUpSlotOwnName.test.ts
new file mode 100644
index 0000000..3fcdd3c
--- /dev/null
+++ b/src/engine/recalibration/catchUpSlotOwnName.test.ts
@@ -0,0 +1,120 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Sixteenth review of round M. Names are settled once every lift is picked, and "the change list
+ * names only what changed". The fifteenth pass took a new name "past every name taken and every
+ * name the plan had" (a stand-in took the leg curl's name, "Replaced Leg Curl"), but only where the
+ * slot's own name (`e<slot + 1>`) is taken: the slot's own name may itself be a name the plan had
+ * for another lift, one this rebuild leaves out, and the change list then reads the new lift as
+ * that lift's replacement. A stand-in made in the workout is named one past the workout's names
+ * (`spareEntryId`), which is the own name of the first slot with no lift, often a slot the time fit
+ * left out.
+ *
+ * A lower day at home, 15 minutes: the goblet squat (e1, slot 0) and the dumbbell Romanian deadlift
+ * (e2, slot 1), the other slots left out for time. A set of the goblet squat, then "Hurts" (knee):
+ * the glute bridge stands in for it, named e3. "Uncomfortable" on the deadlift brings the dumbbell
+ * reverse lunge. Then "Make it harder": the glute bridge and the reverse lunge give way, and the
+ * Bulgarian split squat's slot (slot 2, own name e3) takes the reverse lunge, named e3. The change
+ * list: "Replaced Glute Bridge with Reverse Lunge." The reverse lunge replaced nothing in the glute
+ * bridge's place; the glute bridge was left out. Synthetic data only.
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const NOW = at(9, 18);
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const profile = profileOf();
+const lifts = (workout: GeneratedWorkout) =>
+  allEntries(workout.blocks)
+    .map((entry) => `${entry.id} ${entry.exerciseId} (slot ${entry.slot})`)
+    .join('; ');
+
+describe('a new lift is never named for a lift the same rebuild leaves out', () => {
+  it('a lower day at home, 15 min: the glute bridge in for pain, then "Make it harder"', () => {
+    let workout: GeneratedWorkout = generateWorkout({
+      profile,
+      location: home,
+      history: records,
+      now: NOW,
+      duration: 15,
+      constraints: { templateId: 'lower' },
+    });
+    let constraints: SessionConstraints = { ...emptyConstraints() };
+    expect(describeWorkout(workout)).toEqual([
+      'goblet-squat x3 @RIR 2/2/2',
+      'dumbbell-romanian-deadlift x2 @RIR 1/1',
+    ]);
+    const squat = allEntries(workout.blocks)[0]!;
+    const first = working(squat)[0]!;
+    const completed: CompletedWork = {
+      ...emptyCompleted(),
+      startedAt: NOW,
+      elapsedSeconds: 240,
+      currentEntryId: squat.id,
+      sets: [
+        {
+          entryId: squat.id,
+          exerciseId: squat.exerciseId,
+          setIndex: first.index,
+          kind: 'working',
+          reps: 10,
+          weight: first.targetWeight,
+          rir: 2,
+          completedAt: at(9, 18, 4),
+        },
+      ],
+    };
+    const run = (trigger: RecalibrationTrigger): RecalibrationSuccess => {
+      const result = recalibrate({
+        trigger,
+        workout,
+        completed,
+        lockedEntryIds: [],
+        currentEntryId: completed.currentEntryId,
+        duration: 15,
+        profile,
+        location: home,
+        loading: { missingPlates: [] },
+        history: records,
+        constraints,
+        reason: 'test',
+        timestamp: at(9, 18, 10),
+      });
+      if (!result.ok) throw new Error(result.error);
+      workout = result.workout;
+      constraints = result.constraints;
+      return result;
+    };
+    run({ type: 'pain', entryId: squat.id, joint: 'knee' });
+    const bridge = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'glute-bridge');
+    expect(bridge, lifts(workout)).toBeDefined();
+    const rdl = allEntries(workout.blocks).find(
+      (entry) => entry.exerciseId === 'dumbbell-romanian-deadlift',
+    )!;
+    run({ type: 'uncomfortable', entryId: rdl.id });
+    const before = lifts(workout);
+    const harder = run({ type: 'intensity', direction: 'harder' });
+    const detail = `${before} -> ${harder.summary.details.join(' / ')} | ${lifts(workout)}`;
+    // On 89dfb39: "Replaced Glute Bridge with Reverse Lunge.", the reverse lunge named e3 in slot 2.
+    const told = harder.changes.find(
+      (change) =>
+        change.kind === 'replaced' &&
+        change.previousExerciseId === 'glute-bridge' &&
+        change.exerciseId === 'reverse-lunge',
+    );
+    expect(told?.detail, detail).toBeUndefined();
+  });
+});
diff --git a/src/engine/recalibration/catchUpStandInNames.test.ts b/src/engine/recalibration/catchUpStandInNames.test.ts
new file mode 100644
index 0000000..4f535cd
--- /dev/null
+++ b/src/engine/recalibration/catchUpStandInNames.test.ts
@@ -0,0 +1,225 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+} from '../../engine/recalibration/recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationRequest,
+  RecalibrationResult,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+} from '../../engine/recalibration/types';
+import {
+  allEntries,
+  isStopped,
+  type GeneratedWorkout,
+  type WorkoutEntry,
+} from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Maintenance 31, names in a catch-up (the eleventh review of round M): a stand-in made in the
+ * workout (a swap, "Uncomfortable", "Hurts") takes a name past every name the plan's slots can
+ * take, and a rebuild that plans the same lift in its place keeps it, so the list of changes names
+ * only what changed. Synthetic data only.
+ */
+
+// A row last Thursday: nothing the day is for rests on Wednesday the 9th, at 6 pm, a day the default
+// profile does not tick.
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const named = (workout: GeneratedWorkout) =>
+  allEntries(workout.blocks)
+    .map((entry) => `${entry.id}:${entry.exerciseId}${isStopped(entry) ? ' (stopped)' : ''}`)
+    .join(', ');
+const behind = (...muscles: ('quads' | 'glutes' | 'chest' | 'biceps')[]): CatchUpSpec => ({
+  kind: 'catch-up',
+  muscles: muscles.map((muscle) => ({ muscle, sets: 3, minRir: 1, why: 'behind' as const })),
+  sitOut: [],
+});
+const succeeded = (result: RecalibrationResult): RecalibrationSuccess => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+/** A barbell, a rack and a bench: the back squat, swapped for weeks for the front squat, is out. */
+const [rack] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['barbell', 'squat-rack', 'flat-bench'] },
+  at(1),
+) as [LocationProfile];
+const frontForBack = [{ from: 'back-squat', to: 'front-squat', setAt: at(1), until: at(30) }];
+
+const request = (
+  trigger: RecalibrationTrigger,
+  workout: GeneratedWorkout,
+  spec: CatchUpSpec,
+  options: Partial<RecalibrationRequest> = {},
+): RecalibrationRequest => ({
+  trigger,
+  workout,
+  completed: emptyCompleted(),
+  lockedEntryIds: [],
+  currentEntryId: null,
+  duration: 'default',
+  profile: profileOf(),
+  location: gym,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints: { ...emptyConstraints(), catchUp: spec },
+  reason: 'test',
+  timestamp: NOW,
+  ...options,
+});
+
+/** One working set of the entry done, five minutes in. */
+const oneSetOf = (entry: WorkoutEntry): CompletedWork => {
+  const set = working(entry)[0]!;
+  return {
+    ...emptyCompleted(),
+    startedAt: NOW,
+    elapsedSeconds: 300,
+    sets: [
+      {
+        entryId: entry.id,
+        exerciseId: entry.exerciseId,
+        setIndex: set.index,
+        kind: 'working',
+        reps: 8,
+        weight: set.targetWeight,
+        rir: 2,
+        completedAt: NOW,
+      },
+    ],
+  };
+};
+
+describe('a stand-in the recalibrator made keeps its name in a catch-up, the eleventh review of round M', () => {
+  it.each([
+    [
+      '"Uncomfortable"',
+      (entryId: string): RecalibrationTrigger => ({ type: 'uncomfortable', entryId }),
+    ],
+    [
+      '"Hurts"',
+      (entryId: string): RecalibrationTrigger => ({ type: 'pain', entryId, joint: 'elbow' }),
+    ],
+  ])('a bench press begun, then %s, then "45 min": nothing left out or added', (_, tapped) => {
+    // The squat rack taken, the lifter does a set of the bench press first, the catch-up's second
+    // lift; the back squat, still to do, stays the lift in front of the lifter.
+    const spec = behind('quads', 'glutes', 'chest');
+    const atGym = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const [squat, bench] = allEntries(atGym.blocks);
+    expect([squat?.exerciseId, bench?.exerciseId], lifts(atGym)).toEqual([
+      'back-squat',
+      'barbell-bench-press',
+    ]);
+    const completed = oneSetOf(bench!);
+    const swapped = succeeded(
+      recalibrate(
+        request(tapped(bench!.id), atGym, spec, { completed, currentEntryId: bench!.id }),
+      ),
+    );
+    const stand = allEntries(swapped.workout.blocks).find(
+      (entry) => !isStopped(entry) && entry.slot === bench!.slot,
+    );
+    expect(stand, named(swapped.workout)).toBeDefined();
+    const shorter = succeeded(
+      recalibrate(
+        request({ type: 'duration', choice: 45 }, swapped.workout, spec, {
+          completed,
+          currentEntryId: squat!.id,
+          constraints: swapped.constraints,
+        }),
+      ),
+    );
+    // The rebuild puts the same lift in the slot for the sets still to come...
+    const after = allEntries(shorter.workout.blocks).find(
+      (entry) => !isStopped(entry) && entry.slot === bench!.slot,
+    );
+    expect(after?.exerciseId, named(shorter.workout)).toBe(stand!.exerciseId);
+    // ... under the same name. Before: another, and "Recalibrated to 45 min with 5 min done: 1
+    // exercise removed, 1 exercise added." ("Added Dumbbell Bench Press. | Left out Dumbbell Bench
+    // Press.").
+    expect(after?.id, named(shorter.workout)).toBe(stand!.id);
+    expect(
+      shorter.changes.filter((change) => change.kind !== 'adjusted').map((change) => change.detail),
+      `${shorter.summary.headline} ${named(swapped.workout)} -> ${named(shorter.workout)}`,
+    ).toEqual([]);
+  });
+
+  it('a curl begun, swapped by the lifter, then the rack: the glutes’ new lift reads as added', () => {
+    // At the gym the leg press for the quads and the glutes, and the EZ-bar curl. One set of the curl
+    // done, the lifter swaps it for the cable curl: the stand-in is named e3. At the rack the cable
+    // curl cannot go on and the barbell curl carries the curl's sets; the front squat, in for the back
+    // squat for weeks, works the quads alone, and the glutes take a slot of their own.
+    const spec = behind('quads', 'glutes', 'biceps');
+    const atGym = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec, swaps: frontForBack },
+    });
+    const curl = allEntries(atGym.blocks).find((entry) => entry.exerciseId === 'ez-bar-curl');
+    expect(curl, lifts(atGym)).toBeDefined();
+    const completed = oneSetOf(curl!);
+    const swapped = succeeded(
+      recalibrate(
+        request({ type: 'replace', entryId: curl!.id, exerciseId: 'cable-curl' }, atGym, spec, {
+          completed,
+          swaps: frontForBack,
+        }),
+      ),
+    );
+    const cable = allEntries(swapped.workout.blocks).find(
+      (entry) => entry.exerciseId === 'cable-curl',
+    );
+    expect(cable, named(swapped.workout)).toBeDefined();
+    const moved = succeeded(
+      recalibrate(
+        request({ type: 'location' }, swapped.workout, spec, {
+          completed,
+          location: rack,
+          swaps: frontForBack,
+          constraints: swapped.constraints,
+        }),
+      ),
+    );
+    const hinge = allEntries(moved.workout.blocks).find(
+      (entry) => entry.exerciseId === 'romanian-deadlift',
+    );
+    const barbell = allEntries(moved.workout.blocks).find(
+      (entry) => entry.exerciseId === 'barbell-curl',
+    );
+    expect([hinge, barbell].every(Boolean), named(moved.workout)).toBe(true);
+    const details = moved.changes.map((change) => change.detail).join(' | ');
+    // Before: "Replaced Cable Curl with Romanian Deadlift." and "Added Barbell Curl.", the
+    // glutes' lift taking the dropped stand-in's name.
+    expect(
+      moved.changes.find((change) => change.entryId === hinge!.id),
+      details,
+    ).toMatchObject({
+      kind: 'added',
+    });
+    expect(
+      moved.changes.find((change) => change.entryId === barbell!.id),
+      details,
+    ).toMatchObject({
+      kind: 'replaced',
+      previousExerciseId: 'cable-curl',
+    });
+  });
+});
diff --git a/src/engine/recalibration/catchUpStopReason.test.ts b/src/engine/recalibration/catchUpStopReason.test.ts
