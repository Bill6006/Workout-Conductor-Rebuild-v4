@@ -0,0 +1,319 @@
+import { describe, expect, it } from 'vitest';
+import type { MuscleId } from '../../catalog/muscles/muscles';
+import type { UserProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout, sessionDose } from '../workoutGenerator/generate';
+import { catchUpKind, catchUpSpec } from './catchUp';
+import { shortfallOf, weekModel } from './weekModel';
+import {
+  at,
+  describeWorkout,
+  directFor,
+  gym,
+  profileOf,
+  session,
+  working,
+} from '../../test/clockDays';
+
+/**
+ * Maintenance 31, the review of round M: a day's offer from end to end, as the store reads it (the
+ * kind, the week model, the spec, and the plan built from it). A muscle trained today takes only
+ * what is left of one session, three or more short of failure, and nothing more if it was trained
+ * in the 48 hours before; a muscle short of its week takes no more sets than it is short; a
+ * catch-up is shorter than the full session, takes no set to failure, and leaves the split's
+ * rotation as it was. Synthetic data only.
+ */
+
+function dayPlan(profile: UserProfile, history: WorkoutRecord[], now: string) {
+  const kind = catchUpKind(profile, history, now);
+  const week = weekModel({ profile, location: gym, history, now });
+  const spec = catchUpSpec(week, profile, kind!, (muscle) => sessionDose(profile, muscle));
+  const workout = generateWorkout({
+    profile,
+    location: gym,
+    history,
+    now,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+  return { kind, week, spec, workout };
+}
+
+const directSets = (workout: GeneratedWorkout, muscle: MuscleId) =>
+  directFor(workout, muscle).reduce((sum, entry) => sum + working(entry).length, 0);
+
+/** Last week's four sessions: a lifter in training. */
+const pushDay = (day: number) =>
+  session(at(day, 18), [
+    ['barbell-bench-press', 4],
+    ['incline-dumbbell-press', 3],
+    ['overhead-press', 3],
+    ['cable-fly', 3],
+    ['cable-triceps-pushdown', 3],
+    ['lateral-raise', 3],
+    ['barbell-curl', 3],
+  ]);
+const pullDay = (day: number) =>
+  session(at(day, 18), [
+    ['barbell-row', 4],
+    ['lat-pulldown', 3],
+    ['rear-delt-fly', 3],
+    ['barbell-curl', 3],
+    ['cable-triceps-pushdown', 3],
+    ['barbell-shrug', 3],
+  ]);
+const lowerDay = (day: number) =>
+  session(at(day, 18), [
+    ['back-squat', 4],
+    ['romanian-deadlift', 3],
+    ['bulgarian-split-squat', 3],
+    ['leg-curl', 3],
+    ['leg-extension', 3],
+    ['standing-calf-raise', 3],
+    ['plank', 2],
+  ]);
+const lastWeek = [pushDay(1), pullDay(2), lowerDay(3), pushDay(4)];
+/** Saturday the 12th, Thursday and Friday missed: a day not ticked, much behind. */
+const saturday = () => dayPlan(profileOf(), [...lastWeek, pushDay(7), pullDay(8)], at(12, 10));
+
+describe('which day offers what', () => {
+  it('counts a workout begun today as the first once a working set of it is done', () => {
+    // Wednesday the 9th, not ticked: Monday's workout makes it a catch-up day.
+    const monday = session(at(7, 18), [['back-squat', 3]]);
+    const begun = session(at(9, 7), [['barbell-bench-press', 2]]);
+    const warmUps = {
+      ...begun,
+      entries: begun.entries.map((entry) => ({
+        ...entry,
+        sets: entry.sets.map((set) => ({ ...set, kind: 'warmup' as const })),
+      })),
+    };
+    expect(catchUpKind(profileOf(), [monday, warmUps], at(9, 18))).toBe('catch-up');
+    expect(catchUpKind(profileOf(), [monday, begun], at(9, 18))).toBe('second');
+  });
+});
+
+describe('a muscle trained today', () => {
+  it('takes only what is left of one session, three or more in reserve, through a shared lift too', () => {
+    // Bench press, flyes and lateral raises last Thursday. This Tuesday morning's workout was cut
+    // short after one set of pushdowns: the triceps take what is left, while the muscles missed lead.
+    const history = [
+      session(at(3, 18), [
+        ['barbell-bench-press', 4],
+        ['cable-fly', 3],
+        ['lateral-raise', 5],
+      ]),
+      session(at(8, 7), [['cable-triceps-pushdown', 1]], { endedEarly: true }),
+    ];
+    const profile = profileOf();
+    const { kind, spec, workout } = dayPlan(profile, history, at(8, 18));
+    expect(kind).toBe('second');
+    const triceps = spec.muscles.find((item) => item.muscle === 'triceps');
+    expect(triceps).toEqual({ muscle: 'triceps', sets: 3, minRir: 3, why: 'remainder' });
+    expect(workout.explanation.reasons).toContain(
+      'Triceps take only what is left of one session, three or more reps short of failure.',
+    );
+    const lifts = describeWorkout(workout).join('; ');
+    expect(
+      directFor(workout, 'triceps')
+        .flatMap(working)
+        .every((set) => set.targetRir >= 3),
+      lifts,
+    ).toBe(true);
+    expect(directSets(workout, 'triceps'), lifts).toBeLessThanOrEqual(triceps!.sets);
+    // The day's two workouts together stay within one session's sets.
+    expect(1 + directSets(workout, 'triceps'), lifts).toBeLessThanOrEqual(
+      sessionDose(profile, 'triceps'),
+    );
+  });
+
+  it('takes nothing more when it was trained in the 48 hours before as well', () => {
+    // Monday lower, Tuesday pull, Friday evening push and arms. Saturday, not ticked, one set of
+    // pushdowns in the morning before the workout was cut short.
+    const week = [
+      session(at(7, 18), [
+        ['back-squat', 4],
+        ['romanian-deadlift', 3],
+        ['leg-extension', 3],
+      ]),
+      session(at(8, 18), [
+        ['barbell-row', 4],
+        ['lat-pulldown', 3],
+        ['barbell-curl', 3],
+      ]),
+      session(at(11, 18), [
+        ['barbell-bench-press', 4],
+        ['incline-dumbbell-press', 3],
+        ['cable-triceps-pushdown', 3],
+        ['lateral-raise', 3],
+      ]),
+    ];
+    const profile = profileOf();
+    // Without the morning's set: a catch-up, and the triceps rest.
+    const catchUp = dayPlan(profile, week, at(12, 18));
+    expect(catchUp.kind).toBe('catch-up');
+    expect(catchUp.spec.muscles.map((item) => item.muscle)).not.toContain('triceps');
+    expect(directFor(catchUp.workout, 'triceps')).toEqual([]);
+    // With it: a second workout, and the one set does not open three more tonight.
+    const second = dayPlan(
+      profile,
+      [...week, session(at(12, 7), [['cable-triceps-pushdown', 1]], { endedEarly: true })],
+      at(12, 18),
+    );
+    expect(second.kind).toBe('second');
+    expect(second.spec.sitOut).toContain('triceps');
+    expect(
+      directFor(second.workout, 'triceps').map((entry) => entry.exerciseId),
+      describeWorkout(second.workout).join('; '),
+    ).toEqual([]);
+  });
+
+  it('is one with direct sets today: a muscle worked only as a secondary one leads if behind', () => {
+    // This morning's lat pulldowns, cut short: the lats and upper back trained, the biceps only as a
+    // secondary muscle.
+    const history = [
+      session(at(3, 18), [
+        ['back-squat', 4],
+        ['romanian-deadlift', 3],
+        ['leg-extension', 3],
+      ]),
+      session(at(4, 18), [
+        ['barbell-bench-press', 4],
+        ['barbell-row', 4],
+      ]),
+      session(at(7, 7), [['lat-pulldown', 3]], { endedEarly: true }),
+    ];
+    const { spec, workout } = dayPlan(profileOf(), history, at(7, 18));
+    expect(spec.kind).toBe('second');
+    expect(spec.sitOut).not.toContain('biceps');
+    expect(workout.explanation.reasons.join(' | ')).not.toMatch(/biceps[^|]*trained today/i);
+  });
+});
+
+describe('a muscle short of its week', () => {
+  it('takes no more sets than it is short, through the lifts other muscles share', () => {
+    // Monday a short lower day, Tuesday push, Thursday pull, Friday missed: on Saturday the glutes
+    // are 3 sets short, the quads and hamstrings more.
+    const history = [
+      ...lastWeek,
+      session(at(7, 18), [
+        ['back-squat', 4],
+        ['leg-curl', 3],
+        ['hip-thrust', 3],
+      ]),
+      pushDay(8),
+      pullDay(10),
+    ];
+    const { spec, week, workout } = dayPlan(profileOf(), history, at(12, 10));
+    expect(shortfallOf(week.muscles.glutes)).toBe(3);
+    expect(spec.muscles.find((item) => item.muscle === 'glutes')?.sets).toBe(3);
+    expect(directSets(workout, 'glutes'), describeWorkout(workout).join('; ')).toBeLessThanOrEqual(
+      shortfallOf(week.muscles.glutes),
+    );
+  });
+});
+
+describe('a catch-up', () => {
+  it('gives the hamstrings a lift on the Saturday after a missed lower day', () => {
+    // Thursday's lower day and Friday missed: the hamstrings 10 sets short, nothing planned. The
+    // squat gives the glutes their sets and every hinge works them, so the hamstrings take the leg
+    // curl (the second review of round M; before, they had no lift).
+    const lower = session(at(3, 18), [
+      ['back-squat', 4],
+      ['romanian-deadlift', 3],
+      ['leg-curl', 3],
+      ['leg-extension', 3],
+      ['standing-calf-raise', 3],
+    ]);
+    const profile = profileOf();
+    const { spec, workout } = dayPlan(
+      profile,
+      [pushDay(1), pullDay(2), lower, pushDay(4), pushDay(7), pullDay(8)],
+      at(12, 10),
+    );
+    expect(spec.muscles.slice(0, 3).map((item) => item.muscle)).toContain('hamstrings');
+    expect(
+      directSets(workout, 'hamstrings'),
+      `${workout.explanation.reasons[0]} | ${describeWorkout(workout).join('; ')}`,
+    ).toBeGreaterThan(0);
+  });
+
+  it('takes no set to failure, a drop set included', () => {
+    const { kind, workout } = saturday();
+    expect(kind).toBe('catch-up');
+    expect(workout.explanation.reasons[0]).toMatch(/a few sets each and none to failure\.$/);
+    const toFailure = allEntries(workout.blocks).flatMap((entry) =>
+      entry.sets
+        .filter((set) => set.kind !== 'warmup' && set.targetRir < 1)
+        .map((set) => `${entry.exerciseId} ${set.kind} @RIR ${set.targetRir}`),
+    );
+    expect(toFailure).toEqual([]);
+    expect(allEntries(workout.blocks).some((entry) => entry.dropSet)).toBe(false);
+  });
+
+  it('is shorter than the full session the same day', () => {
+    const { workout } = saturday();
+    const full = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: [...lastWeek, pushDay(7), pullDay(8)],
+      now: at(12, 10),
+      duration: 'default',
+    });
+    expect(workout.templateId).toBe('catch-up');
+    expect(
+      workout.duration.estimatedMinutes,
+      `catch-up ${workout.explanation.summary} / full ${full.explanation.summary}`,
+    ).toBeLessThan(full.duration.estimatedMinutes);
+  });
+
+  it('leaves the split’s rotation as it was: Thursday plans as if Wednesday held no template', () => {
+    /** A plan done as planned. */
+    const done = (workout: GeneratedWorkout, when: string): WorkoutRecord => ({
+      ...session(
+        when,
+        allEntries(workout.blocks).map(
+          (entry) => [entry.exerciseId, working(entry).length] as [string, number],
+        ),
+      ),
+      templateId: workout.templateId,
+    });
+    const plan = (history: WorkoutRecord[], now: string) => {
+      const profile = profileOf();
+      return catchUpKind(profile, history, now)
+        ? dayPlan(profile, history, now).workout
+        : generateWorkout({ profile, location: gym, history, now, duration: 'default' });
+    };
+    let history: WorkoutRecord[] = [];
+    const days = [
+      new Date(2026, 7, 17, 18),
+      new Date(2026, 7, 18, 18),
+      new Date(2026, 7, 20, 18),
+      new Date(2026, 7, 21, 18),
+      new Date(2026, 7, 24, 18),
+      new Date(2026, 7, 25, 18),
+      new Date(2026, 7, 27, 18),
+      new Date(2026, 7, 28, 18),
+      // Monday the 31st, Tuesday the 1st, and Wednesday the 2nd, not ticked: a catch-up.
+      new Date(2026, 7, 31, 18),
+      new Date(2026, 8, 1, 18),
+      new Date(2026, 8, 2, 18),
+    ].map((date) => date.toISOString());
+    const templates: string[] = [];
+    for (const when of days) {
+      const workout = plan(history, when);
+      history = [...history, done(workout, when)];
+      templates.push(workout.templateId);
+    }
+    expect(templates.at(-1)).toBe('catch-up');
+    const thursday = plan(history, at(3, 18));
+    const untitled = plan(
+      history.map((record) =>
+        record.templateId === 'catch-up' ? { ...record, templateId: null } : record,
+      ),
+      at(3, 18),
+    );
+    expect(thursday.templateId, `the week: ${templates.join(', ')}`).toBe(untitled.templateId);
+  });
+});
diff --git a/src/engine/planning/weekModel.test.ts b/src/engine/planning/weekModel.test.ts
new file mode 100644
index 0000000..d2afb77
--- /dev/null
+++ b/src/engine/planning/weekModel.test.ts
@@ -0,0 +1,134 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../../core/validation/location';
+import { createDefaultProfile, type UserProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { record } from '../../test/records';
+import { projectedSets, shortfallOf, weekModel } from './weekModel';
+
+/**
+ * Maintenance 31: the week model reads the device's Monday-to-Sunday week. Every time here is a
+ * clock time on the device, so the file runs as written in any zone (scripts/test-zones.mjs runs it
+ * in New York and fourteen hours east of UTC too).
+ */
+
+/** A clock time on this device, as an instant. September 2026: the 7th is a Monday. */
+const at = (day: number, hour = 12) => new Date(2026, 8, day, hour).toISOString();
+const [, gym] = createDefaultLocations({ gymAccess: true }, at(1));
+const profile = (overrides: Partial<UserProfile> = {}): UserProfile => ({
+  ...createDefaultProfile(at(1), 'gym'),
+  bodyweight: 185,
+  ...overrides,
+});
+/** One exercise done on a day of the month, its working sets all completed. */
+const done = (day: number, exerciseId: string, sets: number, hour = 12): WorkoutRecord => {
+  const when = at(day, hour);
+  return record(
+    0,
+    exerciseId,
+    Array.from({ length: sets }, () => [10, 100, 2] as [number, number, number]),
+    [8, 12],
+    2,
+    { id: `w-${exerciseId}-${day}-${hour}`, startedAt: when, completedAt: when },
+  );
+};
+const model = (history: WorkoutRecord[], now: string, overrides: Partial<UserProfile> = {}) =>
+  weekModel({ profile: profile(overrides), location: gym!, history, now });
+
+describe('the week model', () => {
+  it('counts this week’s sets on the device, a primary muscle in full and a secondary at half', () => {
+    // Wednesday the 9th: the bench press on Monday counts, last Sunday's late session does not.
+    const week = model(
+      [done(6, 'barbell-bench-press', 4, 23), done(7, 'barbell-bench-press', 3)],
+      at(9),
+      { schedule: { ...profile().schedule, availableDays: ['sat'], weeklyFrequency: 1 } },
+    );
+    expect(week.week).toBe('2026-09-07');
+    expect(week.muscles.chest.done).toBe(3);
+    // The bench press: chest and triceps its primary muscles, the front delts its secondary.
+    expect(week.muscles.triceps.done).toBe(3);
+    expect(week.muscles['front-delts'].done).toBe(1.5);
+    expect(week.muscles.chest.today).toBe(0);
+  });
+
+  it('counts no warm-up and no set left undone', () => {
+    const monday = done(7, 'barbell-bench-press', 3);
+    const entry = monday.entries[0]!;
+    const workout: WorkoutRecord = {
+      ...monday,
+      entries: [
+        {
+          ...entry,
+          sets: [
+            { ...entry.sets[0]!, kind: 'warmup' as const },
+            { ...entry.sets[0]!, kind: 'warmup' as const },
+            ...entry.sets,
+            { ...entry.sets[0]!, completed: false },
+          ],
+        },
+      ],
+    };
+    const week = model([workout], at(9), {
+      schedule: { ...profile().schedule, availableDays: ['sat'], weeklyFrequency: 1 },
+    });
+    expect(week.muscles.chest.done).toBe(3);
+  });
+
+  it('keeps today’s sets apart, and says a workout was begun today', () => {
+    const week = model(
+      [done(7, 'barbell-bench-press', 3), done(9, 'barbell-bench-press', 2, 8)],
+      at(9, 18),
+    );
+    expect(week.muscles.chest.done).toBe(5);
+    expect(week.muscles.chest.today).toBe(2);
+    expect(week.trainedToday).toBe(true);
+  });
+
+  it('adds the sets the week’s ticked days to come will plan, at Default length', () => {
+    // Monday, Tuesday, Thursday and Friday ticked: on Wednesday the 9th, Thursday and Friday remain.
+    const week = model([done(7, 'barbell-bench-press', 3), done(8, 'back-squat', 3)], at(9));
+    expect(week.sessionsAhead).toBe(2);
+    const planned = Object.values(week.muscles).reduce((sum, muscle) => sum + muscle.planned, 0);
+    expect(planned).toBeGreaterThan(20);
+    expect(projectedSets(week.muscles.chest)).toBe(
+      week.muscles.chest.done + week.muscles.chest.planned,
+    );
+  });
+
+  it('plans nothing past Sunday', () => {
+    const week = model([done(7, 'barbell-bench-press', 3)], at(13));
+    expect(week.sessionsAhead).toBe(0);
+    expect(Object.values(week.muscles).every((muscle) => muscle.planned === 0)).toBe(true);
+    // Short of its target by the sets not done.
+    expect(shortfallOf(week.muscles.chest)).toBe(week.muscles.chest.target - 3);
+  });
+
+  it('counts today when it is ticked and nothing was begun, and not once it was', () => {
+    expect(model([], at(10)).sessionsAhead).toBe(2);
+    expect(model([done(10, 'barbell-bench-press', 3, 8)], at(10, 18)).sessionsAhead).toBe(1);
+  });
+
+  it('with more days ticked than sessions a week, plans only the sessions the week has left', () => {
+    const schedule = {
+      ...profile().schedule,
+      weeklyFrequency: 3,
+      availableDays: [
+        'mon',
+        'tue',
+        'wed',
+        'thu',
+        'fri',
+      ] as UserProfile['schedule']['availableDays'],
+    };
+    // Trained Monday and Tuesday: one session left of three, though three ticked days remain.
+    const week = model([done(7, 'barbell-bench-press', 3), done(8, 'back-squat', 3)], at(9, 6), {
+      schedule,
+    });
+    expect(week.sessionsAhead).toBe(1);
+  });
+
+  it('reads how long ago each muscle was trained', () => {
+    const week = model([done(8, 'back-squat', 3)], at(9));
+    expect(week.muscles.quads.daysSince).toBe(1);
+    expect(week.muscles.chest.daysSince).toBeNull();
+  });
+});
diff --git a/src/engine/planning/weekModel.ts b/src/engine/planning/weekModel.ts
new file mode 100644
index 0000000..ff9e518
--- /dev/null
+++ b/src/engine/planning/weekModel.ts
@@ -0,0 +1,197 @@
+import { getExercise } from '../../catalog/exercises/catalog';
+import { MUSCLE_IDS, type MuscleId } from '../../catalog/muscles/muscles';
+import { addLocalDays, localDayKey, localWeekKey, localWeekday } from '../../core/time/localDate';
+import type { LocationProfile } from '../../core/validation/location';
+import type { UserProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import type { LearnedResets } from '../learned/resets';
+import { INDIRECT_SET_WEIGHT, computeExposure, weeklyTargets } from '../volume/weeklyVolume';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+
+/**
+ * The week model (Maintenance 31, docs/proposals/week-model-readiness-time.md part 1): one picture
+ * of the lifter's Monday-to-Sunday week on this device, per muscle, that the catch-up and the second
+ * workout of a day read (items 12 and 32), and the later rounds build on. Weekly sets per muscle are
+ * what drive results; spreading them over the week hardly matters for size (Schoenfeld, Grgic and
+ * Krieger 2019, PMID 30558493; Pelland et al. 2026, PMID 41343037). A set counts once for each of
+ * its exercise's primary muscles and half for each secondary one (Pelland et al. 2026), as the
+ * weekly volume does.
+ */
+
+export interface MuscleWeek {
+  /** Sets done this week so far, today's included. */
+  done: number;
+  /** Of those, today's, a secondary muscle's at half. */
+  today: number;
+  /** Today's direct sets: a muscle with none was not trained today (the review of round M). */
+  todayDirect: number;
+  /** Sets the week's sessions still to come deliver, at Default length. */
+  planned: number;
+  /** The goal's weekly sets for the muscle. */
+  target: number;
+  /** Days since the muscle was last trained directly, as elapsed time; null when never. */
+  daysSince: number | null;
+  /** The same, leaving today's workouts out: the 48 hours before today (the review of round M). */
+  daysBefore: number | null;
+}
+
+export interface WeekModel {
+  /** The Monday that starts this week on the device, `YYYY-MM-DD`. */
+  week: string;
+  /** The sessions still to come this week that `planned` reads. */
+  sessionsAhead: number;
+  /** Whether a workout was begun today. */
+  trainedToday: boolean;
+  muscles: Record<MuscleId, MuscleWeek>;
+}
+
+/** The sets the week will hold for a muscle: done, and planned on the days to come. */
+export const projectedSets = (muscle: MuscleWeek): number => muscle.done + muscle.planned;
+
+/** How far the week falls short of the muscle's target, with the days to come; never below 0. */
+export const shortfallOf = (muscle: MuscleWeek): number =>
+  Math.max(0, muscle.target - projectedSets(muscle));
+
+function emptyWeek(targets: Record<MuscleId, number>): Record<MuscleId, MuscleWeek> {
+  return Object.fromEntries(
+    MUSCLE_IDS.map((muscle) => [
+      muscle,
+      {
+        done: 0,
+        today: 0,
+        todayDirect: 0,
+        planned: 0,
+        target: targets[muscle],
+        daysSince: null,
+        daysBefore: null,
+      },
+    ]),
+  ) as Record<MuscleId, MuscleWeek>;
+}
+
+/** Adds an exercise's sets to its muscles: a primary muscle's in full, a secondary one's at half. */
+function credit(
+  muscles: Record<MuscleId, MuscleWeek>,
+  exerciseId: string,
+  sets: number,
+  field: 'done' | 'today' | 'planned',
+): void {
+  const exercise = getExercise(exerciseId);
+  if (!exercise || sets <= 0) return;
+  for (const muscle of exercise.primaryMuscles) {
+    muscles[muscle][field] += sets;
+    if (field === 'today') muscles[muscle].todayDirect += sets;
+  }
+  for (const muscle of exercise.secondaryMuscles) {
+    muscles[muscle][field] += sets * INDIRECT_SET_WEIGHT;
+  }
+}
+
+/** A planned session as the record it would leave: its working sets, done at the bottom of range. */
+function plannedRecord(date: string, workout: GeneratedWorkout): WorkoutRecord {
+  return {
+    id: `planned-${date}`,
+    startedAt: date,
+    completedAt: date,
+    locationId: workout.locationId,
+    templateId: workout.templateId,
+    endedEarly: false,
+    rating: null,
+    skippedExerciseIds: [],
+    painJoints: [],
+    readiness: null,
+    prs: [],
+    entries: allEntries(workout.blocks).map((entry) => ({
+      exerciseId: entry.exerciseId,
+      sets: entry.sets
+        .filter((set) => set.kind === 'working')
+        .map((set) => ({
+          kind: 'working' as const,
+          reps: set.targetReps[0],
+          weight: null,
+          rir: null,
+          completed: true,
+        })),
+    })),
+  };
+}
+
+/**
+ * The days still to come this week that hold a session: the ticked days after today, and today
+ * when it is ticked and nothing was begun yet. With more days ticked than sessions a week, only as
+ * many as the week has left (the sessions a week less the days trained so far).
+ */
+function daysAhead(profile: UserProfile, now: string, trainedDays: number, trainedToday: boolean) {
+  const available = new Set(profile.schedule.availableDays);
+  const week = localWeekKey(now);
+  const days: string[] = [];
+  for (let offset = 0; offset < 7; offset += 1) {
+    const date = addLocalDays(now, offset);
+    if (localWeekKey(date) !== week) break;
+    if (offset === 0 && trainedToday) continue;
+    if (available.has(localWeekday(date))) days.push(date);
+  }
+  const capped = available.size > profile.schedule.weeklyFrequency;
+  const left = Math.max(0, profile.schedule.weeklyFrequency - trainedDays);
+  return capped ? days.slice(0, left) : days;
+}
+
+export function weekModel(input: {
+  profile: UserProfile;
+  location: LocationProfile | undefined;
+  history: readonly WorkoutRecord[];
+  now: string;
+  /** What the lifter reset (Maintenance 27, item 47): the week reads as today's plan does. */
+  resets?: LearnedResets | null;
+}): WeekModel {
+  const { profile, location, history, now } = input;
+  const week = localWeekKey(now);
+  const today = localDayKey(now);
+  const muscles = emptyWeek(weeklyTargets(profile));
+  const trained = new Set<string>();
+  for (const record of history) {
+    if (record.startedAt > now || localWeekKey(record.startedAt) !== week) continue;
+    const day = localDayKey(record.startedAt);
+    for (const entry of record.entries) {
+      const sets = entry.sets.filter((set) => set.completed && set.kind !== 'warmup').length;
+      if (sets === 0) continue;
+      trained.add(day);
+      credit(muscles, entry.exerciseId, sets, 'done');
+      if (day === today) credit(muscles, entry.exerciseId, sets, 'today');
+    }
+  }
+  const exposure = computeExposure(history, now);
+  const earlier = computeExposure(
+    history.filter((record) => localDayKey(record.startedAt) !== today),
+    now,
+  );
+  for (const muscle of MUSCLE_IDS) {
+    muscles[muscle].daysSince = exposure.daysSinceMuscle[muscle] ?? null;
+    muscles[muscle].daysBefore = earlier.daysSinceMuscle[muscle] ?? null;
+  }
+  const trainedToday = trained.has(today);
+  const ahead = daysAhead(profile, now, trained.size, trainedToday);
+  // Each session to come, as the plan would build it after the ones before it.
+  let simulated: WorkoutRecord[] = [...history];
+  for (const date of ahead) {
+    const workout = generateWorkout({
+      profile,
+      location,
+      history: simulated,
+      now: date,
+      duration: 'default',
+      resets: input.resets ?? null,
+    });
+    for (const entry of allEntries(workout.blocks)) {
+      credit(
+        muscles,
+        entry.exerciseId,
+        entry.sets.filter((set) => set.kind === 'working').length,
+        'planned',
+      );
+    }
+    simulated = [...simulated, plannedRecord(date, workout)];
+  }
+  return { week, sessionsAhead: ahead.length, trainedToday, muscles };
+}
diff --git a/src/engine/recalibration/catchUpBackToEmptied.test.ts b/src/engine/recalibration/catchUpBackToEmptied.test.ts
new file mode 100644
index 0000000..7fa16d0
--- /dev/null
+++ b/src/engine/recalibration/catchUpBackToEmptied.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { WorkoutSession } from '../../core/state/session';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type { RecalibrationResult, RecalibrationTrigger, SessionConstraints } from './types';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { dayNoteOf } from '../../features/today/dayNote';
+import { at, describeWorkout, profileOf, session } from '../../test/clockDays';
+
+/**
+ * Fifteenth review of round M. A catch-up or a second workout the lifter emptied has nothing more
+ * for today, the full session a tap away; the fourteenth pass made one planned afresh with every
+ * lift set aside stay the catch-up (`emptiedByLifter`). But `validateWorkout` reads the request's
+ * constraints, the full session's (`fullSession` still true), so the way back from the full session
+ * is refused as an empty workout. At a bare home the calves' only lift is the standing calf raise:
+ * the lifter skips it ("Not one of your training days: nothing more for today."), taps Full session
+ * to look, then Catch-up instead: "The rebuilt workout came back empty, so nothing was changed." The
+ * full session stays, and Today goes on offering "Catch-up instead", which can never go through.
+ * Likewise "Go easy instead" on a second workout. Synthetic data only.
+ */
+
+const [bare] = createDefaultLocations({ gymAccess: false, homeEquipment: [] }, at(1)) as [
+  LocationProfile,
+];
+const NOW = at(9, 18);
+const calves = (kind: CatchUpSpec['kind']): CatchUpSpec => ({
+  kind,
+  muscles: [{ muscle: 'calves', sets: 3, minRir: 1, why: 'behind' }],
+  sitOut: kind === 'second' ? ['chest', 'triceps'] : [],
+});
+
+function emptiedThenBack(spec: CatchUpSpec, records: WorkoutRecord[]) {
+  let workout: GeneratedWorkout = generateWorkout({
+    profile: profileOf(),
+    location: bare,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+  let constraints: SessionConstraints = { ...emptyConstraints(), catchUp: spec };
+  const steps: string[] = [describeWorkout(workout).join('; ')];
+  const run = (trigger: RecalibrationTrigger): RecalibrationResult => {
+    const result = recalibrate({
+      trigger,
+      workout,
+      completed: emptyCompleted(),
+      lockedEntryIds: [],
+      currentEntryId: null,
+      duration: 'default',
+      profile: profileOf(),
+      location: bare,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints,
+      reason: 'test',
+      timestamp: NOW,
+    });
+    steps.push(
+      result.ok
+        ? `${trigger.type}: ${result.summary.headline} ${describeWorkout(result.workout).join('; ')}`
+        : `${trigger.type} refused: ${result.error}`,
+    );
+    if (result.ok) {
+      workout = result.workout;
+      constraints = result.constraints;
+    }
+    return result;
+  };
+  expect(describeWorkout(workout)).toEqual(['standing-calf-raise x3 @RIR 1/1/1']);
+  const [raise] = allEntries(workout.blocks);
+  expect(run({ type: 'skip', entryId: raise!.id }).ok, steps.join(' | ')).toBe(true);
+  expect(allEntries(workout.blocks), steps.join(' | ')).toEqual([]);
+  expect(run({ type: 'session-kind', full: true, kind: spec.kind }).ok, steps.join(' | ')).toBe(
+    true,
+  );
+  const back = run({ type: 'session-kind', full: false, kind: spec.kind });
+  return { back, steps, workout, constraints };
+}
+
+describe('back from the full session to a catch-up or second workout the lifter emptied', () => {
+  it('a catch-up for the calves at a bare home: the standing calf raise skipped, Full session, Catch-up instead', () => {
+    const { back, steps, workout, constraints } = emptiedThenBack(calves('catch-up'), [
+      session(at(3, 18), [['barbell-row', 3]]),
+    ]);
+    // On 3290cd8: "The rebuilt workout came back empty, so nothing was changed."
+    expect(back.ok ? 'taken' : back.error, steps.join(' | ')).toBe('taken');
+    expect(allEntries(workout.blocks), steps.join(' | ')).toEqual([]);
+    const note = dayNoteOf(
+      { status: 'preview', constraints, workout } as unknown as WorkoutSession,
+      false,
+    );
+    expect(note?.text).toBe('Not one of your training days: nothing more for today.');
+    expect(note?.action?.full).toBe(true);
+  });
+
+  it('a second workout, the calves missed, at a bare home: the calf raise skipped, Full session, Go easy instead', () => {
+    const { back, steps } = emptiedThenBack(calves('second'), [
+      session(at(3, 18), [['barbell-row', 3]]),
+      session(at(9, 9), [['diamond-push-up', 3]]),
+    ]);
+    // On 3290cd8: "The rebuilt workout came back empty, so nothing was changed."
+    expect(back.ok ? 'taken' : back.error, steps.join(' | ')).toBe('taken');
+  });
+});
diff --git a/src/engine/recalibration/catchUpCheckInJoint.test.ts b/src/engine/recalibration/catchUpCheckInJoint.test.ts
new file mode 100644
index 0000000..d6dc9cb
--- /dev/null
+++ b/src/engine/recalibration/catchUpCheckInJoint.test.ts
@@ -0,0 +1,159 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { WorkoutSession } from '../../core/state/session';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  RecalibrationRequest,
+  RecalibrationResult,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, CATCH_UP_TEMPLATE_IDS, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { dayNoteOf } from '../../features/today/dayNote';
+import { at, describeWorkout, profileOf, session } from '../../test/clockDays';
+
+/**
+ * Sixteenth review of round M. A catch-up left with no lift by the lifter's changes (lifts set
+ * aside, joints reported) has nothing more for today through any rebuild around it. The fifteenth
+ * pass made `emptiedByLifter` build the plan again with today's reported joints set aside too, but
+ * it still returns false at once when no lift was set aside (`excludeExerciseIds` empty). A joint
+ * reported in the check-in sets no lift aside: it only records the joint (`painJoints`).
+ *
+ * At home with dumbbells, a catch-up for the hamstrings has the dumbbell Romanian deadlift. The
+ * lifter checks in with lower-back discomfort: the deadlift is ruled out, "Not one of your training
+ * days: nothing more for today." They then set a coach focus, and the store builds the preview
+ * again (`rebuildPreview`: a fresh plan, then today's choices, the check-in among them, by a length
+ * change). The catch-up comes back empty, `emptiedByLifter` says the lifter did not empty it, and
+ * the day is planned as with nothing behind: the split's push day, a drop set to failure among it,
+ * and Today says nothing behind can be caught up today, with no full session to take. So too the
+ * way back from the full session, "Catch-up instead" ("The catch-up: no changes needed.", the push
+ * day). The same steps with "Hurts" on the lower back in place of the check-in stay the empty
+ * catch-up (the fifteenth pass's own tests). Synthetic data only.
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [{ muscle: 'hamstrings', sets: 3, minRir: 1, why: 'behind' }],
+  sitOut: [],
+};
+const fresh = (focusMuscle: 'chest' | null = null) =>
+  generateWorkout({
+    profile: profileOf(),
+    location: home,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec, focusMuscle },
+  });
+const request = (
+  trigger: RecalibrationTrigger,
+  workout: GeneratedWorkout,
+  constraints: SessionConstraints,
+): RecalibrationRequest => ({
+  trigger,
+  workout,
+  completed: emptyCompleted(),
+  lockedEntryIds: [],
+  currentEntryId: null,
+  duration: 'default',
+  profile: profileOf(),
+  location: home,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints,
+  reason: 'test',
+  timestamp: NOW,
+});
+const succeeded = (result: RecalibrationResult) => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+const noteOf = (workout: GeneratedWorkout, constraints: SessionConstraints) =>
+  dayNoteOf({ status: 'preview', constraints, workout } as unknown as WorkoutSession, false);
+
+/** The catch-up, its only lift ruled out by a check-in with lower-back discomfort. */
+function checkedIn() {
+  const plan = fresh();
+  expect(describeWorkout(plan)).toEqual(['dumbbell-romanian-deadlift x3 @RIR 1/1/1']);
+  const result = succeeded(
+    recalibrate(
+      request(
+        {
+          type: 'readiness',
+          readiness: {
+            energy: 4,
+            soreness: 2,
+            sleep: 4,
+            motivation: 4,
+            jointDiscomfort: ['lower-back'],
+            timePressure: false,
+          },
+        },
+        plan,
+        { ...emptyConstraints(), catchUp: spec },
+      ),
+    ),
+  );
+  expect(allEntries(result.workout.blocks)).toEqual([]);
+  expect(result.constraints.avoidExerciseIds).toEqual([]);
+  expect(noteOf(result.workout, result.constraints)?.text).toBe(
+    'Not one of your training days: nothing more for today.',
+  );
+  return result;
+}
+
+describe('a catch-up emptied by a joint reported in the check-in stays so when built whole again', () => {
+  it('the preview built again for a coach focus, today’s check-in kept', () => {
+    const emptied = checkedIn();
+    // As the store's `rebuildPreview`: a fresh plan, then a length change with today's choices.
+    const today: SessionConstraints = { ...emptied.constraints, focus: 'chest' };
+    const again = succeeded(
+      recalibrate(request({ type: 'duration', choice: 'default' }, fresh('chest'), today)),
+    );
+    const note = noteOf(again.workout, again.constraints);
+    const detail = `${again.summary.headline} | ${again.workout.templateId}: ${describeWorkout(again.workout).join('; ')} | ${JSON.stringify(note)}`;
+    // On 89dfb39: the push day, "dumbbell-curl x2 @RIR 1/1 + drop @RIR 0" among it.
+    expect(again.workout.templateId, detail).toBe(CATCH_UP_TEMPLATE_IDS['catch-up']);
+    expect(allEntries(again.workout.blocks), detail).toEqual([]);
+    expect(note?.text, detail).toBe('Not one of your training days: nothing more for today.');
+    expect(note?.action?.full, detail).toBe(true);
+  });
+
+  it('the full session taken, then "Catch-up instead": the way back is the catch-up again', () => {
+    const emptied = checkedIn();
+    const full = succeeded(
+      recalibrate(
+        request(
+          { type: 'session-kind', full: true, kind: 'catch-up' },
+          emptied.workout,
+          emptied.constraints,
+        ),
+      ),
+    );
+    expect(full.constraints.fullSession).toBe(true);
+    const back = succeeded(
+      recalibrate(
+        request(
+          { type: 'session-kind', full: false, kind: 'catch-up' },
+          full.workout,
+          full.constraints,
+        ),
+      ),
+    );
+    const note = noteOf(back.workout, back.constraints);
+    const detail = `${back.summary.headline} | ${back.workout.templateId}: ${describeWorkout(back.workout).join('; ')} | ${JSON.stringify(note)}`;
+    // On 89dfb39: "The catch-up: no changes needed." The push day stays, a drop set to failure
+    // among it, and Today says nothing behind can be caught up, with no full session to take.
+    expect(back.workout.templateId, detail).toBe(CATCH_UP_TEMPLATE_IDS['catch-up']);
+    expect(allEntries(back.workout.blocks), detail).toEqual([]);
+    expect(note?.text, detail).toBe('Not one of your training days: nothing more for today.');
+  });
+});
diff --git a/src/engine/recalibration/catchUpComesInFor.test.ts b/src/engine/recalibration/catchUpComesInFor.test.ts
