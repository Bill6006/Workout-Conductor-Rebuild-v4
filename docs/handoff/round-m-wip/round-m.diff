+const NOW = at(9, 18);
+const lower: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['quads', 'glutes', 'hamstrings'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
