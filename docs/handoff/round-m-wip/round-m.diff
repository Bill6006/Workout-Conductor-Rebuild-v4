@@ -0,0 +1,124 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { WorkoutSession } from '../../core/state/session';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  RecalibrationRequest,
+  RecalibrationResult,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, CATCH_UP_TEMPLATE_IDS, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { dayNoteOf } from '../../features/today/dayNote';
+import { at, describeWorkout, profileOf, session } from '../../test/clockDays';
+
+/**
+ * Fifteenth review of round M. A catch-up the lifter's changes emptied stays so, and one built
+ * afresh "with every lift set aside" stays the catch-up (`emptiedByLifter`, the fourteenth pass).
+ * But "Hurts" sets the lift aside and records the sore joint, and `emptiedByLifter` builds the plan
+ * again without the lifts set aside only: the joint still rules the lift out, the plan comes back
+ * empty, and the day is planned as with nothing behind, the split's own session. At home with
+ * dumbbells, a catch-up for the hamstrings has the dumbbell Romanian deadlift; "Hurts" on the lower
+ * back leaves it out ("Not one of your training days: nothing more for today."). The lifter then
+ * sets a coach focus, and the store builds the preview again (`rebuildPreview`: a fresh plan, then
+ * today's choices by a length change): the plan is the push day, a drop set to failure among it, and
+ * Today says nothing behind can be caught up today, with no full session to take. (Full session then
+ * Catch-up instead gives the same push day today, "The catch-up: no changes needed."; it also meets
+ * `validateWorkout` reading the full session's constraints, a finding of its own, so it is not
+ * asserted here.) The rules: a catch-up left with no lift has nothing more for today, through any
+ * rebuild, and Today says so with the full session a tap away. Synthetic data only.
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [{ muscle: 'hamstrings', sets: 3, minRir: 1, why: 'behind' }],
+  sitOut: [],
+};
+const fresh = (focusMuscle: 'chest' | null = null) =>
+  generateWorkout({
+    profile: profileOf(),
+    location: home,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec, focusMuscle },
+  });
+const request = (
+  trigger: RecalibrationTrigger,
+  workout: GeneratedWorkout,
+  constraints: SessionConstraints,
+): RecalibrationRequest => ({
+  trigger,
+  workout,
+  completed: emptyCompleted(),
+  lockedEntryIds: [],
+  currentEntryId: null,
+  duration: 'default',
+  profile: profileOf(),
+  location: home,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints,
+  reason: 'test',
+  timestamp: NOW,
+});
+const succeeded = (result: RecalibrationResult) => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+const noteOf = (workout: GeneratedWorkout, constraints: SessionConstraints) =>
+  dayNoteOf({ status: 'preview', constraints, workout } as unknown as WorkoutSession, false);
+
+/** The catch-up, its only lift left out by "Hurts" on the lower back. */
+function hurt() {
+  const plan = fresh();
+  expect(describeWorkout(plan)).toEqual(['dumbbell-romanian-deadlift x3 @RIR 1/1/1']);
+  const [rdl] = allEntries(plan.blocks);
+  const result = succeeded(
+    recalibrate(
+      request({ type: 'pain', entryId: rdl!.id, joint: 'lower-back' }, plan, {
+        ...emptyConstraints(),
+        catchUp: spec,
+      }),
+    ),
+  );
+  expect(allEntries(result.workout.blocks)).toEqual([]);
+  expect(noteOf(result.workout, result.constraints)?.text).toBe(
+    'Not one of your training days: nothing more for today.',
+  );
+  return result;
+}
+
+const expectNothingMore = (
+  workout: GeneratedWorkout,
+  constraints: SessionConstraints,
+  steps: string,
+) => {
+  const note = noteOf(workout, constraints);
+  const detail = `${steps} | ${workout.templateId}: ${describeWorkout(workout).join('; ')} | ${JSON.stringify(note)}`;
+  expect(workout.templateId, detail).toBe(CATCH_UP_TEMPLATE_IDS['catch-up']);
+  expect(allEntries(workout.blocks), detail).toEqual([]);
+  expect(note?.text, detail).toBe('Not one of your training days: nothing more for today.');
+  expect(note?.action?.full, detail).toBe(true);
+};
+
+describe('a catch-up emptied by "Hurts" stays so when it is built whole again', () => {
+  it('the preview built again for a coach focus, today’s choices kept', () => {
+    const emptied = hurt();
+    // As the store's `rebuildPreview`: a fresh plan, then a length change with today's choices.
+    const today: SessionConstraints = { ...emptied.constraints, focus: 'chest' };
+    const again = succeeded(
+      recalibrate(request({ type: 'duration', choice: 'default' }, fresh('chest'), today)),
+    );
+    // On 3290cd8: the push day, a drop set to failure among it.
+    expectNothingMore(again.workout, again.constraints, again.summary.headline);
+  });
+});
diff --git a/src/engine/recalibration/catchUpHurtsOneSet.test.ts b/src/engine/recalibration/catchUpHurtsOneSet.test.ts
new file mode 100644
index 0000000..8c038ee
--- /dev/null
+++ b/src/engine/recalibration/catchUpHurtsOneSet.test.ts
@@ -0,0 +1,94 @@
+import { describe, expect, it } from 'vitest';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type { CompletedWork } from './types';
+import { allEntries, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Fifteenth review of round M. The fourteenth pass made the swap sheet and "Uncomfortable" say that
+ * a lift begun with one set left has nothing come in for it because one set is too few, not that
+ * nothing fits; "Hurts" still says nothing fits. In the lower-body catch-up at the gym, two of the
+ * back squat's three sets done, "Hurts" on the lower back: the squat stops at its sets done, and the
+ * workout says "Back Squat stops at the sets done: nothing safe fits right now." The leg press is
+ * safe for the lower back (with one squat set done, "Hurts" on the lower back brings it in); what
+ * stops the squat is its one set left. The rules: a lift begun with one set owed has nothing come in
+ * for it, and says so. Synthetic data only.
+ */
+
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lower: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['quads', 'glutes', 'hamstrings'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+const setsDone = (entry: WorkoutEntry, count: number): CompletedWork => ({
+  ...emptyCompleted(),
+  startedAt: NOW,
+  elapsedSeconds: 300 * count,
+  sets: working(entry)
+    .slice(0, count)
+    .map((set, index) => ({
+      entryId: entry.id,
+      exerciseId: entry.exerciseId,
+      setIndex: set.index,
+      kind: 'working' as const,
+      reps: 8,
+      weight: set.targetWeight,
+      rir: 2,
+      completedAt: at(9, 18, index * 4),
+    })),
+});
+const plan = () =>
+  generateWorkout({
+    profile: profileOf(),
+    location: gym,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: lower },
+  });
+const hurts = (done: number) => {
+  const workout = plan();
+  const squat = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'back-squat')!;
+  expect(working(squat).length, describeWorkout(workout).join('; ')).toBe(3);
+  const result = recalibrate({
+    trigger: { type: 'pain', entryId: squat.id, joint: 'lower-back' },
+    workout,
+    completed: setsDone(squat, done),
+    lockedEntryIds: [],
+    currentEntryId: squat.id,
+    duration: 'default',
+    profile: profileOf(),
+    location: gym,
+    loading: { missingPlates: [] },
+    history: records,
+    constraints: { ...emptyConstraints(), catchUp: lower },
+    reason: 'test',
+    timestamp: NOW,
+  });
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+
+describe('"Hurts" on a lift begun with one set left says why nothing comes in', () => {
+  it('the back squat, two of three sets done, "Hurts" on the lower back', () => {
+    // With one set done, two left, a safe lift does come in for the lower back: the leg press.
+    const two = hurts(1);
+    expect(describeWorkout(two.workout).join('; ')).toMatch(/leg-press x2/);
+    const result = hurts(2);
+    const words = [result.summary.headline, ...result.summary.details].join(' | ');
+    const detail = `${words} || ${describeWorkout(result.workout).join('; ')}`;
+    expect(describeWorkout(result.workout), detail).toContain('back-squat x2 @RIR 2/2');
+    // On 3290cd8: "Back Squat stops at the sets done: nothing safe fits right now."
+    expect(words, detail).not.toMatch(/nothing safe fits/);
+    expect(words, detail).toMatch(/one set/i);
+  });
+});
diff --git a/src/engine/recalibration/catchUpLeftOutSlot.test.ts b/src/engine/recalibration/catchUpLeftOutSlot.test.ts
new file mode 100644
index 0000000..ebfa7c4
--- /dev/null
+++ b/src/engine/recalibration/catchUpLeftOutSlot.test.ts
@@ -0,0 +1,206 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Seventeenth review of round M. The sixteenth pass settled that on a day off the plan "a lift
+ * stopped with nothing to come in owes nothing more": no later rebuild fills its place with what the
+ * stop did not bring (its own test: the push-up swapped away, two comfort swaps, the lateral raise
+ * stopped, and an end time added "the push-up back, the very lift they swapped away"). The fix marks
+ * the stopped lift (`stopAtLogged`, `why: 'skip'`), so it covers only a lift begun. The same lift
+ * not begun is left out instead ("Left out Lateral Raise: no comfortable alternative fits Home."),
+ * its slot keeps no entry at all, and the next rebuild fills the slot afresh from its own movement:
+ * the push-up the lifter swapped away comes back, "1 exercise added", by an end time, "Make it
+ * easier" or "harder", or a length picked.
+ *
+ * Steps (synthetic data only): at home with dumbbells, a catch-up for the forearms and the chest is
+ * the push-up and the hammer curl. The lifter swaps the push-up for the dumbbell shoulder press;
+ * "Uncomfortable" brings the Arnold press, "Uncomfortable" again the lateral raise; "Uncomfortable"
+ * on the lateral raise, not begun, leaves it out. Then the rebuild named in each case.
+ *
+ * Also fails on 89dfb39 (the case was never covered).
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const profile = profileOf();
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [
+    { muscle: 'forearms', sets: 3, minRir: 1, why: 'behind' },
+    { muscle: 'chest', sets: 3, minRir: 1, why: 'behind' },
+  ],
+  sitOut: [],
+};
+
+function day(started: boolean) {
+  let workout: GeneratedWorkout = generateWorkout({
+    profile,
+    location: home,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+  let constraints: SessionConstraints = { ...emptyConstraints(), catchUp: spec };
+  let completed: CompletedWork = started
+    ? { ...emptyCompleted(), startedAt: NOW, elapsedSeconds: 60 }
+    : emptyCompleted();
+  let clock = 1;
+  const steps: string[] = [lifts(workout)];
+  return {
+    get workout() {
+      return workout;
+    },
+    steps,
+    find: (id: string) => allEntries(workout.blocks).find((entry) => entry.exerciseId === id),
+    log(entry: WorkoutEntry) {
+      const set = working(entry)[0]!;
+      clock += 3;
+      completed = {
+        ...completed,
+        elapsedSeconds: completed.elapsedSeconds + 180,
+        currentEntryId: entry.id,
+        sets: [
+          ...completed.sets,
+          {
+            entryId: entry.id,
+            exerciseId: entry.exerciseId,
+            setIndex: set.index,
+            kind: 'working',
+            reps: 10,
+            weight: set.targetWeight,
+            rir: 2,
+            completedAt: at(9, 18, clock),
+          },
+        ],
+      };
+      steps.push(`log ${entry.exerciseId}`);
+    },
+    run(trigger: RecalibrationTrigger): RecalibrationSuccess {
+      const result = recalibrate({
+        trigger,
+        workout,
+        completed,
+        lockedEntryIds: [],
+        currentEntryId: completed.currentEntryId,
+        duration: trigger.type === 'duration' ? trigger.choice : 'default',
+        profile,
+        location: home,
+        loading: { missingPlates: [] },
+        history: records,
+        constraints,
+        reason: 'test',
+        timestamp: at(9, 18, clock + 1),
+      });
+      if (!result.ok) throw new Error(result.error);
+      workout = result.workout;
+      constraints = result.constraints;
+      steps.push(`${trigger.type}: ${result.summary.headline} => ${lifts(workout)}`);
+      return result;
+    },
+  };
+}
+
+/** The push-up swapped away, two comfort swaps, then the lateral raise left out. */
+function leftOut(started: boolean) {
+  const today = day(started);
+  expect(lifts(today.workout)).toBe('push-up x3 @RIR 2/2/2; hammer-curl x2 @RIR 1/1');
+  if (started) today.log(today.find('hammer-curl')!);
+  today.run({
+    type: 'replace',
+    entryId: today.find('push-up')!.id,
+    exerciseId: 'dumbbell-shoulder-press',
+  });
+  today.run({ type: 'uncomfortable', entryId: today.find('dumbbell-shoulder-press')!.id });
+  today.run({ type: 'uncomfortable', entryId: today.find('arnold-press')!.id });
+  const out = today.run({ type: 'uncomfortable', entryId: today.find('lateral-raise')!.id });
+  expect(out.summary.headline).toBe(
+    'Left out Lateral Raise: no comfortable alternative fits Home.',
+  );
+  expect(lifts(today.workout)).toBe('hammer-curl x2 @RIR 1/1');
+  return today;
+}
+
+describe('a lift left out with nothing to come in: no rebuild fills its place', () => {
+  const rebuilds: [string, RecalibrationTrigger][] = [
+    ['an end time', { type: 'end-by', time: at(9, 19, 30) }],
+    ['"Make it easier"', { type: 'intensity', direction: 'easier' }],
+    ['a length picked', { type: 'duration', choice: 45 }],
+  ];
+  for (const [name, trigger] of rebuilds) {
+    it(`on a plan not begun, then ${name}`, () => {
+      const today = leftOut(false);
+      today.run(trigger);
+      // On 532aba6: "1 exercise added", push-up x3, the lift the lifter swapped away.
+      expect(today.find('push-up'), today.steps.join(' | ')).toBeUndefined();
+      expect(lifts(today.workout), today.steps.join(' | ')).not.toContain('push-up');
+      // Nor any other lift: the change found no comfortable one (the diamond push-up came in).
+      expect(
+        allEntries(today.workout.blocks).map((entry) => entry.exerciseId),
+        today.steps.join(' | '),
+      ).toEqual(['hammer-curl']);
+    });
+  }
+
+  it('under way (a set of the hammer curl done), then an end time', () => {
+    const today = leftOut(true);
+    today.run({ type: 'end-by', time: at(9, 19, 30) });
+    // On 532aba6: "Ends by 7:30 PM: 1 exercise added." push-up x3.
+    expect(today.find('push-up'), today.steps.join(' | ')).toBeUndefined();
+    expect(
+      allEntries(today.workout.blocks).map((entry) => entry.exerciseId),
+      today.steps.join(' | '),
+    ).toEqual(['hammer-curl']);
+  });
+});
+
+describe('a lift the lifter swapped away stays away on the way back from the full session', () => {
+  it('the catch-up laid out again keeps the push-up away', () => {
+    // A closed slot is the plan's: the catch-up laid out again may fill it (a known limit), but
+    // never with the lift the lifter swapped away.
+    const today = leftOut(false);
+    today.run({ type: 'session-kind', full: true, kind: 'catch-up' });
+    today.run({ type: 'session-kind', full: false, kind: 'catch-up' });
+    expect(today.find('push-up'), today.steps.join(' | ')).toBeUndefined();
+  });
+});
+
+/**
+ * The same mechanism through a skip (found by the random runs): the lift that replaced the plan's
+ * pick is skipped, its slot keeps no entry, and the next rebuild brings back the very lift the
+ * lifter swapped away. With no other lift in the plan the emptied catch-up stays so (the fourteenth
+ * and sixteenth passes), so the push-up comes back or not depending only on whether the hammer curl
+ * is still there. Steps: the push-up swapped for the dumbbell shoulder press, that skipped, then an
+ * end time. Also fails on 89dfb39.
+ */
+describe('a lift the lifter swapped away does not come back when its replacement is skipped', () => {
+  it('the push-up swapped for the dumbbell shoulder press, that skipped, then an end time', () => {
+    const today = day(false);
+    today.run({
+      type: 'replace',
+      entryId: today.find('push-up')!.id,
+      exerciseId: 'dumbbell-shoulder-press',
+    });
+    today.run({ type: 'skip', entryId: today.find('dumbbell-shoulder-press')!.id });
+    expect(lifts(today.workout)).toBe('hammer-curl x2 @RIR 1/1');
+    today.run({ type: 'end-by', time: at(9, 19, 30) });
+    // On 532aba6: "Ends by 7:30 PM: 1 exercise added." push-up x3.
+    expect(today.find('push-up'), today.steps.join(' | ')).toBeUndefined();
+  });
+});
