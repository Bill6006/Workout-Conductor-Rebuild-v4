+++ b/src/engine/recalibration/catchUpStopReason.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from 'vitest';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type { CompletedWork } from './types';
+import { allEntries, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Fifteenth review of round M. The fourteenth pass gave "Uncomfortable" a headline of its own for a
+ * lift begun with one set left (`oneSetOwed`), but reads the lift after `stopAtLogged` has closed it
+ * at its sets done: every set it still has is done, so every lift begun reads as "one set left".
+ * In the lower-body catch-up at the gym the back squat gives the glutes their three sets, so nothing
+ * can come in for the leg curl (every hinge works the glutes). A set of the leg curl, two still to
+ * do, then "Uncomfortable": the lift stops at its set done, and the headline says one set left is
+ * too few for another lift to take over. Two sets were left; what stopped it is that no comfortable
+ * alternative fits. The rules: a refused change gives its own reason; a lift begun with nothing to
+ * come in stops at its sets done. Synthetic data only.
+ */
+
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lower: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['quads', 'glutes', 'hamstrings'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+const setsDone = (entry: WorkoutEntry, count: number): CompletedWork => ({
+  ...emptyCompleted(),
+  startedAt: NOW,
+  elapsedSeconds: 300 * count,
+  sets: working(entry)
+    .slice(0, count)
+    .map((set, index) => ({
+      entryId: entry.id,
+      exerciseId: entry.exerciseId,
+      setIndex: set.index,
+      kind: 'working' as const,
+      reps: 8,
+      weight: set.targetWeight,
+      rir: 2,
+      completedAt: at(9, 18, index * 4),
+    })),
+});
+
+describe('"Uncomfortable" on a lift begun says why it stops', () => {
+  it('the leg curl, one of its three sets done: two left, and no comfortable alternative fits', () => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: lower },
+    });
+    const curl = allEntries(plan.blocks).find((entry) => entry.exerciseId === 'leg-curl')!;
+    expect(curl, describeWorkout(plan).join('; ')).toBeDefined();
+    expect(working(curl).length).toBe(3);
+    const completed = setsDone(curl, 1);
+    const result = recalibrate({
+      trigger: { type: 'uncomfortable', entryId: curl.id },
+      workout: plan,
+      completed,
+      lockedEntryIds: [],
+      currentEntryId: curl.id,
+      duration: 'default',
+      profile: profileOf(),
+      location: gym,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints: { ...emptyConstraints(), catchUp: lower },
+      reason: 'test',
+      timestamp: NOW,
+    });
+    if (!result.ok) throw new Error(result.error);
+    const detail = `${result.summary.headline} | ${describeWorkout(result.workout).join('; ')}`;
+    // It stops at its one set done: nothing came in for it.
+    expect(describeWorkout(result.workout), detail).toContain('leg-curl x1 @RIR 1');
+    // On 3290cd8: "Leg Curl stops at the sets done: one set left is too few for another lift to
+    // take over." It had two sets left.
+    expect(result.summary.headline, detail).not.toMatch(/one set left/);
+    expect(result.summary.headline, detail).toMatch(/no comfortable alternative fits/);
+  });
+});
diff --git a/src/engine/recalibration/catchUpStoppedSlot.test.ts b/src/engine/recalibration/catchUpStoppedSlot.test.ts
new file mode 100644
index 0000000..c98f00e
--- /dev/null
+++ b/src/engine/recalibration/catchUpStoppedSlot.test.ts
@@ -0,0 +1,163 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, isStopped, type GeneratedWorkout, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { at, describeWorkout, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Sixteenth review of round M. "A lift begun with nothing to come in stops at its sets done", and
+ * what comes in for a lift "works a muscle the lift went in for". `bestAlternative` keeps to the
+ * muscles the lift went in for (`chosenFor`); but once the lift has stopped, its slot owes the sets
+ * it did not do (`owedBy`: a stop for a swap, comfort or pain owes them, only a skip does not), and
+ * the next rebuild of any kind fills the slot afresh from the slot's own muscles and pattern, which
+ * is not the same search. So a lift "Uncomfortable" stopped with nothing to come in has a lift come
+ * in for it anyway at the next "Make it easier", "harder", end time or length.
+ *
+ * At home with dumbbells, a catch-up for the biceps and the forearms has the hammer curl.
+ * "Uncomfortable" brings the dumbbell curl (for the biceps), and "Uncomfortable" on that the reverse
+ * curl. A set of it, then "Uncomfortable": "Reverse Curl stops at the sets done: no comfortable
+ * alternative fits Home." Then "Make it easier": "1 exercise added", the wrist curl, two sets, in
+ * the slot the reverse curl stopped in. Likewise a lifter who swapped the push-up for the dumbbell
+ * shoulder press (forearms and chest behind), "Uncomfortable" twice (the Arnold press, then the
+ * lateral raise), a set of it and "Uncomfortable" again ("stops at the sets done"): an end time then
+ * adds the push-up back, the very lift they swapped away. Synthetic data only.
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const profile = profileOf();
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const behind = (...muscles: ('biceps' | 'forearms' | 'chest')[]): CatchUpSpec => ({
+  kind: 'catch-up',
+  muscles: muscles.map((muscle) => ({ muscle, sets: 3, minRir: 1, why: 'behind' as const })),
+  sitOut: [],
+});
+
+function day(spec: CatchUpSpec) {
+  let workout: GeneratedWorkout = generateWorkout({
+    profile,
+    location: home,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+  let constraints: SessionConstraints = { ...emptyConstraints(), catchUp: spec };
+  let completed: CompletedWork = { ...emptyCompleted(), startedAt: NOW, elapsedSeconds: 60 };
+  let clock = 1;
+  const steps: string[] = [lifts(workout)];
+  return {
+    get workout() {
+      return workout;
+    },
+    steps,
+    find: (id: string) => allEntries(workout.blocks).find((entry) => entry.exerciseId === id),
+    log(entry: WorkoutEntry) {
+      const set = working(entry).find(
+        (each) =>
+          !completed.sets.some((done) => done.entryId === entry.id && done.setIndex === each.index),
+      )!;
+      clock += 3;
+      completed = {
+        ...completed,
+        elapsedSeconds: completed.elapsedSeconds + 180,
+        currentEntryId: entry.id,
+        sets: [
+          ...completed.sets,
+          {
+            entryId: entry.id,
+            exerciseId: entry.exerciseId,
+            setIndex: set.index,
+            kind: 'working',
+            reps: 10,
+            weight: set.targetWeight,
+            rir: 2,
+            completedAt: at(9, 18, clock),
+          },
+        ],
+      };
+      steps.push(`log ${entry.exerciseId}`);
+    },
+    run(trigger: RecalibrationTrigger): RecalibrationSuccess {
+      const result = recalibrate({
+        trigger,
+        workout,
+        completed,
+        lockedEntryIds: [],
+        currentEntryId: completed.currentEntryId,
+        duration: 'default',
+        profile,
+        location: home,
+        loading: { missingPlates: [] },
+        history: records,
+        constraints,
+        reason: 'test',
+        timestamp: at(9, 18, clock + 1),
+      });
+      if (!result.ok) throw new Error(result.error);
+      workout = result.workout;
+      constraints = result.constraints;
+      steps.push(`${trigger.type}: ${result.summary.headline} => ${lifts(workout)}`);
+      return result;
+    },
+  };
+}
+
+/** Nothing live in the slot the stopped lift is in. */
+const slotLive = (workout: GeneratedWorkout, slot: number | undefined) =>
+  allEntries(workout.blocks)
+    .filter((entry) => entry.slot === slot && !isStopped(entry))
+    .map((entry) => entry.exerciseId);
+
+describe('a lift stopped with nothing to come in has nothing come in at the next rebuild', () => {
+  it('the reverse curl, after the hammer curl and the dumbbell curl, then "Make it easier"', () => {
+    const today = day(behind('biceps', 'forearms'));
+    expect(lifts(today.workout)).toBe('hammer-curl x3 @RIR 1/1/1');
+    today.run({ type: 'uncomfortable', entryId: today.find('hammer-curl')!.id });
+    today.run({ type: 'uncomfortable', entryId: today.find('dumbbell-curl')!.id });
+    const reverse = today.find('reverse-curl')!;
+    today.log(reverse);
+    const stop = today.run({ type: 'uncomfortable', entryId: reverse.id });
+    expect(stop.summary.headline).toBe(
+      'Reverse Curl stops at the sets done: no comfortable alternative fits Home.',
+    );
+    expect(slotLive(today.workout, reverse.slot)).toEqual([]);
+    today.run({ type: 'intensity', direction: 'easier' });
+    // On 89dfb39: "Rest of the workout made easier: 1 exercise added." wrist-curl x2.
+    expect(slotLive(today.workout, reverse.slot), today.steps.join(' | ')).toEqual([]);
+  });
+
+  it('the push-up swapped away, the lateral raise stopped after two comfort swaps, then an end time', () => {
+    const today = day(behind('forearms', 'chest'));
+    expect(lifts(today.workout)).toBe('push-up x3 @RIR 2/2/2; hammer-curl x2 @RIR 1/1');
+    today.run({
+      type: 'replace',
+      entryId: today.find('push-up')!.id,
+      exerciseId: 'dumbbell-shoulder-press',
+    });
+    today.run({ type: 'uncomfortable', entryId: today.find('dumbbell-shoulder-press')!.id });
+    today.run({ type: 'uncomfortable', entryId: today.find('arnold-press')!.id });
+    const raise = today.find('lateral-raise')!;
+    today.log(raise);
+    const stop = today.run({ type: 'uncomfortable', entryId: raise.id });
+    expect(stop.summary.headline).toBe(
+      'Lateral Raise stops at the sets done: no comfortable alternative fits Home.',
+    );
+    expect(slotLive(today.workout, raise.slot)).toEqual([]);
+    today.run({ type: 'end-by', time: at(9, 19, 30) });
+    // On 89dfb39: "Ends by 7:30 PM: 1 exercise added." push-up x2, the lift swapped away.
+    expect(slotLive(today.workout, raise.slot), today.steps.join(' | ')).toEqual([]);
+  });
+});
diff --git a/src/engine/recalibration/catchUpSwapBackOver.test.ts b/src/engine/recalibration/catchUpSwapBackOver.test.ts
new file mode 100644
index 0000000..f641f21
--- /dev/null
+++ b/src/engine/recalibration/catchUpSwapBackOver.test.ts
@@ -0,0 +1,212 @@
+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { rankAlternatives } from '../alternatives/rankAlternatives';
+import type { CatchUpSpec } from '../planning/catchUp';
+import {
+  contextFor,
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+  swapsOffered,
+} from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationRequest,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import {
+  allEntries,
+  isStopped,
+  stoppedBefore,
+  type GeneratedWorkout,
+  type WorkoutEntry,
+} from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import {
+  at,
+  describeWorkout,
+  gym as gymOrNone,
+  profileOf,
+  session,
+  working,
+} from '../../test/clockDays';
+
+/**
+ * Fifteenth review of round M. A swap back to a lift stopped earlier is let through whatever the
+ * plan has given its muscles since: `catchUpRefusal` returns null for it before any check, and the
+ * swap sheet offers it. The dumbbell shoulder press serves the front delts and the triceps, and the
+ * triceps' own slot stays quiet. A set of it, then the lifter swaps it for the Arnold press (front
+ * delts only): the triceps have two sets left, and the next rebuild ("Make it harder") gives them a
+ * lift of their own for those two. The Arnold press's sheet then offers the shoulder press back, and
+ * the swap picks it up for the Arnold press's two sets: the triceps get five working sets for three.
+ * In a catch-up that is more than they lack; in a second workout, with the triceps trained this
+ * morning, more than what is left of today's session. The rules: no muscle gets more than it lacks;
+ * the lifter's swap that would break that is refused with its reason, and the sheet never offers it.
+ * Synthetic data only.
+ */
+
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+const gym = gymOrNone as LocationProfile;
+const NOW = at(9, 18);
+const profile = profileOf();
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const succeeded = (result: ReturnType<typeof recalibrate>): RecalibrationSuccess => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+/** A muscle's working sets from lifts that work it directly: a stopped lift's sets done. */
+const given = (workout: GeneratedWorkout, completed: CompletedWork, muscle: string) =>
+  allEntries(workout.blocks)
+    .filter((entry) => requireExercise(entry.exerciseId).primaryMuscles.includes(muscle as never))
+    .reduce(
+      (sum, entry) =>
+        sum +
+        working(entry).filter(
+          (set) =>
+            !isStopped(entry) ||
+            completed.sets.some((done) => done.entryId === entry.id && done.setIndex === set.index),
+        ).length,
+      0,
+    );
+
+const catchUp: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['front-delts', 'triceps'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+/** A bench press and pushdowns this morning: the chest sits out, the triceps take what is left. */
+const second: CatchUpSpec = {
+  kind: 'second',
+  muscles: [
+    { muscle: 'front-delts', sets: 3, minRir: 1, why: 'behind' },
+    { muscle: 'triceps', sets: 3, minRir: 3, why: 'remainder' },
+  ],
+  sitOut: ['chest'],
+};
+const row = session(at(3, 18), [['barbell-row', 3]]);
+const morning = session(at(9, 9), [
+  ['barbell-bench-press', 3],
+  ['cable-triceps-pushdown', 3],
+]);
+
+function swappedBack(spec: CatchUpSpec, records: WorkoutRecord[], location: LocationProfile) {
+  let workout = generateWorkout({
+    profile,
+    location,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: spec },
+  });
+  let constraints: SessionConstraints = { ...emptyConstraints(), catchUp: spec };
+  const press = allEntries(workout.blocks)[0]!;
+  expect(press.exerciseId, lifts(workout)).toBe('dumbbell-shoulder-press');
+  expect(given(workout, emptyCompleted(), 'triceps'), lifts(workout)).toBe(3);
+  // One set of the shoulder press.
+  const first = working(press)[0]!;
+  const completed: CompletedWork = {
+    ...emptyCompleted(),
+    startedAt: NOW,
+    elapsedSeconds: 300,
+    currentEntryId: press.id,
+    sets: [
+      {
+        entryId: press.id,
+        exerciseId: press.exerciseId,
+        setIndex: first.index,
+        kind: 'working',
+        reps: 8,
+        weight: first.targetWeight,
+        rir: 2,
+        completedAt: at(9, 18, 5),
+      },
+    ],
+  };
+  const request = (trigger: RecalibrationTrigger): RecalibrationRequest => ({
+    trigger,
+    workout,
+    completed,
+    lockedEntryIds: [],
+    currentEntryId: completed.currentEntryId,
+    duration: 'default',
+    profile,
+    location,
+    loading: { missingPlates: [] },
+    history: records,
+    constraints,
+    reason: 'test',
+    timestamp: at(9, 18, 10),
+  });
+  const sheet = (entry: WorkoutEntry) =>
+    swapsOffered(
+      rankAlternatives({
+        current: requireExercise(entry.exerciseId),
+        context: contextFor({ profile, location }, constraints),
+        // As the screens rank it: the lift a stand-in took over from is offered back.
+        otherExercises: allEntries(workout.blocks)
+          .filter(
+            (other) =>
+              other.id !== entry.id && !stoppedBefore(workout.blocks, entry).includes(other),
+          )
+          .map((other) => requireExercise(other.exerciseId)),
+        plannedSets: { sets: entry.sets.length, restSeconds: entry.restSeconds },
+        limit: 6,
+      }),
+      { constraints, completed, history: records, timestamp: at(9, 18, 10) },
+      workout,
+      entry,
+    ).candidates.map((candidate) => candidate.exercise.id);
+
+  // The lifter swaps it for the Arnold press, which the sheet offers.
+  expect(sheet(press)).toContain('arnold-press');
+  const swapped = succeeded(
+    recalibrate(request({ type: 'replace', entryId: press.id, exerciseId: 'arnold-press' })),
+  );
+  workout = swapped.workout;
+  constraints = swapped.constraints;
+  // "Make it harder": the triceps, two sets left, take a lift of their own for them.
+  const harder = succeeded(recalibrate(request({ type: 'intensity', direction: 'harder' })));
+  workout = harder.workout;
+  constraints = harder.constraints;
+  expect(given(workout, completed, 'triceps'), lifts(workout)).toBe(3);
+  const arnold = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'arnold-press')!;
+  expect(arnold, lifts(workout)).toBeDefined();
+  // The Arnold press's sheet offers the shoulder press back.
+  const offered = sheet(arnold);
+  const back = recalibrate(
+    request({ type: 'replace', entryId: arnold.id, exerciseId: 'dumbbell-shoulder-press' }),
+  );
+  return { back, offered, completed, before: lifts(workout) };
+}
+
+describe('a swap back to a lift stopped earlier keeps to what its muscles lack', () => {
+  it.each([
+    ['a catch-up for the front delts and the triceps, at the gym', catchUp, [row], gym],
+    ['a second workout, the triceps trained this morning, at home', second, [row, morning], home],
+  ] as const)('%s', (_, spec, records, location) => {
+    const { back, offered, completed, before } = swappedBack(spec, [...records], location);
+    const detail = back.ok
+      ? `${before} -> ${back.summary.headline} ${lifts(back.workout)}`
+      : `refused: ${back.error}; offered: ${offered.join(', ')}`;
+    // The triceps have no set left beside their own lift: the swap back is refused with its reason,
+    // and the sheet does not offer it. On 3290cd8 it is offered and taken: "Swapped Arnold Press for
+    // Dumbbell Shoulder Press.", the shoulder press x3 beside the triceps' own lift x2: five for
+    // three. (Taken with nothing to pick up, the Arnold press would go for nothing.)
+    expect(back.ok, detail).toBe(false);
+    expect(back.ok ? '' : back.error, detail).toMatch(/more than they lack/);
+    expect(offered, detail).not.toContain('dumbbell-shoulder-press');
+    expect(given(back.workout, completed, 'triceps'), detail).toBeLessThanOrEqual(3);
+  });
+});
