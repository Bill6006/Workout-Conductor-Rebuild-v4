+        if (nth is None and count != 1) or (nth is not None and count <= nth):
+            return None, f"ANCHOR x{count}"
+        at = -1
+        for _ in range((nth or 0) + 1):
+            at = mutated.index(part_old, at + 1)
+        mutated = mutated[:at] + part_new + mutated[at + len(part_old):]
+    return mutated, None
