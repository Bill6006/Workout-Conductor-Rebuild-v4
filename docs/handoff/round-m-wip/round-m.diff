+      workout = next.workout;
+      constraints = next.constraints;
+      expect(workout.catchUpSlots?.length, `${choice}: ${lifts(workout)}`).toBe(laidOut);
+    }
+    expect(directSets(workout, 'glutes'), lifts(workout)).toBeGreaterThan(0);
+  });
+});
