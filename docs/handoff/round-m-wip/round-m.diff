+  trigger,
+  workout,
+  completed: emptyCompleted(),
+  lockedEntryIds: [],
+  currentEntryId: null,
+  duration: 'default',
+  profile: profileOf(),
+  location: gym,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints: { ...emptyConstraints(), catchUp: spec },
+  reason: 'test',
+  timestamp: NOW,
+  ...options,
+});
