+    exerciseId,
+    [
+      [range[1], 100, 2],
+      [range[1], 100, 2],
+      [range[1], 100, 2],
+    ],
+    range,
+    2,
+  );
+const works = (workout: GeneratedWorkout, muscle: MuscleId) =>
