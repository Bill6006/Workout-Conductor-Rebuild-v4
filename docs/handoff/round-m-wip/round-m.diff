@@ -0,0 +1,139 @@
+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import type { LocationProfile } from '../../core/validation/location';
+import type { CatchUpSpec } from '../planning/catchUp';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+import { allEntries, isStopped, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import {
+  at,
+  describeWorkout,
+  gym as gymOrNone,
+  profileOf,
+  session,
+  working,
+} from '../../test/clockDays';
+
+/**
+ * Fifteenth review of round M. A lift stopped earlier, swapped back to, picks up the sets the lift in
+ * its place still owed, within what its muscles have left beside the plan's other lifts, its own
+ * sets done counted, as what stands in keeps to it. A catch-up for the front delts and the triceps,
+ * the triceps lacking four: a set of the shoulder press, then the Arnold press, then "Make it
+ * easier" gives the triceps a lift of their own for two of their three sets left. Swapped back, the
+ * press takes one set, not the Arnold press's two. Synthetic data only.
+ */
+
+const gym = gymOrNone as LocationProfile;
+const NOW = at(9, 18);
+const profile = profileOf();
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const succeeded = (result: ReturnType<typeof recalibrate>): RecalibrationSuccess => {
+  if (!result.ok) throw new Error(result.error);
+  return result;
+};
+/** A muscle's working sets from lifts that work it directly: a stopped lift's sets done. */
+const given = (workout: GeneratedWorkout, completed: CompletedWork, muscle: string) =>
+  allEntries(workout.blocks)
+    .filter((entry) => requireExercise(entry.exerciseId).primaryMuscles.includes(muscle as never))
+    .reduce(
+      (sum, entry) =>
+        sum +
+        working(entry).filter(
+          (set) =>
+            !isStopped(entry) ||
+            completed.sets.some((done) => done.entryId === entry.id && done.setIndex === set.index),
+        ).length,
+      0,
+    );
+
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [
+    { muscle: 'front-delts', sets: 3, minRir: 1, why: 'behind' },
+    { muscle: 'triceps', sets: 4, minRir: 1, why: 'behind' },
+  ],
+  sitOut: [],
+};
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+
+describe('a swap back picks up no more than its muscles have left', () => {
+  it('the triceps lacking four, one set left beside the pushdowns: the press takes one set back', () => {
+    let workout = generateWorkout({
+      profile,
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    let constraints: SessionConstraints = { ...emptyConstraints(), catchUp: spec };
+    const press = allEntries(workout.blocks)[0]!;
+    expect(press.exerciseId, lifts(workout)).toBe('dumbbell-shoulder-press');
+    const first = working(press)[0]!;
+    const completed: CompletedWork = {
+      ...emptyCompleted(),
+      startedAt: NOW,
+      elapsedSeconds: 300,
+      currentEntryId: press.id,
+      sets: [
+        {
+          entryId: press.id,
+          exerciseId: press.exerciseId,
+          setIndex: first.index,
+          kind: 'working',
+          reps: 8,
+          weight: first.targetWeight,
+          rir: 2,
+          completedAt: at(9, 18, 5),
+        },
+      ],
+    };
+    const run = (trigger: RecalibrationTrigger) => {
+      const result = succeeded(
+        recalibrate({
+          trigger,
+          workout,
+          completed,
+          lockedEntryIds: [],
+          currentEntryId: completed.currentEntryId,
+          duration: 'default',
+          profile,
+          location: gym,
+          loading: { missingPlates: [] },
+          history: records,
+          constraints,
+          reason: 'test',
+          timestamp: at(9, 18, 10),
+        }),
+      );
+      workout = result.workout;
+      constraints = result.constraints;
+      return result;
+    };
+    run({ type: 'replace', entryId: press.id, exerciseId: 'arnold-press' });
+    // "Make it easier": the triceps take a lift of their own for two of their three sets left.
+    run({ type: 'intensity', direction: 'easier' });
+    const before = lifts(workout);
+    expect(given(workout, completed, 'triceps'), before).toBe(3);
+    const arnold = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'arnold-press')!;
+    expect(working(arnold).length, before).toBe(2);
+    const back = run({
+      type: 'replace',
+      entryId: arnold.id,
+      exerciseId: 'dumbbell-shoulder-press',
+    });
+    const detail = `${before} -> ${back.summary.headline} ${lifts(back.workout)}`;
+    // One set left for the triceps: the press picks up one set, never the Arnold press's two.
+    expect(given(back.workout, completed, 'triceps'), detail).toBe(4);
+    const again = allEntries(back.workout.blocks).find(
+      (entry) => entry.exerciseId === 'dumbbell-shoulder-press' && !isStopped(entry),
+    );
+    expect(again && working(again).length, detail).toBe(2);
+  });
+});
diff --git a/src/engine/recalibration/catchUpSwapReserve.test.ts b/src/engine/recalibration/catchUpSwapReserve.test.ts
new file mode 100644
index 0000000..a057485
--- /dev/null
+++ b/src/engine/recalibration/catchUpSwapReserve.test.ts
@@ -0,0 +1,109 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import { CATCH_UP, type CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+} from '../../engine/recalibration/recalibrate';
+import type { RecalibrationRequest } from '../../engine/recalibration/types';
+import { allEntries, type GeneratedWorkout } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Maintenance 31 (the twelfth review of round M): a swap in a catch-up keeps the catch-up's reserve whatever
+ * lift comes in (the second review: "a swap ... keeps a catch-up's sets and reserve"; no set to
+ * failure, at least 1 in reserve, 2 for a beginner). The hold reads the muscles of the lift that comes
+ * in (`heldShift`, `catchUpHold`), so a lift for none of the day's muscles, which the swap sheet
+ * offers, takes its own reserve, and "Make it harder" or a check-in after it plans it from its own
+ * reserve too. Before: the dumbbell curl in for the hammer curl (the forearms' lift) at 0 in reserve,
+ * a set to failure, for a beginner too. Synthetic data only.
+ */
+
+// A row last Thursday: nothing the day is for rests on Wednesday the 9th, at 6 pm, a day the default
+// profile does not tick.
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+/** Dumbbells and nothing else. */
+const [home] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  at(1),
+) as [LocationProfile];
+
+describe('a swap keeps the catch-up’s reserve, the twelfth review of round M', () => {
+  it.each([
+    ['an intermediate', 'intermediate' as const, CATCH_UP.MIN_RIR],
+    ['a beginner', 'beginner' as const, CATCH_UP.BEGINNER_MIN_RIR],
+  ])('%s swaps the hammer curl, for the forearms, for a dumbbell curl', (_, experience, minRir) => {
+    const profile = profileOf({ experience });
+    const sets = experience === 'beginner' ? CATCH_UP.BEGINNER_SETS : CATCH_UP.SETS;
+    const spec: CatchUpSpec = {
+      kind: 'catch-up',
+      muscles: (['forearms', 'chest'] as const).map((muscle) => ({
+        muscle,
+        sets,
+        minRir,
+        why: 'behind' as const,
+      })),
+      sitOut: [],
+    };
+    const plan = generateWorkout({
+      profile,
+      location: home,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const hammer = allEntries(plan.blocks).find((entry) => entry.exerciseId === 'hammer-curl');
+    expect(hammer, lifts(plan)).toBeDefined();
+    expect(
+      Math.min(...working(hammer!).map((set) => set.targetRir)),
+      lifts(plan),
+    ).toBeGreaterThanOrEqual(minRir);
+    const request: RecalibrationRequest = {
+      trigger: { type: 'replace', entryId: hammer!.id, exerciseId: 'dumbbell-curl' },
+      workout: plan,
+      completed: emptyCompleted(),
+      lockedEntryIds: [],
+      currentEntryId: null,
+      duration: 'default',
+      profile,
+      location: home,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints: { ...emptyConstraints(), catchUp: spec },
+      reason: 'test',
+      timestamp: NOW,
+    };
+    const result = recalibrate(request);
+    if (!result.ok) throw new Error(result.error);
+    const curl = allEntries(result.workout.blocks).find(
+      (entry) => entry.exerciseId === 'dumbbell-curl',
+    );
+    expect(curl, lifts(result.workout)).toBeDefined();
+    // Before: "dumbbell-curl x2 @RIR 0/0", an intermediate's and a beginner's alike.
+    expect(
+      Math.min(...working(curl!).map((set) => set.targetRir)),
+      lifts(result.workout),
+    ).toBeGreaterThanOrEqual(minRir);
+    // And "Make it harder" after it takes the curl no lower than the catch-up's reserve, as it
+    // holds every lift of the day (the second review).
+    const harder = recalibrate({
+      ...request,
+      trigger: { type: 'intensity', direction: 'harder' },
+      workout: result.workout,
+      constraints: result.constraints,
+    });
+    if (!harder.ok) throw new Error(harder.error);
+    const after = allEntries(harder.workout.blocks).find(
+      (entry) => entry.exerciseId === 'dumbbell-curl',
+    );
+    expect(
+      Math.min(...working(after!).map((set) => set.targetRir)),
+      `${harder.summary.headline} ${lifts(harder.workout)}`,
+    ).toBeGreaterThanOrEqual(minRir);
+  });
+});
diff --git a/src/engine/recalibration/catchUpSwapResting.test.ts b/src/engine/recalibration/catchUpSwapResting.test.ts
new file mode 100644
index 0000000..c7b60b2
--- /dev/null
+++ b/src/engine/recalibration/catchUpSwapResting.test.ts
@@ -0,0 +1,177 @@
+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import { rankAlternatives } from '../../engine/alternatives/rankAlternatives';
+import type { CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  contextFor,
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+  swapsOffered,
+} from './recalibrate';
+import type { RecalibrationRequest } from './types';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, directSets, gym, profileOf, session } from '../../test/clockDays';
+
+/**
+ * Maintenance 31 (the fourteenth review of round M): the lifter's swap in a catch-up or a second
+ * workout, and the swap sheet, bring in no lift for a muscle that rests today or sits out, as what
+ * comes in for comfort or pain does. Synthetic data only.
+ */
+
+// Leg extensions yesterday evening (the quads rest today) and a row last Thursday; Wednesday the
+// 9th, 6 pm, a day the default profile does not tick.
+const records = [
+  session(at(3, 18), [['barbell-row', 3]]),
+  session(at(8, 18), [['leg-extension', 3]]),
+];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const spec: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: [{ muscle: 'glutes', sets: 3, minRir: 1, why: 'behind' }],
+  sitOut: [],
+};
+const constraints = { ...emptyConstraints(), catchUp: spec };
+
+describe('the lifter’s swap in a catch-up brings in no lift for a muscle that rests, the fourteenth review of round M', () => {
+  it('the dumbbell Romanian deadlift for the glutes, the quads trained yesterday', () => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    // The plan itself gives the quads nothing.
+    expect(directSets(plan, 'quads'), lifts(plan)).toBe(0);
+    const entry = allEntries(plan.blocks).find(
+      (candidate) => candidate.exerciseId === 'dumbbell-romanian-deadlift',
+    ) as WorkoutEntry;
+    expect(entry, lifts(plan)).toBeDefined();
+    // The swap sheet, as Today ranks it and filters it.
+    const sheet = swapsOffered(
+      rankAlternatives({
+        current: requireExercise(entry.exerciseId),
+        context: contextFor({ profile: profileOf(), location: gym }, constraints),
+        otherExercises: allEntries(plan.blocks)
+          .filter((other) => other.id !== entry.id)
+          .map((other) => requireExercise(other.exerciseId)),
+        plannedSets: { sets: entry.sets.length, restSeconds: entry.restSeconds },
+        limit: 6,
+      }),
+      { constraints, completed: emptyCompleted(), history: records, timestamp: NOW },
+      plan,
+      entry,
+    );
+    const offered = sheet.candidates.map((candidate) => candidate.exercise);
+    const forQuads = offered.filter((exercise) => exercise.primaryMuscles.includes('quads'));
+    // The sheet offers no lift that works the quads directly. On d361edf: the trap-bar deadlift.
+    expect(
+      forQuads.map((exercise) => exercise.id),
+      offered.map((exercise) => exercise.id).join(', '),
+    ).toEqual([]);
+  });
+
+  it('swapped in from the sheet anyway, the quads take sets the day leaves them none of', () => {
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: records,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: spec },
+    });
+    const entry = allEntries(plan.blocks).find(
+      (candidate) => candidate.exerciseId === 'dumbbell-romanian-deadlift',
+    ) as WorkoutEntry;
+    const request: RecalibrationRequest = {
+      trigger: { type: 'replace', entryId: entry.id, exerciseId: 'trap-bar-deadlift' },
+      workout: plan,
+      completed: emptyCompleted(),
+      lockedEntryIds: [],
+      currentEntryId: null,
+      duration: 'default',
+      profile: profileOf(),
+      location: gym,
+      loading: { missingPlates: [] },
+      history: records,
+      constraints,
+      reason: 'test',
+      timestamp: NOW,
+    };
+    const result = recalibrate(request);
+    // Refused with the reason, or the quads given nothing. On d361edf: "Swapped Dumbbell Romanian
+    // Deadlift for Trap Bar Deadlift.", the quads three direct sets the day after they were trained.
+    if (result.ok) {
+      expect(
+        directSets(result.workout, 'quads'),
+        `${result.summary.headline} ${lifts(result.workout)}`,
+      ).toBe(0);
+    }
+  });
+
+  it('a second workout: the triceps sit out, the sheet offers the overhead press for the Arnold press', () => {
+    // An overhead press this morning: the triceps sit out tonight, the front delts take what is left.
+    const today = [...records, session(at(9, 9), [['overhead-press', 3]])];
+    const second: CatchUpSpec = {
+      kind: 'second',
+      muscles: [{ muscle: 'front-delts', sets: 2, minRir: 3, why: 'remainder' }],
+      sitOut: ['triceps'],
+    };
+    const day = { ...emptyConstraints(), catchUp: second };
+    const plan = generateWorkout({
+      profile: profileOf(),
+      location: gym,
+      history: today,
+      now: NOW,
+      duration: 'default',
+      constraints: { catchUp: second },
+    });
+    expect(directSets(plan, 'triceps'), lifts(plan)).toBe(0);
+    const entry = allEntries(plan.blocks).find(
+      (candidate) => candidate.exerciseId === 'arnold-press',
+    ) as WorkoutEntry;
+    expect(entry, lifts(plan)).toBeDefined();
+    const sheet = swapsOffered(
+      rankAlternatives({
+        current: requireExercise(entry.exerciseId),
+        context: contextFor({ profile: profileOf(), location: gym }, day),
+        otherExercises: allEntries(plan.blocks)
+          .filter((other) => other.id !== entry.id)
+          .map((other) => requireExercise(other.exerciseId)),
+        plannedSets: { sets: entry.sets.length, restSeconds: entry.restSeconds },
+        limit: 6,
+      }),
+      { constraints: day, completed: emptyCompleted(), history: today, timestamp: NOW },
+      plan,
+      entry,
+    );
+    const offered = sheet.candidates.map((candidate) => candidate.exercise);
+    const result = recalibrate({
+      trigger: { type: 'replace', entryId: entry.id, exerciseId: 'overhead-press' },
+      workout: plan,
+      completed: emptyCompleted(),
+      lockedEntryIds: [],
+      currentEntryId: null,
+      duration: 'default',
+      profile: profileOf(),
+      location: gym,
+      loading: { missingPlates: [] },
+      history: today,
+      constraints: day,
+      reason: 'test',
+      timestamp: NOW,
+    });
+    const details = `sheet: ${offered.map((exercise) => exercise.id).join(', ')} | ${result.ok ? `${result.summary.headline} ${lifts(result.workout)}` : result.error}`;
+    // On d361edf the sheet offers it, and "Swapped Arnold Press for Overhead Press." gives the
+    // triceps, trained this morning, two more direct sets.
+    expect(
+      offered.filter((exercise) => exercise.primaryMuscles.includes('triceps')).map((e) => e.id),
+      details,
+    ).toEqual([]);
+    if (result.ok) expect(directSets(result.workout, 'triceps'), details).toBe(0);
+  });
+});
diff --git a/src/engine/recalibration/catchUpSwapRules.test.ts b/src/engine/recalibration/catchUpSwapRules.test.ts
new file mode 100644
index 0000000..b19543e
--- /dev/null
+++ b/src/engine/recalibration/catchUpSwapRules.test.ts
@@ -0,0 +1,234 @@
+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import { rankAlternatives } from '../../engine/alternatives/rankAlternatives';
+import { CATCH_UP, type CatchUpSpec } from '../../engine/planning/catchUp';
+import {
+  contextFor,
+  emptyCompleted,
+  emptyConstraints,
+  recalibrate,
+  swapsOffered,
+} from '../../engine/recalibration/recalibrate';
+import type { CompletedWork, RecalibrationRequest } from '../../engine/recalibration/types';
+import {
+  allEntries,
+  isStopped,
+  type GeneratedWorkout,
+  type WorkoutEntry,
+} from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { at, describeWorkout, gym, profileOf, session, working } from '../../test/clockDays';
+
+/**
+ * Maintenance 31, the thirteenth review of round M. "What comes in for a lift ('Uncomfortable',
+ * 'Hurts', a swap) works a muscle the lift went in for, none the plan's other lifts have given its
+ * sets (the lift's own sets done counted), within what the day's muscles have left; never a one-set
+ * stand-in." The twelfth review held "Uncomfortable" and "Hurts" to it (`bestAlternative`), but a
+ * swap the lifter picks from the swap sheet goes through `applySubstitution` / `standIn` with only
+ * a cap at the room left, floored at one set (`Math.max(1, ...)`). So in a lower-body catch-up at
+ * the gym, every lift the sheet offers for the leg curl works the glutes, which the back squat has
+ * given their three sets: the swap comes in with one set, the glutes get four for three and the
+ * hamstrings one for three. And the back squat begun with one set left, swapped from the sheet,
+ * takes a one-set stand-in, which "Uncomfortable" and "Hurts" no longer give. Synthetic data only.
+ */
+
+// A row last Thursday: nothing the day is for rests on Wednesday the 9th, at 6 pm, a day the default
+// profile does not tick.
+const records = [session(at(3, 18), [['barbell-row', 3]])];
+const NOW = at(9, 18);
+const lifts = (workout: GeneratedWorkout) => describeWorkout(workout).join('; ');
+const lower: CatchUpSpec = {
+  kind: 'catch-up',
+  muscles: (['quads', 'glutes', 'hamstrings'] as const).map((muscle) => ({
+    muscle,
+    sets: 3,
+    minRir: 1,
+    why: 'behind' as const,
+  })),
+  sitOut: [],
+};
+const plan = () =>
+  generateWorkout({
+    profile: profileOf(),
+    location: gym,
+    history: records,
+    now: NOW,
+    duration: 'default',
+    constraints: { catchUp: lower },
+  });
+/** What the swap sheet offers for a lift of the plan (as the Today and workout screens rank it). */
+const offered = (workout: GeneratedWorkout, entry: WorkoutEntry) =>
+  rankAlternatives({
+    current: requireExercise(entry.exerciseId),
+    context: contextFor({ profile: profileOf(), location: gym }, emptyConstraints()),
+    otherExercises: allEntries(workout.blocks)
+      .filter((other) => other.id !== entry.id)
+      .map((other) => requireExercise(other.exerciseId)),
+    plannedSets: { sets: entry.sets.length, restSeconds: entry.restSeconds },
+    limit: 6,
+  }).candidates.map((candidate) => candidate.exercise.id);
+const request = (
+  workout: GeneratedWorkout,
+  entry: WorkoutEntry,
+  exerciseId: string,
+  completed: CompletedWork,
+): RecalibrationRequest => ({
+  trigger: { type: 'replace', entryId: entry.id, exerciseId },
+  workout,
+  completed,
+  lockedEntryIds: [],
+  currentEntryId: completed.sets.length > 0 ? entry.id : null,
+  duration: 'default',
+  profile: profileOf(),
+  location: gym,
+  loading: { missingPlates: [] },
+  history: records,
+  constraints: { ...emptyConstraints(), catchUp: lower },
+  reason: 'test',
+  timestamp: NOW,
+});
+const setsDone = (entry: WorkoutEntry, count: number): CompletedWork => ({
+  ...emptyCompleted(),
+  startedAt: count > 0 ? NOW : null,
+  elapsedSeconds: 300 * count,
+  sets: working(entry)
+    .slice(0, count)
+    .map((set, index) => ({
+      entryId: entry.id,
+      exerciseId: entry.exerciseId,
+      setIndex: set.index,
+      kind: 'working' as const,
+      reps: 8,
+      weight: set.targetWeight,
+      rir: 2,
+      completedAt: at(9, 18, index * 4),
+    })),
+});
+/** Each muscle's working sets from lifts that work it directly: a stopped lift's sets done. */
+const given = (workout: GeneratedWorkout, completed: CompletedWork, muscle: string) =>
+  allEntries(workout.blocks)
+    .filter((entry) => requireExercise(entry.exerciseId).primaryMuscles.includes(muscle as never))
+    .reduce(
+      (sum, entry) =>
+        sum +
+        working(entry).filter(
+          (set) =>
+            !isStopped(entry) ||
+            completed.sets.some((done) => done.entryId === entry.id && done.setIndex === set.index),
+        ).length,
+      0,
+    );
+/** The rules broken by a result: a muscle given more than it lacks, a lift with one set to do. */
+const broken = (workout: GeneratedWorkout, completed: CompletedWork) => [
+  ...lower.muscles
+    .filter((item) => given(workout, completed, item.muscle) > item.sets)
+    .map((item) => `${item.muscle} ${given(workout, completed, item.muscle)} for ${item.sets}`),
+  ...allEntries(workout.blocks)
+    .filter((entry) => !isStopped(entry) && working(entry).length < CATCH_UP.MIN_SETS)
+    .map((entry) => `${entry.exerciseId} x${working(entry).length}`),
+];
+
+describe('a swap in a catch-up keeps to the day’s muscles, the thirteenth review of round M', () => {
+  it.each([
+    ['not begun', 0],
+    ['a set done', 1],
+  ])('the leg curl (%s) swapped for the Romanian deadlift the sheet offers', (_, done) => {
+    const workout = plan();
+    const curl = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'leg-curl');
+    expect(curl, lifts(workout)).toBeDefined();
+    // The back squat has given the glutes their three sets.
+    expect(given(workout, emptyCompleted(), 'glutes'), lifts(workout)).toBe(3);
+    // Every lift the sheet offers for the leg curl works the glutes directly.
+    const sheet = offered(workout, curl!);
+    expect(sheet).toContain('romanian-deadlift');
+    expect(sheet.every((id) => requireExercise(id).primaryMuscles.includes('glutes'))).toBe(true);
+    const completed = setsDone(curl!, done);
+    const result = recalibrate(request(workout, curl!, 'romanian-deadlift', completed));
+    // Refused, or kept to the rules. On a9f07f3: "Swapped Leg Curl for Romanian Deadlift.",
+    // "romanian-deadlift x1": the glutes four sets for three, the hamstrings one (or two) for three.
+    if (result.ok) {
+      expect(
+        broken(result.workout, completed),
+        `${result.summary.headline} ${lifts(result.workout)}`,
+      ).toEqual([]);
+    }
+  });
+
+  it('the back squat, two of its three sets done, swapped for the leg press the sheet offers', () => {
+    const workout = plan();
+    const squat = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'back-squat');
+    expect(squat, lifts(workout)).toBeDefined();
+    expect(working(squat!).length, lifts(workout)).toBe(3);
+    expect(offered(workout, squat!)).toContain('leg-press');
+    const completed = setsDone(squat!, 2);
+    const result = recalibrate(request(workout, squat!, 'leg-press', completed));
+    // Refused, or kept to the rules (the quads and the glutes have one set left: it waits). On
+    // a9f07f3: "back-squat x2 (stopped); leg-press x1".
+    if (result.ok) {
+      expect(
+        broken(result.workout, completed),
+        `${result.summary.headline} ${lifts(result.workout)}`,
+      ).toEqual([]);
+    }
+  });
+});
+
+describe('the swap sheet in a catch-up offers no swap it turns down, the thirteenth review of round M', () => {
+  it('the leg curl’s sheet, the back squat having given the glutes their sets: nothing for them', () => {
+    const workout = plan();
+    const curl = allEntries(workout.blocks).find((entry) => entry.exerciseId === 'leg-curl')!;
+    const ranked = rankAlternatives({
+      current: requireExercise(curl.exerciseId),
+      context: contextFor({ profile: profileOf(), location: gym }, emptyConstraints()),
+      otherExercises: allEntries(workout.blocks)
+        .filter((other) => other.id !== curl.id)
+        .map((other) => requireExercise(other.exerciseId)),
+      plannedSets: { sets: curl.sets.length, restSeconds: curl.restSeconds },
+      limit: 6,
+    });
+    expect(ranked.candidates.map((candidate) => candidate.exercise.id)).toContain(
+      'romanian-deadlift',
+    );
+    const day = {
+      constraints: { ...emptyConstraints(), catchUp: lower },
+      completed: emptyCompleted(),
+      history: records,
+      timestamp: NOW,
+    };
+    const offered = swapsOffered(ranked, day, workout, curl);
+    // Every lift the sheet ranks works the glutes: none is offered, and the sheet says why.
+    expect(offered.candidates).toEqual([]);
+    expect(offered.emptyReason).toMatch(/more than they lack/);
+    // On a day of the plan the sheet offers them all.
+    expect(swapsOffered(ranked, { ...day, constraints: emptyConstraints() }, workout, curl)).toBe(
+      ranked,
+    );
+  });
+});
+
