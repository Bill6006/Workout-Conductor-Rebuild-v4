diff --git a/src/review-m31u/emptiedSavedOtherPlace.store.test.ts b/src/review-m31u/emptiedSavedOtherPlace.store.test.ts
new file mode 100644
index 0000000..86fbe03
--- /dev/null
+++ b/src/review-m31u/emptiedSavedOtherPlace.store.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import { allEntries } from '../engine/workout/types';
+import { offerKey } from '../engine/workoutGenerator/generate';
+import { dayNoteOf } from '../features/today/dayNote';
+import { record } from '../test/records';
+import { createTestStore } from '../test/testStore';
+
+/**
+ * Twenty-second review of round M, on the twenty-first pass's carry of a workout saved with nothing
+ * logged into the next plan (`dismissCompletion` hands the finished session to `ensureSession` as
+ * `carry`), where it meets `ensureSession`'s own shortcut for a plan the lifter emptied
+ * (`keepEmptied`: `workout = before.workout`).
+ *
+ * The rules: the twentieth pass, "The rebuild no longer hands back the old plan: the generator lays
+ * out an emptied plan empty and says where it was built, and a place that lays out another plan
+ * (the split's own day standing in) builds that one", fixing "an emptied plan taken to another place
+ * kept the old place's lines"; and "Why this workout" says where the plan was built ("Built for Gym
+ * from the equipment saved there").
+ *
+ * What happens: a change of place on the completion screen rebuilds nothing (`saveProfile` skips a
+ * completed session and only moves its key). When the completion is put away, the carried session
+ * is the plan the lifter emptied at the old place, and `ensureSession` hands that very workout back
+ * whenever its offer and layout are marked, without asking the generator: at the gym the empty plan
+ * still says "Built for Flat from the equipment saved there" and "No incline push option fits Flat
+ * and your limits.", and keeps Flat as its place. The same plan emptied on Today and taken to the gym
+ * is made again there (the twentieth pass's test).
+ *
+ * Steps (synthetic data only): on Saturday, with no sessions left this week (so the offer reads the
+ * same at every place and after the save), a bench press, a squat and a row this week; at Flat
+ * (dumbbells only) the catch-up is built. The lifter starts it, skips each lift, saves the workout
+ * with nothing logged, sets the place to the gym on the completion screen, and puts the completion
+ * away: "Not one of your training days: nothing more for today.", the plan Flat's.
+ *
+ * A regression of the twenty-first pass: on 333f1d4 the completion put away carried nothing and the
+ * plan was built whole at the gym, its lines the gym's (the test fails there only at the last
+ * assertion, the plan kept empty, which is the twenty-first pass's own finding).
+ */
+
+const SATURDAY = '2026-09-05T12:00:00.000Z';
+const DAY = 86_400_000;
+const [dumbbells] = createDefaultLocations(
+  { gymAccess: false, homeEquipment: ['dumbbells'] },
+  SATURDAY,
+) as [LocationProfile];
+const flat: LocationProfile = { ...dumbbells, id: 'flat', name: 'Flat' };
+
+async function lifter() {
+  const handle = createTestStore({ now: () => SATURDAY });
+  await handle.store.hydrate();
+  await handle.store.completeOnboarding(
+    { ...createDefaultProfile(SATURDAY), bodyweight: 185 },
+    createDefaultLocations({ gymAccess: true }, SATURDAY),
+  );
+  const db = await handle.store.getDatabase();
+  for (const [exerciseId, daysAgo] of [
+    ['barbell-bench-press', 4],
+    ['back-squat', 3],
+    ['barbell-row', 1],
+  ] as const) {
+    const when = new Date(Date.parse(SATURDAY) - daysAgo * DAY).toISOString();
+    await db.put('workouts', {
+      ...record(
+        0,
+        exerciseId,
+        [
+          [10, 100, 2],
+          [10, 100, 2],
+          [10, 100, 2],
+        ],
+        [8, 12],
+        2,
+      ),
+      id: `w-${exerciseId}`,
+      startedAt: when,
+      completedAt: when,
+    });
+  }
+  await handle.store.hydrate();
+  await handle.store.saveLocation(flat);
+  return handle;
+}
+
+type Handle = Awaited<ReturnType<typeof lifter>>;
+const session = (handle: Handle) => handle.store.getSnapshot().session!;
+const lines = (handle: Handle) => [
+  ...session(handle).workout.explanation.reasons,
+  ...session(handle).workout.compromises,
+];
+
+async function moveTo(handle: Handle, id: string) {
+  const profile = handle.store.getSnapshot().profile!;
+  await handle.store.saveProfile({ ...profile, currentLocationId: id });
+}
+
+describe('a catch-up emptied in a workout saved with nothing logged, the place changed after', () => {
+  it('says nothing of the place it was emptied at', async () => {
+    const handle = await lifter();
+    await moveTo(handle, 'flat');
+    const offer = offerKey(session(handle).constraints);
+    expect(lines(handle)).toContain('No incline push option fits Flat and your limits.');
+    handle.store.startWorkout();
+    for (const entry of allEntries(session(handle).workout.blocks)) {
+      await handle.store.recalibrate({ type: 'skip', entryId: entry.id });
+    }
+    expect(allEntries(session(handle).workout.blocks)).toEqual([]);
+    await handle.store.finishWorkout(null);
+    await moveTo(handle, 'gym');
+    expect(session(handle).status).toBe('completed');
+    handle.store.dismissCompletion();
+    expect(offerKey(session(handle).constraints)).toBe(offer);
+    // On e779122: "Built for Flat from the equipment saved there, ..." and "No incline push option
+    // fits Flat and your limits.", and the plan's place Flat.
+    expect(lines(handle).filter((line) => line.includes('Flat'))).toEqual([]);
+    expect(session(handle).workout.locationId).toBe('gym');
+    // The plan kept empty, as the twenty-first pass's rule says (on 333f1d4, built whole).
+    expect(allEntries(session(handle).workout.blocks)).toEqual([]);
+    expect(dayNoteOf(session(handle))?.text).toBe(
+      'Not one of your training days: nothing more for today.',
+    );
+  });
+});
diff --git a/src/review-m31u/inTrainingNothingLogged.store.test.ts b/src/review-m31u/inTrainingNothingLogged.store.test.ts
new file mode 100644
index 0000000..383456e
--- /dev/null
+++ b/src/review-m31u/inTrainingNothingLogged.store.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import type { WorkoutRecord } from '../core/validation/workoutRecord';
+import { catchUpKind } from '../engine/planning/catchUp';
+import { dayNoteOf } from '../features/today/dayNote';
+import { describeWorkout } from '../test/clockDays';
+import { record } from '../test/records';
+import { TEST_NOW, createTestStore } from '../test/testStore';
+
+/**
+ * Twenty-second review of round M, on the twenty-first pass's rule for a workout saved with nothing
+ * logged ("A workout saved with nothing logged is no workout of the day, as one discarded is not"),
+ * where it meets the round's own check of who is offered a catch-up (`catchUpKind`).
+ *
+ * The rules: item 12, "Who is offered one: a lifter in training, with a workout in the last two
+ * weeks. A new lifter, or one back after a break, has no week to catch up yet and gets the full
+ * session on any day (product judgement)"; item 32 and the first pass, "a workout begun by mistake
+ * and ended with nothing logged is no first workout" (`trainedIn`: "a set of it done past the
+ * warm-ups"), which the second workout, what is left of today's dose and the twenty-first pass's
+ * carry all read.
+ *
+ * What happens: the check for a lifter in training counts any record started in the last fourteen
+ * days (`recent`), a workout saved with nothing logged among them, where every other reading of the
+ * round asks for a set done (`trainedIn`). So a lifter back after a three-week break, given the full
+ * session on a day not ticked, who starts a workout and saves it with nothing logged (begun by
+ * mistake, or ended at once), is offered a catch-up for eleven muscles the next moment: "Not one of
+ * your training days: a 46-minute catch-up for what is behind this week."
+ *
+ * Steps (synthetic data only): a bench press twenty days ago, the only workout in the log; on
+ * Wednesday, a day the schedule does not tick, at the gym: the full session, no catch-up offered.
+ * The lifter starts it, finishes with nothing logged and puts the completion away: a catch-up.
+ * In the engine, `catchUpKind` gives "catch-up" for the same log with an empty record today.
+ *
+ * Also fails on 333f1d4 (from the round's build).
+ */
+
+const DAY = 86_400_000;
+const daysBefore = (days: number) => new Date(Date.parse(TEST_NOW) - days * DAY).toISOString();
+const sets3: [number, number, number][] = [
+  [10, 100, 2],
+  [10, 100, 2],
+  [10, 100, 2],
+];
+const longAgo: WorkoutRecord = {
+  ...record(0, 'barbell-bench-press', sets3, [8, 12], 2),
+  id: 'w-bench-long-ago',
+  startedAt: daysBefore(20),
+  completedAt: daysBefore(20),
+};
+
+describe('a lifter back after a break, and a workout saved with nothing logged', () => {
+  it('is still offered the full session, not a catch-up', async () => {
+    const handle = createTestStore();
+    await handle.store.hydrate();
+    await handle.store.completeOnboarding(
+      { ...createDefaultProfile(TEST_NOW), bodyweight: 185 },
+      createDefaultLocations({ gymAccess: true }, TEST_NOW),
+    );
+    const db = await handle.store.getDatabase();
+    await db.put('workouts', longAgo);
+    await handle.store.hydrate();
+    const session = () => handle.store.getSnapshot().session!;
+    // Not in training: the full session, and nothing to choose.
+    expect(session().constraints.catchUp).toBeUndefined();
+    expect(dayNoteOf(session(), false)?.text).toBe('Not one of your training days.');
+    handle.store.startWorkout();
+    await handle.store.finishWorkout(null);
+    handle.store.dismissCompletion();
+    expect(handle.store.getSnapshot().history).toHaveLength(2);
+    // On e779122 and 333f1d4: "Not one of your training days: a 46-minute catch-up for what is
+    // behind this week.", a catch-up of the bench press, the row, the shrug ...
+    expect(
+      session().constraints.catchUp ?? null,
+      `${dayNoteOf(session(), false)?.text} ${describeWorkout(session().workout).join('; ')}`,
+    ).toBeNull();
+  });
+
+  it('in the engine: an empty record today makes no lifter in training', () => {
+    const profile = createDefaultProfile(TEST_NOW);
+    const empty: WorkoutRecord = {
+      ...longAgo,
+      id: 'w-empty-today',
+      startedAt: daysBefore(0.1),
+      completedAt: daysBefore(0.05),
+      entries: [],
+    };
+    expect(catchUpKind(profile, [longAgo], TEST_NOW)).toBeNull();
+    // On e779122 and 333f1d4: "catch-up".
+    expect(catchUpKind(profile, [longAgo, empty], TEST_NOW)).toBeNull();
+  });
+});
diff --git a/src/review-m31u/keptSwapStoppedUnderWay.store.test.ts b/src/review-m31u/keptSwapStoppedUnderWay.store.test.ts
new file mode 100644
index 0000000..36304a7
--- /dev/null
+++ b/src/review-m31u/keptSwapStoppedUnderWay.store.test.ts
@@ -0,0 +1,141 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import { allEntries } from '../engine/workout/types';
+import { describeWorkout } from '../test/clockDays';
+import { record } from '../test/records';
+import { TEST_NOW, createTestStore } from '../test/testStore';
+
+/**
+ * Twenty-second review of round M, on the twenty-first pass's carry of the day's list of lifts
+ * swapped away (`swappedAway`) into every later plan the same day (`ensureSession`'s `away`), and
+ * its carry of a workout saved with nothing logged (`dismissCompletion`), where they meet the
+ * twentieth pass's kept swap stopped the same day (`stopLastingSwap`).
+ *
+ * The rules: the twentieth pass, "a swap kept for weeks and stopped the same day brings back the
+ * lift it stood in for, off the day's list, as a swap back does (... stopping the swap is the lifter
+ * putting the plan's own pick back)"; the twenty-first, "Every later plan the same day keeps the
+ * day's list of lifts swapped away, and a lift put back comes off the list before the plan is made
+ * again".
+ *
+ * What happens: the lift put back comes off the list only in the preview made again
+ * (`rebuildPreview(putBack)`), which does nothing to a workout under way or finished
+ * (`status !== 'preview'`). A kept swap stopped while the workout runs, or on the completion screen,
+ * leaves its lift on the session's list; once the workout is discarded, or saved with nothing logged
+ * and the completion put away, `ensureSession` carries the whole list into the next plan: the lift
+ * the lifter put back stays away for the rest of the day (its slot takes another pick, here the
+ * dumbbell curl), and the list still names it. Stopped on a plan not yet started, the same lift comes
+ * back (the twentieth pass's own test).
+ *
+ * Steps (synthetic data only): Monday's bench press in the log; on Wednesday, a day the schedule
+ * does not tick, at the gym, the catch-up has the EZ-bar curl. The lifter swaps it for the cable
+ * curl, kept for four weeks (the list holds the EZ-bar curl), and starts the workout.
+ * - The lifter stops the kept swap (Plan tab), then discards the workout.
+ * - Or stops it, then finishes the workout with nothing logged and puts the completion away.
+ * - Or finishes the workout with nothing logged, stops the swap on the completion screen, and puts
+ *   the completion away.
+ * Each time the next plan has no EZ-bar curl and the list holds it.
+ *
+ * All three pass on 333f1d4, where no later plan kept the day's list at all (the twenty-first
+ * pass's finding): a regression of the twenty-first pass.
+ */
+
+const DAY = 86_400_000;
+const daysBefore = (days: number) => new Date(Date.parse(TEST_NOW) - days * DAY).toISOString();
+
+async function lifter() {
+  const handle = createTestStore();
+  await handle.store.hydrate();
+  await handle.store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185 },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await handle.store.getDatabase();
+  const when = daysBefore(2);
+  await db.put('workouts', {
+    ...record(
+      0,
+      'barbell-bench-press',
+      [
+        [10, 100, 2],
+        [10, 100, 2],
+        [10, 100, 2],
+      ],
+      [8, 12],
+      2,
+    ),
+    id: 'w-bench-monday',
+    startedAt: when,
+    completedAt: when,
+  });
+  await handle.store.hydrate();
+  return handle;
+}
+
+type Handle = Awaited<ReturnType<typeof lifter>>;
+const session = (handle: Handle) => handle.store.getSnapshot().session!;
+const ids = (handle: Handle) =>
+  allEntries(session(handle).workout.blocks).map((entry) => entry.exerciseId);
+const lifts = (handle: Handle) => describeWorkout(session(handle).workout).join('; ');
+
+/** The catch-up's EZ-bar curl swapped for the cable curl, kept for four weeks, and started. */
+async function keptAndStarted(handle: Handle) {
+  expect(session(handle).workout.templateId).toBe('catch-up');
+  const curl = allEntries(session(handle).workout.blocks).find(
+    (entry) => entry.exerciseId === 'ez-bar-curl',
+  );
+  expect(curl).toBeDefined();
+  expect((await handle.store.swapExercise(curl!.id, 'cable-curl', true))?.ok).toBe(true);
+  expect(session(handle).constraints.swappedAway).toEqual(['ez-bar-curl']);
+  expect(handle.store.getSnapshot().lastingSwaps.map((swap) => swap.from)).toEqual([
+    'ez-bar-curl',
+  ]);
+  handle.store.startWorkout();
+  expect(session(handle).status).toBe('active');
+}
+
+function expectPutBack(handle: Handle) {
+  expect(session(handle).status).toBe('preview');
+  expect(handle.store.getSnapshot().lastingSwaps).toEqual([]);
+  // On e779122: "... dumbbell-curl x3 @RIR 1/1/1 ...", and the list still ["ez-bar-curl"].
+  expect(ids(handle), lifts(handle)).toContain('ez-bar-curl');
+  expect(session(handle).constraints.swappedAway ?? []).toEqual([]);
+}
+
+describe('a kept swap stopped while the workout is under way or finished', () => {
+  it('brings its lift back once the workout is discarded', async () => {
+    const handle = await lifter();
+    await keptAndStarted(handle);
+    await handle.store.stopLastingSwap('ez-bar-curl');
+    handle.store.discardWorkout();
+    expectPutBack(handle);
+  });
+
+  it('brings its lift back after the workout is saved with nothing logged', async () => {
+    const handle = await lifter();
+    await keptAndStarted(handle);
+    await handle.store.stopLastingSwap('ez-bar-curl');
+    await handle.store.finishWorkout(null);
+    handle.store.dismissCompletion();
+    expectPutBack(handle);
+  });
+
+  it('brings its lift back when stopped on the completion screen', async () => {
+    const handle = await lifter();
+    await keptAndStarted(handle);
+    await handle.store.finishWorkout(null);
+    await handle.store.stopLastingSwap('ez-bar-curl');
+    handle.store.dismissCompletion();
+    expectPutBack(handle);
+  });
+
+  it('as it comes back when stopped on a plan not yet started', async () => {
+    const handle = await lifter();
+    const curl = allEntries(session(handle).workout.blocks).find(
+      (entry) => entry.exerciseId === 'ez-bar-curl',
+    );
+    expect((await handle.store.swapExercise(curl!.id, 'cable-curl', true))?.ok).toBe(true);
+    await handle.store.stopLastingSwap('ez-bar-curl');
+    expectPutBack(handle);
+  });
+});
diff --git a/src/review-m31u/painCardSoreJointToday.test.ts b/src/review-m31u/painCardSoreJointToday.test.ts
new file mode 100644
index 0000000..f3b2a1b
--- /dev/null
+++ b/src/review-m31u/painCardSoreJointToday.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations, type LocationProfile } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import type { WorkoutRecord } from '../core/validation/workoutRecord';
+import type { Joint } from '../catalog/exercises/exerciseSchema';
+import { gatherSignals, type CoachInput } from '../engine/coach/coachConductor';
+import { emptyCompleted, emptyConstraints, recalibrate } from '../engine/recalibration/recalibrate';
+import type { SessionConstraints } from '../engine/recalibration/types';
+import { interpretFatigue } from '../engine/recovery/fatigue';
+import { analyzeStrategy } from '../engine/strategy/strategy';
+import { generateWorkout } from '../engine/workoutGenerator/generate';
+import { describeWorkout } from '../test/clockDays';
+import { record } from '../test/records';
+
+/**
+ * Twenty-second review of round M, on the twentieth and twenty-first passes' fixes to the pain
+ * pattern's card (item 45, `painPatternSignal`): "The pain card's alternative reads the day's list
+ * and today's plan, as every other offer does" (the twentieth), and "The coach offers no four-week
+ * swap the day turns down: the card reads the same refusal as the swap and its sheet" (the
+ * twenty-first), both so that its tap is never refused.
+ *
+ * The card's alternative is checked against the place and the day's list
+ * (`sessionConflictContext` with `excludeExerciseIds` only), not against the joints the lifter
+ * flagged today (`constraints.painJoints`, from "Hurts" or the check-in). The swap its tap makes
+ * reads them (`contextFor`: a lift with high stress on a joint flagged today is blocked), and so does
+ * the coach's other four-week swap, the variety offer ("the alternative fits today as every offer
+ * reads it: the place, the lifter's limits, what they avoid today and the joints protected today",
+ * `jointsToProtect`), and the coverage card's accessory. So on a day the lifter flagged a joint, the
+ * safety card offers a lift with high stress on it, and the tap is refused, the class the twentieth
+ * and twenty-first passes fixed.
+ *
+ * Steps (synthetic data only): wrist pain logged with the close-grip bench press on two push days a
+ * week apart, and the dip done in its place (swapped in for it) on two push days since, with no
+ * report. The close-grip bench press a favourite, so today's plan (Thursday, a day of the plan, at
+ * the gym) has it. The coach: "Wrist pain with Close-Grip Bench Press, not with Dip", "Use Dip for 4
+ * weeks", and the tap takes it. With the shoulder flagged today (the check-in's sore shoulder, the
+ * plan built with it), the same card, and the tap is refused: "Dip puts high stress on the shoulder
+ * you flagged."
+ *
+ * Also fails on 333f1d4 (from item 45; the twentieth and twenty-first passes' fixes left it).
+ */
+
+const NOW = '2026-09-10T12:00:00.000Z';
+const profile = {
+  ...createDefaultProfile(NOW),
+  exercisePreferences: { preferred: ['Close-Grip Bench Press'], disliked: [] },
+};
+const [, gym] = createDefaultLocations({ gymAccess: true }, NOW) as [
+  LocationProfile,
+  LocationProfile,
+];
+const sets3 = (reps: number, weight: number): [number, number, number][] => [
+  [reps, weight, 2],
+  [reps, weight, 2],
+  [reps, weight, 2],
+];
+const pressHurt = (days: number): WorkoutRecord => ({
+  ...record(days, 'close-grip-bench-press', sets3(8, 135)),
+  templateId: 'push-arms',
+  painJoints: ['wrist'],
+  painReports: [{ exerciseId: 'close-grip-bench-press', joint: 'wrist' }],
+});
+const dipForPress = (days: number): WorkoutRecord => {
+  const base = record(days, 'dip', sets3(10, 0), [8, 12]);
+  return {
+    ...base,
+    templateId: 'push-arms',
+    painReports: [],
+    entries: base.entries.map((entry) => ({ ...entry, replacedFrom: 'close-grip-bench-press' })),
+  };
+};
+const history = [pressHurt(20), dipForPress(16), pressHurt(13), dipForPress(9)];
+
+/** Today's plan with the joints flagged today, and each four-week swap offered with its tap. */
+function day(painJoints: Joint[]) {
+  const workout = generateWorkout({
+    profile,
+    location: gym,
+    history,
+    now: NOW,
+    duration: 'default',
+    constraints: { painJoints },
+  });
+  const constraints: SessionConstraints = { ...emptyConstraints(), painJoints };
+  const fatigue = interpretFatigue(history, NOW, null);
+  const input: CoachInput = {
+    workout,
+    status: 'preview',
+    duration: 'default',
+    completed: emptyCompleted(),
+    constraints,
+    profile,
+    history,
+    now: NOW,
+    fatigue,
+    strategy: analyzeStrategy({ history, profile, now: NOW, fatigue }),
+    lastExportAt: NOW,
+    workoutCount: history.length,
+    location: gym,
+  };
+  const taps = gatherSignals(input).flatMap((signal) => {
+    const action = signal.action;
+    if (action?.kind !== 'lasting-swap') return [];
+    const result = recalibrate({
+      trigger: { type: 'replace', entryId: action.entryId, exerciseId: action.exerciseId },
+      workout,
+      completed: emptyCompleted(),
+      lockedEntryIds: [],
+      currentEntryId: null,
+      duration: 'default',
+      profile,
+      location: gym,
+      loading: { missingPlates: [] },
+      history,
+      constraints,
+      reason: 'test',
+      timestamp: NOW,
+    });
+    return [{ offer: `${signal.headline}: ${action.label}`, tap: result.ok ? 'made' : result.error }];
+  });
+  return { plan: describeWorkout(workout).join('; '), taps };
+}
+
+describe('the pain pattern’s card on a day a joint is flagged', () => {
+  it('offers no four-week swap the joint flagged today rules out', () => {
+    const today = day(['shoulder']);
+    expect(today.plan).toContain('close-grip-bench-press');
+    // On e779122 and 333f1d4: "Wrist pain with Close-Grip Bench Press, not with Dip: Use Dip for 4
+    // weeks", refused: "Dip puts high stress on the shoulder you flagged."
+    for (const { offer, tap } of today.taps) expect(tap, offer).toBe('made');
+  });
+
+  it('with no joint flagged, the card’s tap is taken', () => {
+    const today = day([]);
+    expect(today.taps).toEqual([
+      {
+        offer: 'Wrist pain with Close-Grip Bench Press, not with Dip: Use Dip for 4 weeks',
+        tap: 'made',
+      },
+    ]);
+  });
+});
diff --git a/src/review-m31u/probe5.test.ts b/src/review-m31u/probe5.test.ts
