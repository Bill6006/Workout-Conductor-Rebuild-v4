+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import { allEntries } from '../engine/workout/types';
+import { dayNoteOf } from '../features/today/dayNote';
+import { describeWorkout } from '../test/clockDays';
+import { record } from '../test/records';
+import { TEST_NOW, createTestStore } from '../test/testStore';
+import { writeFileSync } from 'node:fs';
+
+const OUT = '/tmp/claude-0/-home-user-Workout-Conductor-Rebuild-v4/d764b246-bf46-58bd-837c-82de48e393cc/scratchpad/m31u-review/out';
+const DAY = 86_400_000;
+const daysBefore = (days: number) => new Date(Date.parse(TEST_NOW) - days * DAY).toISOString();
+
+async function lifter() {
+  const handle = createTestStore();
+  await handle.store.hydrate();
+  await handle.store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185 },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await handle.store.getDatabase();
+  const when = daysBefore(2);
+  await db.put('workouts', {
+    ...record(0, 'barbell-bench-press', [[10, 100, 2], [10, 100, 2], [10, 100, 2]], [8, 12], 2),
+    id: 'w-bench-monday',
+    startedAt: when,
+    completedAt: when,
+  });
+  await handle.store.hydrate();
+  return handle;
+}
+
+describe('probe5', () => {
+  it('saved workout loaded after emptying the catch-up, then discarded', async () => {
+    const handle = await lifter();
+    const session = () => handle.store.getSnapshot().session!;
+    const log: string[] = [];
+    await handle.store.setFullSession(true);
+    const saved = await handle.store.saveCurrentWorkout('Push day');
+    await handle.store.setFullSession(false);
+    for (const entry of allEntries(session().workout.blocks)) {
+      await handle.store.recalibrate({ type: 'skip', entryId: entry.id });
+    }
+    log.push(`emptied: ${JSON.stringify(session().constraints.emptied)} ${dayNoteOf(session(), false)?.text}`);
+    handle.store.loadSavedWorkout(saved.id);
+    log.push(`loaded: ${describeWorkout(session().workout).join('; ')} catchUp=${JSON.stringify(session().constraints.catchUp?.kind)} note=${dayNoteOf(session(), false)?.text}`);
+    handle.store.startWorkout();
+    handle.store.discardWorkout();
+    log.push(`after discard: ${describeWorkout(session().workout).join('; ')} note=${dayNoteOf(session(), false)?.text} emptied=${JSON.stringify(session().constraints.emptied)}`);
+    writeFileSync(`${OUT}/probe5.txt`, log.join('\n'));
+    expect(allEntries(session().workout.blocks)).toEqual([]);
+  });
+});
