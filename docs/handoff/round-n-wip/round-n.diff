@@ -0,0 +1,79 @@
+import { describe, expect, it } from 'vitest';
+import type { WorkoutSession } from './session';
+import { buildCompletion, buildWorkoutRecord } from './workoutRecordBuilder';
+import { emptyCompleted, emptyConstraints } from '../../engine/recalibration/recalibrate';
+import { allEntries, type GeneratedWorkout } from '../../engine/workout/types';
+import { generateWorkout } from '../../engine/workoutGenerator/generate';
+import { RECORD_NOW } from '../../test/records';
+import { BENCH, gym, profileOf, trained } from '../../test/backOffs';
+
+/**
+ * Maintenance 32, the owner's item 11, in the completion (the third review of round N): "Next time"
+ * reads the lift to push as the next plan does, on its own straight sets, never as a top set.
+ * Synthetic data only.
+ */
+
+const pushLift = { exerciseId: BENCH, target: 225, units: 'lb' as const, since: RECORD_NOW };
+const profile = profileOf('hybrid', { pushLift });
+
+const at = (daysAfter: number) =>
+  new Date(Date.parse(RECORD_NOW) + daysAfter * 86_400_000).toISOString();
+
+function planAt(now: string, history = trained()): GeneratedWorkout {
+  return generateWorkout({
+    profile,
+    location: gym,
+    history,
+    now,
+    duration: 'default',
+    constraints: { templateId: 'push-arms' },
+  });
+}
+
+describe('the completion’s "Next time" for the lift to push, the third review of round N', () => {
+  it('reads the next target as the next plan does', () => {
+    const workout = planAt(RECORD_NOW);
+    const pushed = allEntries(workout.blocks).find((entry) => entry.exerciseId === BENCH)!;
+    expect(pushed.push).toBe('natural');
+    // Straight sets: the push shapes every set of it.
+    expect(pushed.sets.every((set) => set.tier === undefined)).toBe(true);
+    const working = pushed.sets.filter((set) => set.kind === 'working');
+    const load = working[0]!.targetWeight!;
+    // Every set lifted at the load asked, the reps in range, one in reserve (the push asks 2).
+    const session = {
+      workout,
+      constraints: emptyConstraints(),
+      completed: {
+        ...emptyCompleted(),
+        startedAt: RECORD_NOW,
+        sets: working.map((set) => ({
+          entryId: pushed.id,
+          exerciseId: BENCH,
+          setIndex: set.index,
+          kind: 'working',
+          reps: 5,
+          weight: load,
+          rir: 1,
+          completedAt: RECORD_NOW,
+        })),
+      },
+    } as unknown as WorkoutSession;
+    const record = buildWorkoutRecord(session, {
+      now: RECORD_NOW,
+      elapsedSeconds: 1800,
+      rating: null,
+      endedEarly: false,
+    });
+    const summary = buildCompletion(session, record, profile, trained());
+    const line = summary.nextTargets.find((text) => text.startsWith('Barbell Bench Press'))!;
+    expect(line).toBeDefined();
+    // The next plan with the bench press in it, as the push has it: straight, its own target.
+    const next = [3, 4, 5, 6, 7]
+      .map((days) => planAt(at(days), [...trained(), record]))
+      .map((plan) => allEntries(plan.blocks).find((entry) => entry.exerciseId === BENCH))
+      .find((entry) => entry !== undefined && entry.push !== undefined);
+    expect(next).toBeDefined();
+    const nextLoad = next!.sets.find((set) => set.kind === 'working')!.targetWeight;
+    expect(line).toContain(`${nextLoad} lb`);
+  });
+});
diff --git a/src/core/state/backOffs.replayLog.store.test.ts b/src/core/state/backOffs.replayLog.store.test.ts
new file mode 100644
index 0000000..bcc489a
--- /dev/null
+++ b/src/core/state/backOffs.replayLog.store.test.ts
@@ -0,0 +1,167 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../validation/location';
+import { createDefaultProfile, type UserProfile } from '../validation/profile';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * The eighth review of round N. The back-offs' replays read each logged back-off's step against the
+ * log as it was before the change that called for them: a top set corrected after a back-off was
+ * logged, a back-off's log deleted before one logged after it.
+ *
+ * The spec: "A correction to the top set moves its back-offs as the set logged right would have"
+ * (docs/reports/maintenance-32.md), each back-off still logged moving the ones after it as its log
+ * did (the sixth review). A back-off's step can read the top set: a back-off at the top of its
+ * range after a top set at the top of its range is "two over" (`autoregulate`), a step up.
+ *
+ * What happens on abb5566: `logSet`'s top-set correction builds the back-offs' logs with
+ * `backOffLogOf(session, …)` on the session from before the correction, so each back-off's plan
+ * (`planAfter`) reads the top set's old log; `deleteLoggedSet` (and `undoLastSet`) pass the session
+ * from before the delete to `backOffsAsPlanned`, so a back-off still logged reads the deleted one as
+ * the set before it.
+ *
+ * Steps: the main lift's top set logged at 140 × 6 at 1 in reserve (asked 4-6 at 1), back-offs
+ * 135; back-off 1 logged 135 × 6 at 2: two sets at the top of the range, back-offs 2 and 3 go to
+ * 140. The top set's reps corrected to 5, what was lifted. Logged so from the start, back-off 1
+ * moves nothing (the top set is not at the top of its range) and back-offs 2 and 3 stay at 135; after
+ * the correction they stay at 140, a step over. The other way round (top set 5 corrected to 6) they
+ * stay at 135 where the set logged right puts them at 140. A back-off corrected (the seventh
+ * review's replay, from the session as corrected) reads it right, so the result hangs on which set
+ * was fixed last. And: the top set 140 × 5 at 1, back-off 1 135 × 6 at 2 (nothing moves), back-off
+ * 2 135 × 6 at 2 (two at the top of the range: back-off 3 to 140); back-off 1's log deleted (a set
+ * logged on the wrong lift): back-off 2 now follows the top set, not at the top of its range, and
+ * back-off 3 belongs at 135; it stays at 140.
+ *
+ * Also fails on 5dc61a7 and e6ed7ed. Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: { ...schedule, availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'], weeklyFrequency: 5 },
+  programStyle: 'hybrid',
+};
+
+async function startedMain() {
+  const handle = createTestStore({ now: () => TEST_NOW });
+  const { store } = handle;
+  await store.hydrate();
+  await store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await store.getDatabase();
+  for (const daysAgo of [7, 3]) {
+    for (const exerciseId of ['barbell-bench-press', 'back-squat', 'barbell-row']) {
+      const when = new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+      await db.put('workouts', {
+        ...record(0, exerciseId, [
+          [5, 135, 2],
+          [5, 135, 2],
+          [5, 135, 2],
+        ]),
+        id: `w-${exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await store.hydrate();
+  const workout = () => store.getSnapshot().session!.workout;
+  const main = (): WorkoutEntry =>
+    allEntries(workout().blocks).find((entry) => entry.backOffDrop !== undefined)!;
+  expect(main()).toBeDefined();
+  const top = main().sets.find((set) => set.tier === 'top')!;
+  const [first] = main().sets.filter((set) => set.tier === 'back-off');
+  const planned = main()
+    .sets.filter((set) => set.tier === 'back-off')
+    .map((set) => set.targetWeight);
+  store.startWorkout();
+  const backOffs = () =>
+    main()
+      .sets.filter((set) => set.tier === 'back-off')
+      .map((set) => set.targetWeight);
+  return { store, main, top, first: first!, planned, backOffs };
+}
+
+describe('a top set’s reps corrected after back-off 1 was logged', () => {
+  it('6 corrected to 5: the back-offs after it where the set logged right puts them', async () => {
+    const right = await startedMain();
+    await right.store.logSet(right.main().id, right.top.index, {
+      weight: right.top.targetWeight,
+      reps: 5,
+      rir: 1,
+    });
+    await right.store.logSet(right.main().id, right.first.index, {
+      weight: right.planned[0]!,
+      reps: 6,
+      rir: 2,
+    });
+    // Logged right from the start: nothing moves.
+    expect(right.backOffs()).toEqual(right.planned);
+
+    const { store, main, top, first, planned, backOffs } = await startedMain();
+    expect(top.targetReps).toEqual([4, 6]);
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 6, rir: 1 });
+    await store.logSet(main().id, first.index, { weight: planned[0]!, reps: 6, rir: 2 });
+    // Two sets at the top of the range: a step up for back-offs 2 and 3.
+    expect(backOffs()[1]!).toBeGreaterThan(planned[1]!);
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 5, rir: 1 });
+    // On abb5566: back-offs 2 and 3 stay a step up.
+    expect(backOffs()).toEqual(right.backOffs());
+  });
+
+  it('5 corrected to 6: the step the set logged right gives', async () => {
+    const right = await startedMain();
+    await right.store.logSet(right.main().id, right.top.index, {
+      weight: right.top.targetWeight,
+      reps: 6,
+      rir: 1,
+    });
+    await right.store.logSet(right.main().id, right.first.index, {
+      weight: right.planned[0]!,
+      reps: 6,
+      rir: 2,
+    });
+    expect(right.backOffs()[1]!).toBeGreaterThan(right.planned[1]!);
+
+    const { store, main, top, first, planned, backOffs } = await startedMain();
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 5, rir: 1 });
+    await store.logSet(main().id, first.index, { weight: planned[0]!, reps: 6, rir: 2 });
+    expect(backOffs()).toEqual(planned);
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 6, rir: 1 });
+    // On abb5566: back-offs 2 and 3 stay at the plan's load.
+    expect(backOffs()).toEqual(right.backOffs());
+  });
+});
+
+describe('a back-off’s log deleted before a back-off logged after it', () => {
+  it('the ones still to come where the logs left standing put them', async () => {
+    const right = await startedMain();
+    const [, second] = right.main().sets.filter((set) => set.tier === 'back-off');
+    await right.store.logSet(right.main().id, right.top.index, {
+      weight: right.top.targetWeight,
+      reps: 5,
+      rir: 1,
+    });
+    await right.store.logSet(right.main().id, second!.index, {
+      weight: right.planned[1]!,
+      reps: 6,
+      rir: 2,
+    });
+    // The top set and back-off 2 alone: nothing moves.
+    expect(right.backOffs()).toEqual(right.planned);
+
+    const { store, main, top, first, planned, backOffs } = await startedMain();
+    const [, two] = main().sets.filter((set) => set.tier === 'back-off');
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 5, rir: 1 });
+    await store.logSet(main().id, first.index, { weight: planned[0]!, reps: 6, rir: 2 });
+    await store.logSet(main().id, two!.index, { weight: planned[1]!, reps: 6, rir: 2 });
+    // Back-offs 1 and 2 at the top of the range: back-off 3 a step up.
+    expect(backOffs()[2]!).toBeGreaterThan(planned[2]!);
+    store.deleteLoggedSet(main().id, first.index);
+    // On abb5566: back-off 3 stays a step up.
+    expect(backOffs()).toEqual(right.backOffs());
+  });
+});
diff --git a/src/core/state/backOffs.savedCopy.store.test.ts b/src/core/state/backOffs.savedCopy.store.test.ts
new file mode 100644
index 0000000..c8ec401
--- /dev/null
+++ b/src/core/state/backOffs.savedCopy.store.test.ts
@@ -0,0 +1,127 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../../core/validation/location';
+import { createDefaultProfile, type UserProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { backOffDropFor } from '../../engine/progression/backOffs';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * Maintenance 32, the owner's item 11, and saved workouts (the first review of round N): a saved
+ * copy loaded after the lift's own sessions moved its drop takes the drop in force, so a session of
+ * an old copy never throws away what the sessions taught. TEST_NOW is a Wednesday, a day the
+ * schedule ticks. Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: {
+    ...schedule,
+    availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'],
+    weeklyFrequency: 5,
+  },
+  programStyle: 'hybrid',
+};
+const LIFTS = ['barbell-bench-press', 'back-squat', 'barbell-row'];
+const at = (daysAgo: number) => new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+
+/** A session of a lift on the structure, `daysAgo`, at a drop, its back-offs on target. */
+function structured(exerciseId: string, daysAgo: number, drop: number): WorkoutRecord {
+  const done = record(
+    0,
+    exerciseId,
+    [
+      [5, 140, 1],
+      [5, 120, 2],
+      [5, 120, 2],
+      [5, 120, 2],
+    ],
+    [4, 6],
+    2,
+    { id: `w-${exerciseId}-s${daysAgo}`, startedAt: at(daysAgo), completedAt: at(daysAgo) },
+  );
+  const entry = done.entries[0]!;
+  entry.backOffDrop = drop;
+  entry.sets.forEach((set, index) => {
+    set.tier = index === 0 ? 'top' : 'back-off';
+    set.targetRir = index === 0 ? 1 : 2;
+  });
+  return done;
+}
+
+describe('a saved copy loaded after the drop moved, the first review of round N', () => {
+  it('never throws away the drop the lift’s own sessions taught', async () => {
+    const handle = createTestStore({ now: () => TEST_NOW });
+    const { store } = handle;
+    await store.hydrate();
+    await store.completeOnboarding(
+      { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+      createDefaultLocations({ gymAccess: true }, TEST_NOW),
+    );
+    const db = await store.getDatabase();
+    for (const daysAgo of [12, 9]) {
+      for (const exerciseId of LIFTS) {
+        await db.put('workouts', {
+          ...record(
+            0,
+            exerciseId,
+            [
+              [5, 135, 2],
+              [5, 135, 2],
+              [5, 135, 2],
+            ],
+            [4, 6],
+            2,
+          ),
+          id: `w-${exerciseId}-${daysAgo}`,
+          startedAt: at(daysAgo),
+          completedAt: at(daysAgo),
+        });
+      }
+    }
+    await store.hydrate();
+    const main = (): WorkoutEntry =>
+      allEntries(store.getSnapshot().session!.workout.blocks).find(
+        (entry) => entry.backOffDrop !== undefined,
+      )!;
+    expect(main().backOffDrop).toBe(0.05);
+    // Saved now, at the 5% the lift starts from.
+    const saved = await store.saveCurrentWorkout('Main day');
+
+    // Since then, two sessions of each lift at 13%, the back-offs on target: 13% is the drop now.
+    for (const daysAgo of [6, 3]) {
+      for (const exerciseId of LIFTS)
+        await db.put('workouts', structured(exerciseId, daysAgo, 0.13));
+    }
+    await store.hydrate();
+    expect(main().backOffDrop).toBe(0.13);
+
+    // The old copy, loaded and lifted: the top set as planned, the back-offs ground out.
+    store.loadSavedWorkout(saved.id);
+    store.startWorkout();
+    // Before: 0.05, the copy's own drop. Its back-offs drop the 13% in force off its top set.
+    expect(main().backOffDrop).toBe(0.13);
+    const top = main().sets.find((set) => set.tier === 'top')!;
+    for (const set of main().sets.filter((candidate) => candidate.tier === 'back-off')) {
+      expect(set.targetWeight).toBeLessThanOrEqual(top.targetWeight! * 0.87);
+      expect(set.targetWeight).toBeGreaterThan(top.targetWeight! * 0.8);
+    }
+    // The copy's main lift, whose own sessions moved its drop to 13%.
+    const exerciseId = main().exerciseId;
+    expect(backOffDropFor(exerciseId, store.getSnapshot().history)).toBe(0.13);
+    for (const set of main().sets.filter((candidate) => candidate.kind === 'working')) {
+      const top = set.tier === 'top';
+      await store.logSet(main().id, set.index, {
+        weight: set.targetWeight,
+        reps: top ? 5 : 4,
+        rir: top ? 1 : 0,
+      });
+    }
+    await store.finishWorkout(null);
+    store.dismissCompletion();
+    // Back-offs too hard at 5% once more: the next plan must not go back to 5%.
+    expect(backOffDropFor(exerciseId, store.getSnapshot().history)).toBeGreaterThanOrEqual(0.13);
+  });
+});
diff --git a/src/core/state/backOffs.setAddedAfterStep.store.test.ts b/src/core/state/backOffs.setAddedAfterStep.store.test.ts
new file mode 100644
index 0000000..63d5431
--- /dev/null
+++ b/src/core/state/backOffs.setAddedAfterStep.store.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../validation/location';
+import { createDefaultProfile, type UserProfile } from '../validation/profile';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * The eleventh review of round N. A set added after the last back-off was logged with a step (a
+ * grind, or one clearly easy) copies that back-off's target (the `sets` trigger: "a set added is a
+ * back-off", at `last.targetWeight`), with no step. Every replay of the same logs gives it the step:
+ * the store's replay reads each logged back-off's plan with at least one set after it
+ * (`backOffLogOf`: `Math.max(1, after)`) and moves the ones after it, and so does the pick-up
+ * (`owedBackOffLoad`). So the added set's load moves with no new log: an undo or a delete of its own
+ * log, a correction of an earlier back-off, or the lifter going home and back puts it a step down
+ * after the grind (where, by the rules below, it was due when it was added).
+ *
+ * The rules (docs/reports/maintenance-32.md): item 11, "A set added is a back-off"; the back-offs
+ * move "a step up after one clearly easy and down after a grind"; the fourth review, "each back-off
+ * still logged moving the ones after it as its log did"; the seventh, "a lift picked up again
+ * carries on its back-offs at the step each logged back-off gave them".
+ *
+ * Steps: the main lift's top set logged as planned (140 × 5 at 1, back-offs 135); back-offs 1 and 2
+ * as asked (135 × 5 at 2); back-off 3 a grind (135 × 3 at 0), the last. A set added: back-off 4 at
+ * 135. Then (a) back-off 4 logged as asked and undone, or (b) the lifter goes home (no barbell there)
+ * and back to the gym.
+ *
+ * What happens on 905ce7f (and on 480d5a1): back-off 4 is added at 135, the load just ground out,
+ * and comes back at 130 after (a) or (b). Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: { ...schedule, availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'], weeklyFrequency: 5 },
+  programStyle: 'hybrid',
+};
+
+async function afterGrind() {
+  const { store } = createTestStore({ now: () => TEST_NOW });
+  await store.hydrate();
+  await store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await store.getDatabase();
+  for (const daysAgo of [7, 3]) {
+    for (const exerciseId of ['barbell-bench-press', 'back-squat', 'barbell-row']) {
+      const when = new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+      await db.put('workouts', {
+        ...record(0, exerciseId, [
+          [5, 135, 2],
+          [5, 135, 2],
+          [5, 135, 2],
+        ]),
+        id: `w-${exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await store.hydrate();
+  const entries = () => allEntries(store.getSnapshot().session!.workout.blocks);
+  const exerciseId = entries().find((entry) => entry.backOffDrop !== undefined)!.exerciseId;
+  const main = (): WorkoutEntry =>
+    entries().find((entry) => entry.exerciseId === exerciseId && !entry.stopped)!;
+  store.startWorkout();
+  const top = main().sets.find((set) => set.tier === 'top')!;
+  const [first, second, third] = main().sets.filter((set) => set.tier === 'back-off');
+  expect(top.targetWeight).toBe(140);
+  await store.logSet(main().id, top.index, { weight: 140, reps: 5, rir: 1 });
+  await store.logSet(main().id, first!.index, { weight: 135, reps: 5, rir: 2 });
+  await store.logSet(main().id, second!.index, { weight: 135, reps: 5, rir: 2 });
+  // The last back-off a grind: nothing after it to move.
+  await store.logSet(main().id, third!.index, { weight: 135, reps: 3, rir: 0 });
+  await store.recalibrate({ type: 'sets', entryId: main().id, workingDelta: 1 });
+  const toCome = () => {
+    const done = store.getSnapshot().session!.completed.sets;
+    return main()
+      .sets.filter(
+        (set) =>
+          set.tier === 'back-off' &&
+          !done.some((log) => log.entryId === main().id && log.setIndex === set.index),
+      )
+      .map((set) => set.targetWeight);
+  };
+  return { store, main, toCome };
+}
+
+describe('a set added after the last back-off ground out', () => {
+  it('an undo of the added set’s log leaves it where it was added', async () => {
+    const { store, main, toCome } = await afterGrind();
+    const added = toCome();
+    const fourth = main()
+      .sets.filter((set) => set.tier === 'back-off')
+      .at(-1)!;
+    await store.logSet(main().id, fourth.index, { weight: added[0] ?? null, reps: 5, rir: 2 });
+    store.undoLastSet();
+    // On 905ce7f: added at 135, the load just ground out; 130 once its log is undone.
+    expect(toCome()).toEqual(added);
+  });
+
+  it('home and back to the gym, the set added keeps its load', async () => {
+    const { store, toCome } = await afterGrind();
+    const added = toCome();
+    await store.setCurrentLocation('home');
+    await store.setCurrentLocation('gym');
+    // On 905ce7f: [135] when added, [130] back at the gym.
+    expect(toCome()).toEqual(added);
+  });
+});
diff --git a/src/core/state/backOffs.skippedTopPickUpCap.store.test.ts b/src/core/state/backOffs.skippedTopPickUpCap.store.test.ts
