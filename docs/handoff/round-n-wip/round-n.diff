+import { describe, expect, it } from 'vitest';
+import { createDefaultProfile } from '../../core/validation/profile';
+import { record } from '../../test/records';
+import { BENCH, profileOf } from '../../test/backOffs';
+import { simulate } from '../../test/backOffsSim';
+import { coachingPolicy } from '../coach/experience';
+import { detectStalls } from '../strategy/plateau';
+
+/**
+ * The eighth review of round N. A deload week reads as leaving the structure for a lift that is
+ * the main lift one day and a secondary one another, trained twice in the week.
+ *
+ * The spec (docs/reports/maintenance-32.md): a deload week runs a main lift straight at its
+ * back-offs' load (by judgement), saved as a day at the back-offs' load (`atBackOffs`), and a lift's
+ * top set reads past such days back to its last session of its own; the known limit says only a
+ * lift trained three or more times in one deload week reads its last deload session as its own
+ * after it.
+ *
+ * What happens on abb5566: `pastBackOffDays` counts every session of the lift since its last top
+ * set, the secondary day before the deload week among them, so a lift trained only twice in the
+ * deload week passes `BACK_OFF.STRAIGHT_RUN` (2) and reads its whole history as its own.
+ *
+ * 1. The default profile (Hybrid, four days: push, pull, lower, upper): the row is the main lift on
+ *    the pull day and secondary on the upper day. Its top set goes 160, 165 on the pull days, each
+ *    lifted as asked, the upper day after each at the back-offs' load; the deload week (week 3) runs
+ *    it on the pull and the upper day, straight at the back-offs' load 10% lighter (145). The first
+ *    pull day after it asks a top set of 150 ("Last: 145 lb × 5, 5 @ RIR 3", the deload's upper day
+ *    read as the row's own), 15 lb under the 165 it lifted before the deload and 20 under the step
+ *    from it (the back-offs 145 for 160); the bench press, main on both of its days on the same
+ *    split, steps up from its last top set after the same deload week (205, then 210). The row's
+ *    top set is back at 170 four weeks after that.
+ * 2. Three days (full body, upper, lower): the bench press is the main lift on the upper day and
+ *    secondary on the full-body day. After the deload week, the full-body day reads past the deload
+ *    (195, the back-offs' load off 205), and the upper day after it reads that straight day as its
+ *    own: the top set held at 200 (its last before the deload), "Last: 195 lb × 5, 5, 5 @ RIR 2",
+ *    a straight day at the back-offs' load named as the session the top set is read from.
+ *
+ * 3. The coach reads the row's fall as a stall: from the third pull day after the deload, every set
+ *    of every session lifted as asked, `detectStalls` finds the row "stalled-at-effort" ("Best
+ *    estimated max 192.5 lb then, 186.7 lb now (Sep 15 to Oct 13)") and a route opens (shift the rep
+ *    range, a variation, a deload, a set more) for a fall the plan made.
+ *
+ * The same cause as strengthFiveDays.test.ts: past two sessions since the last top set, the
+ * straight days at the back-offs' load are read as the lift's own, at its own reserve.
+ *
+ * Also fails on 5dc61a7 and e6ed7ed (the sixth pass: three straight days at the back-offs' load
+ * running). Synthetic data only.
+ */
+
+const ROW = 'barbell-row';
+const start = '2026-09-07T12:00:00.000Z';
+const begin = Date.parse(start);
+const DAY = 86_400_000;
+
+const seedOf = (exerciseId: string, weight: number) => ({
+  ...record(0, exerciseId, [
+    [5, weight, 2],
+    [5, weight, 2],
+    [5, weight, 2],
+  ]),
+  id: `seed-${exerciseId}`,
+  startedAt: '2026-09-04T12:00:00.000Z',
+  completedAt: '2026-09-04T12:00:00.000Z',
+});
+
+/** The deload week, Monday to Monday of week 2 (days 14 to 20). */
+const deload = {
+  startsAt: new Date(begin + 14 * DAY - 3_600_000).toISOString(),
+  endsAt: new Date(begin + 21 * DAY - 3_600_000).toISOString(),
+};
+
+const load = (sets: string[]) => Number(sets[0]!.split(' ')[1]!.split('x')[0]);
+
+describe('a lift main one day and secondary another, after a deload week', () => {
+  it('the row (default four days): its first top set after the deload steps from the last one', () => {
+    const days: number[] = [];
+    for (let week = 0; week < 5; week += 1) {
+      days.push(week * 7, week * 7 + 1, week * 7 + 3, week * 7 + 4);
+    }
+    const week: Record<number, string> = { 0: 'push-arms', 1: 'pull-arms', 3: 'lower', 4: 'upper' };
+    const { seen } = simulate({
+      profile: profileOf('hybrid'),
+      history: [seedOf(ROW, 155)],
+      start,
+      days,
+      exerciseId: ROW,
+      constraintsFor: (day) => ({
+        templateId: week[day % 7]!,
+        ...(day >= 14 && day < 21 ? { deload } : {}),
+      }),
+    });
+    const lines = seen
+      .map(
+        (one) =>
+          `day ${one.day} ${one.template}${one.atBackOffs ? ' (marked)' : ''}: ${one.sets.join(' | ')} / ${one.evidence.join(' / ')}`,
+      )
+      .join('\n');
+    const pulls = seen.filter((one) => one.template === 'pull-arms');
+    const before = pulls.filter((one) => one.day < 14);
+    const after = pulls.filter((one) => one.day >= 21);
+    expect(before.length, lines).toBeGreaterThanOrEqual(2);
+    expect(after.length, lines).toBeGreaterThanOrEqual(1);
+    // Twice in the deload week, each at the back-offs' load, marked.
+    expect(
+      seen.filter((one) => one.day >= 14 && one.day < 21).map((one) => one.atBackOffs),
+      lines,
+    ).toEqual([true, true]);
+    const lastTop = load(before.at(-1)!.sets);
+    // On abb5566: 150 after 165 ("Last: 145 lb × 5, 5 @ RIR 3 (Sep 25)").
+    expect(after[0]!.sets[0]!.startsWith('top '), lines).toBe(true);
+    expect(load(after[0]!.sets), lines).toBeGreaterThan(lastTop);
+  });
+
+  it('the bench press (three days): the upper day after the deload never reads the full-body day', () => {
+    const schedule = createDefaultProfile('2026-09-01T12:00:00.000Z').schedule;
+    const three = profileOf('hybrid', {
+      schedule: { ...schedule, availableDays: ['mon', 'wed', 'fri'], weeklyFrequency: 3 },
+    });
+    const days: number[] = [];
+    for (let week = 0; week < 5; week += 1) days.push(week * 7, week * 7 + 2, week * 7 + 4);
+    const week: Record<number, string> = { 0: 'full-body', 2: 'upper', 4: 'lower' };
+    const { seen } = simulate({
+      profile: three,
+      history: [seedOf(BENCH, 185)],
+      start,
+      days,
+      exerciseId: BENCH,
+      constraintsFor: (day) => ({
+        templateId: week[day % 7]!,
+        ...(day >= 14 && day < 21 ? { deload } : {}),
+      }),
+    });
+    const lines = seen
+      .map(
+        (one) =>
+          `day ${one.day} ${one.template}${one.atBackOffs ? ' (marked)' : ''}: ${one.sets.join(' | ')} / ${one.evidence.join(' / ')}`,
+      )
+      .join('\n');
+    const uppers = seen.filter((one) => one.template === 'upper');
+    const before = uppers.filter((one) => one.day < 14);
+    const after = uppers.filter((one) => one.day >= 21);
+    expect(after.length, lines).toBeGreaterThanOrEqual(1);
+    const lastTop = load(before.at(-1)!.sets);
+    // On abb5566: 200 after 200, "Last: 195 lb × 5, 5, 5 @ RIR 2 (Sep 28)", the full-body day.
+    expect(load(after[0]!.sets), lines).toBeGreaterThan(lastTop);
+    expect(after[0]!.evidence[0], lines).toMatch(/^Last: \d+ lb × \d+ @ RIR 1 /);
+  });
+});
+
+describe('the coach after the row’s deload week, every set lifted as asked', () => {
+  it('finds no stall', () => {
+    const days: number[] = [];
+    for (let week = 0; week < 7; week += 1) {
+      days.push(week * 7, week * 7 + 1, week * 7 + 3, week * 7 + 4);
+    }
+    const week: Record<number, string> = { 0: 'push-arms', 1: 'pull-arms', 3: 'lower', 4: 'upper' };
+    const { history } = simulate({
+      profile: profileOf('hybrid'),
+      history: [seedOf(ROW, 155)],
+      start,
+      days,
+      exerciseId: ROW,
+      constraintsFor: (day) => ({
+        templateId: week[day % 7]!,
+        ...(day >= 14 && day < 21 ? { deload } : {}),
+      }),
+    });
+    const policy = coachingPolicy('intermediate');
+    const stalled = history.flatMap((record, at) =>
+      detectStalls(history.slice(0, at + 1), profileOf('hybrid'), policy)
+        .filter((stall) => stall.exerciseId === ROW)
+        .map((stall) => `${record.completedAt}: ${stall.why.join(' ')}`),
+    );
+    // On abb5566: "stalled-at-effort" from Oct 13, "Best estimated max 192.5 lb then, 186.7 lb now".
+    expect(stalled).toEqual([]);
+  });
+});
diff --git a/src/engine/progression/backOffs.dropOffLoad.test.ts b/src/engine/progression/backOffs.dropOffLoad.test.ts
new file mode 100644
index 0000000..6332e5c
--- /dev/null
+++ b/src/engine/progression/backOffs.dropOffLoad.test.ts
@@ -0,0 +1,94 @@
+import { describe, expect, it } from 'vitest';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { record, type SetSpec } from '../../test/records';
+import { BENCH, bench, plan, shape } from '../../test/backOffs';
+
+/**
+ * The ninth review of round N. The drop's self-correction reads back-offs lifted at another load
+ * than the drop's as if they were at it: two sessions of back-offs lighter than the drop gives,
+ * rated easier than asked, narrow the drop to nothing, and the next plan asks every back-off at the
+ * top set's own load.
+ *
+ * The spec (docs/reports/maintenance-32.md, docs/research/top-set-back-offs.md): "When the back-offs
+ * miss their reserve by a rep or more on average two sessions running at the drop in force, the
+ * same way, it moves 4% for each rep missed: harder widens it, easier narrows it" (Helms et al.
+ * 2018's 2% per half a rep of RPE, a load correction for a rating missed at that load); "a weight
+ * the back-offs took by hand after it is theirs" (`withDropsToday`); the follow takes the back-offs
+ * "a step up after one clearly easy and down after a grind". The research's self-correction asks
+ * whether the drop's load was too heavy or too light; a back-off lifted at another load says how
+ * that load felt.
+ *
+ * What happens: `backOffMiss` reads every back-off's reserve against its target, never the load it
+ * was lifted at against the drop's (`backOffLoad(top, drop)`), and `backOffDropFor` moves the drop
+ * on it.
+ *
+ * 1. The follow's own step: two sessions whose top set ground out (200 × 4 at 0 in reserve, so the
+ *    top set holds), the back-offs stepped down to 185 after each (the drop's load is 190), rated
+ *    3 or 4 in reserve, as a step lighter feels: the drop narrows to 1% or to nothing, and the next
+ *    plan, after two grinding top sets, asks the back-offs at 195, or at 200, the top set's own
+ *    load, at 2 in reserve after a top set at 1.
+ * 2. A weight set by hand: two sessions whose back-offs the lifter set 15% lighter by hand (170 for
+ *    a 200 top set), rated 4 in reserve: the drop goes to nothing, every back-off at 205 after a
+ *    205 top set. Set to the top set's own load by hand and rated 1, the drop widens to 9%.
+ *
+ * Also fails on 412666e (before the eighth pass). Synthetic data only.
+ */
+
+function structured(daysAgo: number, top: SetSpec, backOff: SetSpec): WorkoutRecord {
+  const done = record(daysAgo, BENCH, [top, backOff, backOff, backOff], [4, 6], 2);
+  const entry = done.entries[0]!;
+  entry.backOffDrop = 0.05;
+  // As the store saves it: the load the drop gave the back-offs off the top set as lifted, at the
+  // gym's 5 lb step.
+  entry.backOffAt = Math.round(((top[1] ?? 0) * (1 - 0.05)) / 5) * 5;
+  entry.role = 'primary-strength';
+  entry.sets.forEach((set, at) => {
+    set.tier = at === 0 ? 'top' : 'back-off';
+    set.targetRir = at === 0 ? 1 : 2;
+    // The load each set was asked at: the back-offs' as the follow or the hand left it.
+    set.targetWeight = set.weight;
+  });
+  return done;
+}
+
+describe('the drop after back-offs lifted at another load than the drop’s', () => {
+  it('stepped down after two grinding top sets and rated a rep easier: the drop stays', () => {
+    // A step under the drop's load (185 for 190, 2.5% more) and a rep more in reserve: at the
+    // drop's own load they would have been at about their reserve.
+    const history = [
+      structured(7, [4, 200, 0], [5, 185, 3]),
+      structured(3, [4, 200, 0], [5, 185, 3]),
+    ];
+    const entry = bench(plan(history));
+    const sets = shape(entry);
+    expect(sets[0]).toEqual([200, 1, 'top']);
+    // On 34dc615 and 412666e: 0.01, the back-offs at 195 after two grinding top sets (rated 4 in
+    // reserve instead: 0, the back-offs at 200, the top set's own load).
+    expect(entry.backOffDrop).toBe(0.05);
+    expect(sets.slice(1).map((set) => set[0])).toEqual([190, 190, 190]);
+  });
+
+  it('set lighter by hand and rated easier: no back-off at the top set’s own load', () => {
+    const history = [
+      structured(7, [5, 195, 1], [5, 165, 4]),
+      structured(3, [5, 200, 1], [5, 170, 4]),
+    ];
+    const entry = bench(plan(history));
+    const sets = shape(entry);
+    expect(sets[0]).toEqual([205, 1, 'top']);
+    // On 34dc615 and 412666e: drop 0, [205, 205, 205] at 2 in reserve after a top set of 205 at 1.
+    expect(entry.backOffDrop).toBeGreaterThan(0);
+    expect(Math.max(...sets.slice(1).map((set) => set[0] as number))).toBeLessThan(205);
+  });
+
+  it('set to the top set’s load by hand and rated a rep harder: the drop stays', () => {
+    const history = [
+      structured(7, [5, 195, 1], [5, 195, 1]),
+      structured(3, [5, 200, 1], [5, 200, 1]),
+    ];
+    const entry = bench(plan(history));
+    // Back-offs at the top set's own load were a rep harder than asked: at the 5% drop in force they
+    // would have been at about their reserve. On 34dc615 and 412666e: 0.09, back-offs 185.
+    expect(entry.backOffDrop).toBe(0.05);
+  });
+});
diff --git a/src/engine/progression/backOffs.mainOnceAWeek.test.ts b/src/engine/progression/backOffs.mainOnceAWeek.test.ts
new file mode 100644
index 0000000..d563730
--- /dev/null
+++ b/src/engine/progression/backOffs.mainOnceAWeek.test.ts
@@ -0,0 +1,121 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultProfile } from '../../core/validation/profile';
+import type { Readiness } from '../recalibration/types';
+import { record } from '../../test/records';
+import { profileOf } from '../../test/backOffs';
+import { simulate } from '../../test/backOffsSim';
+
+/**
+ * The eighth review of round N. A lift trained three times a week with one main day is read as
+ * having left the structure the first time its main day runs straight, and from then on its top set
+ * steps from its own straight days at the back-offs' load: it falls, then never progresses again.
+ *
+ * Strength focus on five days (Monday to Friday) runs the split full body, lower, upper, push, pull
+ * (`splitFor`). The row is the main lift on the pull day (Friday), and also trained at the same 4-6
+ * range on the full-body day (primary hypertrophy) and the upper day (secondary strength): both run
+ * it straight at its back-offs' load, saved as such days (`atBackOffs`). That is two sessions since
+ * its last top set every Friday, the most `pastBackOffDays` reads through (`BACK_OFF.STRAIGHT_RUN`).
+ *
+ * The spec: when fatigue is high the main lift runs straight at that mode's load (the research,
+ * docs/research/top-set-back-offs.md); a lift's top set reads past its straight days at the
+ * back-offs' load back to its last session of its own, and only a lift that has left the structure
+ * ("a style or a split changed", docs/reports/maintenance-32.md and its known limits) reads its
+ * straight sessions as its own. Nothing here changed: same style, same split, every set lifted as
+ * asked (the reps one past the floor, at the reserve and load asked).
+ *
+ * Steps: the row seeded at 155; eight weeks of the five-day split; every other Friday a check-in
+ * with low energy, so the day's fatigue is high and the pull day runs the row straight at its
+ * back-offs' load (marked), as the research has it. The full-body day after it counts three
+ * sessions since the last top set, reads the whole history, and takes that Friday's straight sets
+ * (150) as the row's own; the upper day holds them; the next pull day's top set steps from them:
+ * 155 after 160, then 150, then 150 for good (the back-offs 145), every two weeks the same cycle.
+ * Before round N (532aba6) the same eight weeks of pull days, straight sets, went 160, 160, 165,
+ * 165, 170, 170, 175, 175 (the tired Fridays holding the load), 185 by week 12. On abb5566 the top
+ * sets go 160, 155, 150, 150, the tired Fridays at 150, 145, 145, 145; twelve weeks give a top set
+ * of 150 four times running, ten pounds under where it began.
+ *
+ * Also fails on 5dc61a7 (the sixth pass: three straight days at the back-offs' load running) and on
+ * e6ed7ed. Synthetic data only.
+ *
+ * As fixed (the eighth pass): the five days are Monday, Tuesday, Thursday, Friday and Sunday, so the
+ * pre-Maintenance-33 fatigue score's days in a row leave the untired pull days to their top sets.
+ * Five days running, every Friday read high there, a separate matter Maintenance 33's fatigue model
+ * owns (an estimated max planned lighter later in a session read as a fall; days in a row scored).
+ */
+
+const ROW = 'barbell-row';
+const start = '2026-09-07T12:00:00.000Z';
+const tired: Readiness = {
+  energy: 2,
+  soreness: 2,
+  sleep: 3,
+  motivation: 3,
+  jointDiscomfort: [],
+  timePressure: false,
+};
+
+describe('the row under Strength focus on five days, a tired Friday every other week', () => {
+  it('its top set never falls, and climbs, every set lifted as asked', () => {
+    const schedule = createDefaultProfile('2026-09-01T12:00:00.000Z').schedule;
+    const five = profileOf('strength-focus', {
+      schedule: {
+        ...schedule,
+        availableDays: ['mon', 'tue', 'thu', 'fri', 'sun'],
+        weeklyFrequency: 5,
+      },
+    });
+    const week: Record<number, string> = {
+      0: 'full-body',
+      1: 'lower',
+      3: 'upper',
+      4: 'push-arms',
+      6: 'pull-arms',
+    };
+    const days: number[] = [];
+    for (let at = 0; at < 8; at += 1) for (const day of [0, 1, 3, 4, 6]) days.push(at * 7 + day);
+    const seed = {
+      ...record(0, ROW, [
+        [5, 155, 2],
+        [5, 155, 2],
+        [5, 155, 2],
+      ]),
+      id: 'seed',
+      startedAt: '2026-09-04T12:00:00.000Z',
+      completedAt: '2026-09-04T12:00:00.000Z',
+    };
+    const { seen } = simulate({
+      profile: five,
+      history: [seed],
+      start,
+      days,
+      exerciseId: ROW,
+      constraintsFor: (day) => ({
+        templateId: week[day % 7]!,
+        ...(day % 7 === 6 && Math.floor(day / 7) % 2 === 1 ? { readiness: tired } : {}),
+      }),
+    });
+    const lines = seen
+      .map(
+        (one) =>
+          `day ${one.day} ${one.template}${one.atBackOffs ? ' (marked)' : ''}: ${one.sets[0]} / ${one.evidence.slice(0, 2).join(' / ')}`,
+      )
+      .join('\n');
+    const load = (set: string) => Number(set.split(' ')[1]!.split('x')[0]);
+    const tops = seen
+      .filter((one) => one.sets[0]!.startsWith('top '))
+      .map((one) => load(one.sets[0]!));
+    expect(tops.length, lines).toBeGreaterThanOrEqual(4);
+    // The tired Fridays run straight at the back-offs' load, as the research has it.
+    expect(
+      seen
+        .filter((one) => one.template === 'pull-arms' && Math.floor(one.day / 7) % 2 === 1)
+        .every((one) => one.atBackOffs === true),
+      lines,
+    ).toBe(true);
+    // On abb5566: 160, 155, 150, 150.
+    for (let at = 1; at < tops.length; at += 1) {
+      expect(tops[at], lines).toBeGreaterThanOrEqual(tops[at - 1]!);
+    }
+    expect(tops.at(-1)!, lines).toBeGreaterThan(tops[0]!);
+  });
+});
diff --git a/src/engine/progression/backOffs.savedHandWeight.test.ts b/src/engine/progression/backOffs.savedHandWeight.test.ts
