--- /dev/null
+++ b/src/core/state/backOffs.refitTopTakenBack.store.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from 'vitest';
+import { startedMain } from '../../test/startedMain';
+
+/**
+ * The fourteenth review of round N. The thirteenth pass sends a lift under way before its top set
+ * through the back-offs' refit (`refitEntry`: `touched`), where `refitBackOffs`, its top set not
+ * done, puts every back-off still to come at one load, the drop off the load the top set asks
+ * (`planned`), and reads no back-off logged. The store's every replay of them reads those logs while
+ * the top set is still to come (`backOffsAsLogged`: "Each back-off still logged moves the ones after
+ * it as its log did"). A top set's log taken back after a back-off was logged clearly easy leaves
+ * the step that back-off gave the ones after it standing (the store's replay keeps it, 140); the next
+ * refit (the plates saved again, or a rep range set) takes it away, 135. At 270f40e such a lift was
+ * fitted in place set by set (`refitStarted`), and the step stood.
+ *
+ * The rules (docs/reports/maintenance-32.md): the fourth review, "a back-off's log taken back puts
+ * every back-off still to come where the top set as it stands puts them, each back-off still logged
+ * moving the ones after it as its log did"; the twelfth, "The back-offs take one rule wherever their
+ * load is worked out, the refit for the place's weights included"; the thirteenth review's own
+ * finding, "a refit gave every back-off still to come the load after the last back-off logged, where
+ * each moves only the ones after it".
+ *
+ * Steps: the main lift (barbell row) planned at 140 × 4-6 at 1, back-offs 135. The top set lifted at
+ * 140 × 5 at 1; back-off 1 at 135 × 8 at 4, clearly easy (back-offs 2 and 3 at 140); the top set's
+ * log deleted (the store keeps them at 140); then the plates saved again unchanged, or the rep range
+ * set to 5-7.
+ *
+ * What happens at d06edb5: back-offs 2 and 3 at 135. At 270f40e they stay at 140.
+ *
+ * The fix (the fourteenth pass): with the top set still to come, the refit puts the back-offs at the
+ * drop off the load it asks, each back-off still logged moving the ones after it as its log did,
+ * capped at the top set as planned, as every replay of them does (`owedBackOffLoads`). Synthetic
+ * data only.
+ */
+
+async function topTakenBackAfterAnEasyBackOff() {
+  const started = await startedMain();
+  const { store, main, toCome } = started;
+  const top = main().sets.find((set) => set.tier === 'top')!;
+  const [first] = main().sets.filter((set) => set.tier === 'back-off');
+  await store.logSet(main().id, top.index, { weight: 140, reps: 5, rir: 1 });
+  await store.logSet(main().id, first!.index, { weight: 135, reps: 8, rir: 4 });
+  expect(toCome()).toEqual([140, 140]);
+  store.deleteLoggedSet(main().id, top.index);
+  // Every replay of the store keeps the step back-off 1's log gave the ones after it.
+  expect(toCome()).toEqual([140, 140]);
+  return started;
+}
+
+describe('the refit of a lift whose top set’s log was taken back after an easy back-off', () => {
+  it('keeps the step the back-off gave the ones after it through the plates saved again', async () => {
+    const { store, toCome } = await topTakenBackAfterAnEasyBackOff();
+    await store.setMissingPlates([]);
+    // At d06edb5: [135, 135].
+    expect({ backOffs: toCome() }).toEqual({ backOffs: [140, 140] });
+  });
+
+  it('caps the step at the top set as planned, as every replay does', async () => {
+    const started = await startedMain();
+    const { store, main, toCome } = started;
+    const top = main().sets.find((set) => set.tier === 'top')!;
+    const [first] = main().sets.filter((set) => set.tier === 'back-off');
+    await store.logSet(main().id, top.index, { weight: 140, reps: 5, rir: 1 });
+    // Back-off 1 lifted at the top set's load, clearly easy: the ones after it stay at that load.
+    await store.logSet(main().id, first!.index, { weight: 140, reps: 8, rir: 4 });
+    expect(toCome()).toEqual([140, 140]);
+    store.deleteLoggedSet(main().id, top.index);
+    expect(toCome()).toEqual([140, 140]);
+    await store.setMissingPlates([]);
+    // Never over the top set still to come (`backOffCap`).
+    expect({ backOffs: toCome() }).toEqual({ backOffs: [140, 140] });
+  });
+
+  it('keeps it through a rep range set', async () => {
+    const { store, main, toCome } = await topTakenBackAfterAnEasyBackOff();
+    await store.recalibrate({ type: 'rep-range', entryId: main().id, reps: [5, 7] });
+    // At d06edb5: [135, 135].
+    expect({ backOffs: toCome() }).toEqual({ backOffs: [140, 140] });
+  });
+});
diff --git a/src/core/state/backOffs.repRangeStandIn.store.test.ts b/src/core/state/backOffs.repRangeStandIn.store.test.ts
new file mode 100644
index 0000000..f9afcfd
--- /dev/null
+++ b/src/core/state/backOffs.repRangeStandIn.store.test.ts
@@ -0,0 +1,140 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../validation/location';
+import { createDefaultProfile, type UserProfile } from '../validation/profile';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * The thirteenth review of round N. A rep range set by hand (`rep-range`) sets the reps of every
+ * working set still to come, then runs `refitEntry` for the note by the target. Since the twelfth
+ * pass, a lift whose top set is done has its back-offs still to come re-derived there
+ * (`refitBackOffs`), and a back-off that stood in for a load (`asked`) took the reps of the load it
+ * stood in for: the reps the lifter had just set were thrown away on those back-offs, and the lift
+ * was marked as having reps set by hand while its back-offs showed the plan's.
+ *
+ * The rules: Maintenance 23, "Reps set by hand are the lifter's: they stay, and only the load is
+ * fitted" (refitStarted's doc); the rep-range trigger sets "the remaining sets" (its headline,
+ * "4-6 reps for the remaining sets"); the twelfth pass's refit, "a stand-in's load asked and added
+ * reps given back", is for reps a refit added, not for reps set by hand.
+ *
+ * Steps: the main lift (barbell row) planned at 160 × 4-6 at 1, back-offs 150 (both need a 2.5 lb
+ * plate). A ramp done; the 2.5 lb plates marked missing: the top set fitted as a stand-in (a load
+ * asked), the back-offs at the drop off the load it asks, onto the weights here, standing in for
+ * nothing (the thirteenth pass's fix: at 85ee7b6 they stood in for a load too). The top set lifted
+ * as shown. Then the rep range set to 8-10 for the remaining sets; or the rep range set before the
+ * top set, which is then lifted at another load than shown.
+ *
+ * What happens at 85ee7b6: the back-offs still to come at 4-6 (the reps of the load asked), the
+ * lift marked with reps set by hand. On 5762c00 they take 8-10. Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: { ...schedule, availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'], weeklyFrequency: 5 },
+  programStyle: 'hybrid',
+};
+
+async function startedMain(load: number) {
+  const { store } = createTestStore({ now: () => TEST_NOW });
+  await store.hydrate();
+  await store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await store.getDatabase();
+  for (const daysAgo of [7, 3]) {
+    for (const exerciseId of ['barbell-bench-press', 'back-squat', 'barbell-row']) {
+      const when = new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+      await db.put('workouts', {
+        ...record(0, exerciseId, [
+          [5, load, 2],
+          [5, load, 2],
+          [5, load, 2],
+        ]),
+        id: `w-${exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await store.hydrate();
+  const main = (): WorkoutEntry =>
+    allEntries(store.getSnapshot().session!.workout.blocks).find(
+      (entry) => entry.backOffDrop !== undefined,
+    )!;
+  expect(main()).toBeDefined();
+  store.startWorkout();
+  const backOffsToCome = () => {
+    const done = store.getSnapshot().session!.completed.sets;
+    return main().sets.filter(
+      (set) =>
+        set.tier === 'back-off' &&
+        !done.some((log) => log.entryId === main().id && log.setIndex === set.index),
+    );
+  };
+  const shown = () =>
+    backOffsToCome().map(
+      (set) => `${set.targetWeight} × ${set.targetReps.join('-')}${set.asked ? ' asked' : ''}`,
+    );
+  return { store, main, shown, backOffsToCome };
+}
+
+describe('a rep range set by hand after the top set, the back-offs standing in for a load', () => {
+  it('stays on the back-offs still to come', async () => {
+    const { store, main, shown, backOffsToCome } = await startedMain(155);
+    const top = main().sets.find((set) => set.tier === 'top')!;
+    const warmup = main().sets.find((set) => set.kind === 'warmup')!;
+    expect(top.targetWeight).toBe(160);
+    await store.logSet(main().id, warmup.index, {
+      weight: warmup.targetWeight,
+      reps: 5,
+      rir: null,
+    });
+    await store.setMissingPlates([2.5]);
+    const fitted = main().sets.find((set) => set.index === top.index)!;
+    expect(fitted.asked?.weight).toBe(160);
+    expect(shown().some((line) => line.endsWith('asked'))).toBe(false);
+    // The top set lifted as shown, on target.
+    await store.logSet(main().id, top.index, {
+      weight: fitted.targetWeight,
+      reps: fitted.targetReps[0] + 1,
+      rir: 1,
+    });
+    expect(backOffsToCome()).toHaveLength(3);
+    await store.recalibrate({ type: 'rep-range', entryId: main().id, reps: [8, 10] });
+    expect(main().manual?.reps).toBe(true);
+    // At 85ee7b6: "145 × 4-6" three times, the reps of the load the refit had them stand in for.
+    const reps = backOffsToCome().map((set) => set.targetReps.join('-'));
+    expect({ reps }, shown().join('; ')).toEqual({ reps: ['8-10', '8-10', '8-10'] });
+  });
+
+  it('stays through the follow of the top set (set before it, `backOffsReplayed`)', async () => {
+    const { store, main, shown, backOffsToCome } = await startedMain(155);
+    const top = main().sets.find((set) => set.tier === 'top')!;
+    const warmup = main().sets.find((set) => set.kind === 'warmup')!;
+    await store.logSet(main().id, warmup.index, {
+      weight: warmup.targetWeight,
+      reps: 5,
+      rir: null,
+    });
+    await store.setMissingPlates([2.5]);
+    expect(main().sets.find((set) => set.index === top.index)?.asked?.weight).toBe(160);
+    expect(shown().some((line) => line.endsWith('asked'))).toBe(false);
+    // Every set still to come at 8-10, the top set too.
+    await store.recalibrate({ type: 'rep-range', entryId: main().id, reps: [8, 10] });
+    expect(main().sets.find((set) => set.index === top.index)?.targetReps).toEqual([8, 10]);
+    expect(backOffsToCome().map((set) => set.targetReps.join('-'))).toEqual([
+      '8-10',
+      '8-10',
+      '8-10',
+    ]);
+    // The top set lifted at 8 reps, at another load than shown: its back-offs follow it.
+    await store.logSet(main().id, top.index, { weight: 145, reps: 8, rir: 1 });
+    // At 85ee7b6: "135 × 4-6" three times: the follow's replay gave them the reps of the load they
+    // stood in for, the lifter's 8-10 (the top set's own, as lifted) thrown away.
+    const reps = backOffsToCome().map((set) => set.targetReps.join('-'));
+    expect({ reps }, shown().join('; ')).toEqual({ reps: ['8-10', '8-10', '8-10'] });
+  });
+});
diff --git a/src/core/state/backOffs.replayLog.store.test.ts b/src/core/state/backOffs.replayLog.store.test.ts
new file mode 100644
index 0000000..bcc489a
--- /dev/null
+++ b/src/core/state/backOffs.replayLog.store.test.ts
@@ -0,0 +1,167 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../validation/location';
+import { createDefaultProfile, type UserProfile } from '../validation/profile';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * The eighth review of round N. The back-offs' replays read each logged back-off's step against the
+ * log as it was before the change that called for them: a top set corrected after a back-off was
+ * logged, a back-off's log deleted before one logged after it.
+ *
+ * The spec: "A correction to the top set moves its back-offs as the set logged right would have"
+ * (docs/reports/maintenance-32.md), each back-off still logged moving the ones after it as its log
+ * did (the sixth review). A back-off's step can read the top set: a back-off at the top of its
+ * range after a top set at the top of its range is "two over" (`autoregulate`), a step up.
+ *
+ * What happens on abb5566: `logSet`'s top-set correction builds the back-offs' logs with
+ * `backOffLogOf(session, …)` on the session from before the correction, so each back-off's plan
+ * (`planAfter`) reads the top set's old log; `deleteLoggedSet` (and `undoLastSet`) pass the session
+ * from before the delete to `backOffsAsPlanned`, so a back-off still logged reads the deleted one as
+ * the set before it.
+ *
+ * Steps: the main lift's top set logged at 140 × 6 at 1 in reserve (asked 4-6 at 1), back-offs
+ * 135; back-off 1 logged 135 × 6 at 2: two sets at the top of the range, back-offs 2 and 3 go to
+ * 140. The top set's reps corrected to 5, what was lifted. Logged so from the start, back-off 1
+ * moves nothing (the top set is not at the top of its range) and back-offs 2 and 3 stay at 135; after
+ * the correction they stay at 140, a step over. The other way round (top set 5 corrected to 6) they
+ * stay at 135 where the set logged right puts them at 140. A back-off corrected (the seventh
+ * review's replay, from the session as corrected) reads it right, so the result hangs on which set
+ * was fixed last. And: the top set 140 × 5 at 1, back-off 1 135 × 6 at 2 (nothing moves), back-off
+ * 2 135 × 6 at 2 (two at the top of the range: back-off 3 to 140); back-off 1's log deleted (a set
+ * logged on the wrong lift): back-off 2 now follows the top set, not at the top of its range, and
+ * back-off 3 belongs at 135; it stays at 140.
+ *
+ * Also fails on 5dc61a7 and e6ed7ed. Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: { ...schedule, availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'], weeklyFrequency: 5 },
+  programStyle: 'hybrid',
+};
+
+async function startedMain() {
+  const handle = createTestStore({ now: () => TEST_NOW });
+  const { store } = handle;
+  await store.hydrate();
+  await store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await store.getDatabase();
+  for (const daysAgo of [7, 3]) {
+    for (const exerciseId of ['barbell-bench-press', 'back-squat', 'barbell-row']) {
+      const when = new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+      await db.put('workouts', {
+        ...record(0, exerciseId, [
+          [5, 135, 2],
+          [5, 135, 2],
+          [5, 135, 2],
+        ]),
+        id: `w-${exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await store.hydrate();
+  const workout = () => store.getSnapshot().session!.workout;
+  const main = (): WorkoutEntry =>
+    allEntries(workout().blocks).find((entry) => entry.backOffDrop !== undefined)!;
+  expect(main()).toBeDefined();
+  const top = main().sets.find((set) => set.tier === 'top')!;
+  const [first] = main().sets.filter((set) => set.tier === 'back-off');
+  const planned = main()
+    .sets.filter((set) => set.tier === 'back-off')
+    .map((set) => set.targetWeight);
+  store.startWorkout();
+  const backOffs = () =>
+    main()
+      .sets.filter((set) => set.tier === 'back-off')
+      .map((set) => set.targetWeight);
+  return { store, main, top, first: first!, planned, backOffs };
+}
+
+describe('a top set’s reps corrected after back-off 1 was logged', () => {
+  it('6 corrected to 5: the back-offs after it where the set logged right puts them', async () => {
+    const right = await startedMain();
+    await right.store.logSet(right.main().id, right.top.index, {
+      weight: right.top.targetWeight,
+      reps: 5,
+      rir: 1,
+    });
+    await right.store.logSet(right.main().id, right.first.index, {
+      weight: right.planned[0]!,
+      reps: 6,
+      rir: 2,
+    });
+    // Logged right from the start: nothing moves.
+    expect(right.backOffs()).toEqual(right.planned);
+
+    const { store, main, top, first, planned, backOffs } = await startedMain();
+    expect(top.targetReps).toEqual([4, 6]);
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 6, rir: 1 });
+    await store.logSet(main().id, first.index, { weight: planned[0]!, reps: 6, rir: 2 });
+    // Two sets at the top of the range: a step up for back-offs 2 and 3.
+    expect(backOffs()[1]!).toBeGreaterThan(planned[1]!);
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 5, rir: 1 });
+    // On abb5566: back-offs 2 and 3 stay a step up.
+    expect(backOffs()).toEqual(right.backOffs());
+  });
+
+  it('5 corrected to 6: the step the set logged right gives', async () => {
+    const right = await startedMain();
+    await right.store.logSet(right.main().id, right.top.index, {
+      weight: right.top.targetWeight,
+      reps: 6,
+      rir: 1,
+    });
+    await right.store.logSet(right.main().id, right.first.index, {
+      weight: right.planned[0]!,
+      reps: 6,
+      rir: 2,
+    });
+    expect(right.backOffs()[1]!).toBeGreaterThan(right.planned[1]!);
+
+    const { store, main, top, first, planned, backOffs } = await startedMain();
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 5, rir: 1 });
+    await store.logSet(main().id, first.index, { weight: planned[0]!, reps: 6, rir: 2 });
+    expect(backOffs()).toEqual(planned);
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 6, rir: 1 });
+    // On abb5566: back-offs 2 and 3 stay at the plan's load.
+    expect(backOffs()).toEqual(right.backOffs());
+  });
+});
+
+describe('a back-off’s log deleted before a back-off logged after it', () => {
+  it('the ones still to come where the logs left standing put them', async () => {
+    const right = await startedMain();
+    const [, second] = right.main().sets.filter((set) => set.tier === 'back-off');
+    await right.store.logSet(right.main().id, right.top.index, {
+      weight: right.top.targetWeight,
+      reps: 5,
+      rir: 1,
+    });
+    await right.store.logSet(right.main().id, second!.index, {
+      weight: right.planned[1]!,
+      reps: 6,
+      rir: 2,
+    });
+    // The top set and back-off 2 alone: nothing moves.
+    expect(right.backOffs()).toEqual(right.planned);
+
+    const { store, main, top, first, planned, backOffs } = await startedMain();
+    const [, two] = main().sets.filter((set) => set.tier === 'back-off');
+    await store.logSet(main().id, top.index, { weight: top.targetWeight, reps: 5, rir: 1 });
+    await store.logSet(main().id, first.index, { weight: planned[0]!, reps: 6, rir: 2 });
+    await store.logSet(main().id, two!.index, { weight: planned[1]!, reps: 6, rir: 2 });
+    // Back-offs 1 and 2 at the top of the range: back-off 3 a step up.
+    expect(backOffs()[2]!).toBeGreaterThan(planned[2]!);
+    store.deleteLoggedSet(main().id, first.index);
+    // On abb5566: back-off 3 stays a step up.
+    expect(backOffs()).toEqual(right.backOffs());
+  });
+});
diff --git a/src/core/state/backOffs.savedCopy.store.test.ts b/src/core/state/backOffs.savedCopy.store.test.ts
new file mode 100644
index 0000000..c8ec401
--- /dev/null
+++ b/src/core/state/backOffs.savedCopy.store.test.ts
@@ -0,0 +1,127 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../../core/validation/location';
+import { createDefaultProfile, type UserProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { backOffDropFor } from '../../engine/progression/backOffs';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * Maintenance 32, the owner's item 11, and saved workouts (the first review of round N): a saved
+ * copy loaded after the lift's own sessions moved its drop takes the drop in force, so a session of
+ * an old copy never throws away what the sessions taught. TEST_NOW is a Wednesday, a day the
+ * schedule ticks. Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: {
+    ...schedule,
+    availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'],
+    weeklyFrequency: 5,
+  },
+  programStyle: 'hybrid',
+};
+const LIFTS = ['barbell-bench-press', 'back-squat', 'barbell-row'];
+const at = (daysAgo: number) => new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+
+/** A session of a lift on the structure, `daysAgo`, at a drop, its back-offs on target. */
+function structured(exerciseId: string, daysAgo: number, drop: number): WorkoutRecord {
+  const done = record(
+    0,
+    exerciseId,
+    [
+      [5, 140, 1],
+      [5, 120, 2],
+      [5, 120, 2],
+      [5, 120, 2],
+    ],
+    [4, 6],
+    2,
+    { id: `w-${exerciseId}-s${daysAgo}`, startedAt: at(daysAgo), completedAt: at(daysAgo) },
+  );
+  const entry = done.entries[0]!;
+  entry.backOffDrop = drop;
+  entry.sets.forEach((set, index) => {
+    set.tier = index === 0 ? 'top' : 'back-off';
+    set.targetRir = index === 0 ? 1 : 2;
+  });
+  return done;
+}
+
+describe('a saved copy loaded after the drop moved, the first review of round N', () => {
+  it('never throws away the drop the lift’s own sessions taught', async () => {
+    const handle = createTestStore({ now: () => TEST_NOW });
+    const { store } = handle;
+    await store.hydrate();
+    await store.completeOnboarding(
+      { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+      createDefaultLocations({ gymAccess: true }, TEST_NOW),
+    );
+    const db = await store.getDatabase();
+    for (const daysAgo of [12, 9]) {
+      for (const exerciseId of LIFTS) {
+        await db.put('workouts', {
+          ...record(
+            0,
+            exerciseId,
+            [
+              [5, 135, 2],
+              [5, 135, 2],
+              [5, 135, 2],
+            ],
+            [4, 6],
+            2,
+          ),
+          id: `w-${exerciseId}-${daysAgo}`,
+          startedAt: at(daysAgo),
+          completedAt: at(daysAgo),
+        });
+      }
+    }
+    await store.hydrate();
+    const main = (): WorkoutEntry =>
+      allEntries(store.getSnapshot().session!.workout.blocks).find(
+        (entry) => entry.backOffDrop !== undefined,
+      )!;
+    expect(main().backOffDrop).toBe(0.05);
+    // Saved now, at the 5% the lift starts from.
+    const saved = await store.saveCurrentWorkout('Main day');
+
+    // Since then, two sessions of each lift at 13%, the back-offs on target: 13% is the drop now.
+    for (const daysAgo of [6, 3]) {
+      for (const exerciseId of LIFTS)
+        await db.put('workouts', structured(exerciseId, daysAgo, 0.13));
+    }
+    await store.hydrate();
+    expect(main().backOffDrop).toBe(0.13);
+
+    // The old copy, loaded and lifted: the top set as planned, the back-offs ground out.
+    store.loadSavedWorkout(saved.id);
+    store.startWorkout();
+    // Before: 0.05, the copy's own drop. Its back-offs drop the 13% in force off its top set.
+    expect(main().backOffDrop).toBe(0.13);
+    const top = main().sets.find((set) => set.tier === 'top')!;
+    for (const set of main().sets.filter((candidate) => candidate.tier === 'back-off')) {
+      expect(set.targetWeight).toBeLessThanOrEqual(top.targetWeight! * 0.87);
+      expect(set.targetWeight).toBeGreaterThan(top.targetWeight! * 0.8);
+    }
+    // The copy's main lift, whose own sessions moved its drop to 13%.
+    const exerciseId = main().exerciseId;
+    expect(backOffDropFor(exerciseId, store.getSnapshot().history)).toBe(0.13);
+    for (const set of main().sets.filter((candidate) => candidate.kind === 'working')) {
+      const top = set.tier === 'top';
+      await store.logSet(main().id, set.index, {
+        weight: set.targetWeight,
+        reps: top ? 5 : 4,
+        rir: top ? 1 : 0,
+      });
+    }
+    await store.finishWorkout(null);
+    store.dismissCompletion();
+    // Back-offs too hard at 5% once more: the next plan must not go back to 5%.
+    expect(backOffDropFor(exerciseId, store.getSnapshot().history)).toBeGreaterThanOrEqual(0.13);
+  });
+});
diff --git a/src/core/state/backOffs.secondRefitTopLoad.store.test.ts b/src/core/state/backOffs.secondRefitTopLoad.store.test.ts
new file mode 100644
index 0000000..4d62a56
--- /dev/null
+++ b/src/core/state/backOffs.secondRefitTopLoad.store.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../validation/location';
+import { createDefaultProfile, type UserProfile } from '../validation/profile';
+import { allEntries, type WorkoutEntry } from '../../engine/workout/types';
+import { record } from '../../test/records';
+import { TEST_NOW, createTestStore } from '../../test/testStore';
+
+/**
+ * The thirteenth review of round N. A main lift under way before its top set (a ramp logged) is
+ * fitted in place when the weights change (`refitStarted`). The 2.5 lb plates marked missing: the
+ * top set (140) can't be made and stands in at 135 × 5-7 for 140 × 4-6, the place's note saying so
+ * (`progression.rack`: loaded 135, asked 140, one extra rep); the back-offs (135, the drop off 140)
+ * stay. At the next refit (another plate marked missing, the same plates saved again, a change of
+ * place) the back-offs at 135 are read as sets that note moved down from 140 (`changedBefore`: no
+ * `asked`, at the rack's loaded weight), and become stand-ins for 140 × 3-5. With the plates back,
+ * the back-offs are at 140 × 3-5: the top set's own load, two reps under its range. Lifted after
+ * that refit, the top set's follow gives them the reps of the load they "stood in for", 3-5 (the
+ * twelfth pass's `backOffsReplayed`).
+ *
+ * The rules (docs/reports/maintenance-32.md, item 11): "The rest are back-offs at the same reps, 5%
+ * lighter"; `backOffLoad`: "never the top set's own while a drop is in force"; the twelfth pass:
+ * "The back-offs take one rule wherever their load is worked out, the refit for the place's weights
+ * included: the drop off the top set as lifted, to the nearest weight the place has, at their own
+ * reps, never a stand-in's".
+ *
+ * Steps: the main lift (barbell row) planned at 140 × 4-6 at 1, back-offs 135. A ramp logged; the
+ * 2.5 lb plates marked missing; then the 10 lb plates too; then every plate back. Or, after the
+ * second change, the top set lifted at 130 × 5 at 1.
+ *
+ * What happens at 85ee7b6: the back-offs at 140 × 3-5 once the plates are back (5762c00 the same);
+ * the top set lifted at 130 after the second change, the back-offs at 125 × 3-5 (5762c00: at 4-6).
+ * Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const schedule = createDefaultProfile(TEST_NOW).schedule;
+const everyDay: Partial<UserProfile> = {
+  schedule: { ...schedule, availableDays: ['mon', 'tue', 'wed', 'thu', 'fri'], weeklyFrequency: 5 },
+  programStyle: 'hybrid',
+};
+
+async function startedMain() {
+  const { store } = createTestStore({ now: () => TEST_NOW });
+  await store.hydrate();
+  await store.completeOnboarding(
+    { ...createDefaultProfile(TEST_NOW), bodyweight: 185, ...everyDay },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const db = await store.getDatabase();
+  for (const daysAgo of [7, 3]) {
+    for (const exerciseId of ['barbell-bench-press', 'back-squat', 'barbell-row']) {
+      const when = new Date(Date.parse(TEST_NOW) - daysAgo * DAY).toISOString();
+      await db.put('workouts', {
+        ...record(0, exerciseId, [
+          [5, 135, 2],
+          [5, 135, 2],
+          [5, 135, 2],
+        ]),
+        id: `w-${exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await store.hydrate();
+  const main = (): WorkoutEntry =>
+    allEntries(store.getSnapshot().session!.workout.blocks).find(
+      (entry) => entry.backOffDrop !== undefined,
+    )!;
+  expect(main()).toBeDefined();
+  store.startWorkout();
+  const shown = () => {
+    const done = store.getSnapshot().session!.completed.sets;
+    return main()
+      .sets.filter(
+        (set) =>
+          set.tier === 'back-off' &&
+          !done.some((log) => log.entryId === main().id && log.setIndex === set.index),
+      )
+      .map((set) => `${set.targetWeight} × ${set.targetReps.join('-')}`);
+  };
+  return { store, main, shown };
+}
+
+/** A ramp logged, the 2.5 lb plates marked missing, then the 10 lb plates too. */
+async function twoChanges() {
+  const started = await startedMain();
+  const { store, main, shown } = started;
+  const top = main().sets.find((set) => set.tier === 'top')!;
+  const warmup = main().sets.find((set) => set.kind === 'warmup')!;
+  expect(top.targetWeight).toBe(140);
+  expect(shown()).toEqual(['135 × 4-6', '135 × 4-6', '135 × 4-6']);
+  await store.logSet(main().id, warmup.index, {
+    weight: warmup.targetWeight,
+    reps: 5,
+    rir: null,
+  });
+  await store.setMissingPlates([2.5]);
+  // The top set stands in at 135 for 140; the back-offs, at 135 already, stay.
+  expect(main().sets.find((set) => set.index === top.index)?.asked?.weight).toBe(140);
+  expect(shown()).toEqual(['135 × 4-6', '135 × 4-6', '135 × 4-6']);
+  await store.setMissingPlates([2.5, 10]);
+  return { ...started, top };
+}
+
+describe('the back-offs at the load a top set standing in for its own sits at', () => {
+  it('come back at the drop off the top set, at its reps, once the plates are back', async () => {
+    const { store, shown } = await twoChanges();
+    await store.setMissingPlates([]);
+    // At 85ee7b6 (and 5762c00): ["140 × 3-5", "140 × 3-5", "140 × 3-5"].
+    expect({ backOffs: shown() }).toEqual({ backOffs: ['135 × 4-6', '135 × 4-6', '135 × 4-6'] });
+  });
+
+  it('keep their own reps when the top set is lifted after the second change', async () => {
+    const { store, main, shown, top } = await twoChanges();
+    await store.logSet(main().id, top.index, { weight: 130, reps: 5, rir: 1 });
+    // At 85ee7b6: ["125 × 3-5", "125 × 3-5", "125 × 3-5"], the reps of a load they never stood
+    // in for.
+    expect({ reps: shown().map((line) => line.split(' × ')[1]) }).toEqual({
+      reps: ['4-6', '4-6', '4-6'],
+    });
+  });
+});
diff --git a/src/core/state/backOffs.setAddedAfterStep.store.test.ts b/src/core/state/backOffs.setAddedAfterStep.store.test.ts
