index 0000000..65a5826
--- /dev/null
+++ b/src/engine/recalibration/backOffs.deloadOnStraightDay.test.ts
@@ -0,0 +1,150 @@
+import { describe, expect, it } from 'vitest';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { gatherSignals, type CoachInput } from '../coach/coachConductor';
+import { emptyCompleted, emptyConstraints } from './recalibrate';
+import type { RecalibrationTrigger } from './types';
+import { interpretFatigue } from '../recovery/fatigue';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { RECORD_NOW, record, type SetSpec } from '../../test/records';
+import { BENCH, bench, gym, plan, profileOf, run } from '../../test/backOffs';
+import { savedAs } from '../../test/backOffsSim';
+
+/**
+ * The sixth review of round N. The coach's deload of a stalled main lift (its route's "Deload to
+ * N lb this week") taken on a day the lift runs straight at its back-offs' load (a day it is a
+ * secondary lift, the full-body day of the three-day split) keeps the day's mark (`atBackOffs`):
+ * the `target-weight` trigger moves every set to the deload's load and leaves the mark, so the day
+ * is saved as one at the back-offs' load. The lift's next top set reads past it, as past its
+ * back-offs, and steps from the stalled top set before it: the deload taken leaves no trace on the
+ * lift. The same deload taken on its main day is saved as a straight session of its own, and the
+ * next top set rebuilds from it. The spec: straight sets where the load is eased; a day saved as
+ * one at the back-offs' load is a straight day at that load. Synthetic data only.
+ */
+
+const DAY = 86_400_000;
+const at = (days: number) => new Date(Date.parse(RECORD_NOW) + days * DAY).toISOString();
+
+/** An upper day of the bench press on top set plus back-offs, `daysAgo` before RECORD_NOW. */
+function upperDay(daysAgo: number, top: SetSpec, backOffs: SetSpec[]): WorkoutRecord {
+  const done = record(daysAgo, BENCH, [top, ...backOffs], [4, 6], 2, { templateId: 'upper' });
+  const entry = done.entries[0]!;
+  entry.backOffDrop = 0.05;
+  entry.role = 'primary-strength';
+  entry.sets.forEach((set, index) => {
+    set.tier = index === 0 ? 'top' : 'back-off';
+    set.targetRir = index === 0 ? 1 : 2;
+  });
+  return done;
+}
+
+// The stalled top set: 200 x 5 at 1 in reserve, then the back-offs as asked.
+const history = [
+  upperDay(
+    3,
+    [5, 200, 1],
+    [
+      [5, 190, 2],
+      [5, 190, 2],
+      [5, 190, 2],
+    ],
+  ),
+];
+
+function coachInput(workout: GeneratedWorkout): CoachInput {
+  return {
+    workout,
+    status: 'preview',
+    duration: 'default',
+    completed: emptyCompleted(),
+    constraints: emptyConstraints(),
+    profile: profileOf(),
+    history,
+    now: RECORD_NOW,
+    fatigue: interpretFatigue(history, RECORD_NOW, null),
+    strategy: [],
+    lastExportAt: RECORD_NOW,
+    workoutCount: 1,
+    location: gym,
+    stalls: [
+      {
+        exerciseId: BENCH,
+        kind: 'stalled-at-effort',
+        exposures: 4,
+        totalExposures: 4,
+        baselineE1rm: 233,
+        latestE1rm: 233,
+        effortMet: 4,
+        effortUnknown: 0,
+        firstDate: at(-24),
+        lastDate: at(-3),
+        why: ['No better estimated max in 4 exposures.'],
+      },
+    ],
+    routes: {
+      id: 'coach-routes',
+      routes: {
+        [BENCH]: {
+          exerciseId: BENCH,
+          step: 2,
+          startedAt: at(-10),
+          baselineE1rm: 233,
+          applied: [],
+          exhausted: false,
+        },
+      },
+    },
+  };
+}
+
+/**
+ * The deload card taken on a day's plan, the day lifted as asked, then the next upper day's first
+ * working set; null where the coach offers no deload that day.
+ */
+function afterDeload(templateId: string) {
+  const workout = plan(history, profileOf(), { templateId });
+  const [route] = gatherSignals(coachInput(workout)).filter(
+    (signal) => signal.source === 'stall: route',
+  );
+  const action = route?.action;
+  if (action?.kind !== 'recalibrate') return null;
+  const taken = run(action.trigger as RecalibrationTrigger, workout, { history }).workout;
+  const saved = savedAs(taken, RECORD_NOW, `deload-${templateId}`);
+  const next = generateWorkout({
+    profile: profileOf(),
+    location: gym,
+    history: [...history, saved],
+    now: at(2),
+    duration: 'default',
+    constraints: { templateId: 'upper' },
+  });
+  const top = allEntries(next.blocks)
+    .find((entry) => entry.exerciseId === BENCH)!
+    .sets.find((set) => set.kind === 'working')!;
+  return { label: action.label, taken: bench(taken), top };
+}
+
+describe('the coach’s deload taken on a day the main lift runs at its back-offs’ load', () => {
+  it('the full-body day is that day (the bench press secondary there)', () => {
+    const workout = plan(history, profileOf(), { templateId: 'full-body' });
+    expect(bench(workout).role).toBe('secondary-strength');
+    expect(bench(workout).atBackOffs).toBe(true);
+  });
+
+  it('is read by the next top set, as the same deload taken on the main day is', () => {
+    const onMain = afterDeload('upper')!;
+    // Taken on the main day, the next upper day rebuilds from the deload's load.
+    expect(onMain.label).toMatch(/^Deload to \d+ lb this week$/);
+    expect(onMain.top.targetWeight!).toBeLessThan(200);
+    const onFullBody = afterDeload('full-body');
+    // Offered on the full-body day (on 6f2d5ea: "Deload to 180 lb this week"), taking it is a
+    // deload the lift's next top set reads.
+    if (onFullBody === null) return;
+    const deloadLoad = onFullBody.taken.sets.find((set) => set.kind === 'working')!.targetWeight!;
+    expect(deloadLoad).toBeLessThan(190);
+    const lines = `main day: ${onMain.label} -> next ${onMain.top.targetWeight}; full-body day: ${onFullBody.label} -> next ${onFullBody.top.targetWeight} (${onFullBody.top.tier}, marked ${String(onFullBody.taken.atBackOffs)})`;
+    // On 6f2d5ea: the full-body day's deload is saved as a day at the back-offs' load, and the next
+    // top set steps from the stalled 200 x 5 to 205, as if no deload was taken.
+    expect(onFullBody.top.targetWeight!, lines).toBeLessThan(200);
+  });
+});
diff --git a/src/engine/recalibration/backOffs.handWeightPlacePickUp.test.ts b/src/engine/recalibration/backOffs.handWeightPlacePickUp.test.ts
new file mode 100644
index 0000000..9b77ed8
--- /dev/null
+++ b/src/engine/recalibration/backOffs.handWeightPlacePickUp.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vitest';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import type { CompletedWork } from './types';
+import { BENCH, DB_BENCH, bench, entryOf, home, plan, run, topDone } from '../../test/backOffs';
+
+/**
+ * The tenth review of round N. A lift picked up again back at the gym keeps the record of a weight
+ * its back-offs took by hand (`manual.backOffs`) that the pick-up itself threw away: its back-offs
+ * come back at the load its top set as lifted gives them, as a swap back gives them, but a later
+ * correction of the top set puts them at the old hand weight, where after a swap back it leaves
+ * them where the pick-up put them.
+ *
+ * The spec (docs/reports/maintenance-32.md): "A lift picked up again, back at the gym or swapped
+ * back to, carries on its back-offs after its top set, as it was lifted"; the ninth pass, the weight
+ * set by hand once the top set is done is the back-offs' own, and `withoutHandTargets` deletes it on
+ * a swap ("An entry whose sets to come are built afresh (a swap, a swap back): the reps or the weight
+ * set by hand were for the sets it had, and no longer apply", Maintenance 23); a correction to the
+ * top set moves its back-offs "as the set logged right would have".
+ *
+ * What happens: the generator's pick-up of a lift the place stopped (`reopened` in generate.ts)
+ * appends the owed back-offs at `owedBackOffLoad` off the top set as lifted, but never clears
+ * `manual` as `swapBack` does (`withoutHandTargets(stopped)`); the `performance` trigger's top-set
+ * branch then reads `manual.backOffs` as the back-offs' own ("back-offs kept at 170 lb").
+ *
+ * Steps: the bench press's top set logged as planned, 190 × 5 at 1 (back-offs 180); the weight set
+ * by hand after it, 170, the back-offs' own. (a) The lifter goes home (no bench there: it stops
+ * after its top set) and back to the gym: the back-offs come back at 180. (b) The same, swapped to
+ * the dumbbell bench press and back: 180. Then the top set's reps corrected, 5 to 6: after (b) the
+ * back-offs stay at 180; after (a) they go to 170.
+ *
+ * Reached in the app where a weight is set after the top set is done (the coach's offers come on a
+ * lift with no set lifted: after a top set skipped, its skip then corrected). Passes on 1bbd451
+ * (before the ninth pass): both give 180. Synthetic data only.
+ */
+
+const benchAny = (workout: GeneratedWorkout) =>
+  allEntries(workout.blocks).find((entry) => entry.exerciseId === BENCH && !entry.stopped)!;
+
+const backOffLoads = (workout: GeneratedWorkout) =>
+  benchAny(workout)
+    .sets.filter((set) => set.tier === 'back-off')
+    .map((set) => set.targetWeight);
+
+describe('a weight the back-offs took by hand, then the lift picked up again', () => {
+  it('back at the gym, a correction of the top set leaves the back-offs as a swap back does', () => {
+    const workout = plan();
+    const entry = bench(workout);
+    const top = entry.sets.find((set) => set.tier === 'top')!;
+    expect(top.targetWeight).toBe(190);
+    const done = topDone(entry, 190);
+    // Set by hand once the top set is done: the back-offs' own.
+    const hand = run({ type: 'target-weight', entryId: entry.id, weight: 170 }, workout, {
+      completed: done,
+      currentEntryId: entry.id,
+    });
+    expect(backOffLoads(hand.workout)).toEqual([170, 170, 170]);
+    const corrected: CompletedWork = {
+      ...done,
+      sets: done.sets.map((set) => ({ ...set, reps: 6 })),
+    };
+    const correctTop = (workout_: GeneratedWorkout) =>
+      backOffLoads(
+        run(
+          {
+            type: 'performance',
+            entryId: entry.id,
+            setIndex: top.index,
+            actualReps: 6,
+            actualWeight: 190,
+            plan: { kind: 'none', reason: 'On target.' },
+          },
+          workout_,
+          { completed: corrected, currentEntryId: entry.id },
+        ).workout,
+      );
+
+    // (a) Home, where there is no bench, and back to the gym.
+    const away = run({ type: 'location' }, hand.workout, {
+      location: home,
+      completed: done,
+      currentEntryId: entry.id,
+    });
+    const back = run({ type: 'location' }, away.workout, {
+      completed: done,
+      constraints: away.constraints,
+    });
+    // (b) Swapped to the dumbbell bench press and back.
+    const swapped = run(
+      { type: 'replace', entryId: entry.id, exerciseId: DB_BENCH },
+      hand.workout,
+      {
+        completed: done,
+        currentEntryId: entry.id,
+      },
+    );
+    const swappedBack = run(
+      { type: 'replace', entryId: entryOf(swapped.workout, DB_BENCH).id, exerciseId: BENCH },
+      swapped.workout,
+      { completed: done, constraints: swapped.constraints },
+    );
+    // Picked up either way, the back-offs carry on off the top set as lifted.
+    expect(backOffLoads(back.workout)).toEqual([180, 180, 180]);
+    expect(backOffLoads(swappedBack.workout)).toEqual([180, 180, 180]);
+    expect(correctTop(swappedBack.workout)).toEqual([180, 180, 180]);
+    // On 25fd689: [170, 170, 170], the hand weight the pick-up had thrown away
+    // (`manual.backOffs` still 170 on the entry).
+    expect(correctTop(back.workout), JSON.stringify(benchAny(back.workout).manual)).toEqual([
+      180, 180, 180,
+    ]);
+  });
+});
