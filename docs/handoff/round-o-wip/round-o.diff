+      },
+    ],
+  };
+}
+
+const history = ['2026-08-10', '2026-08-17', '2026-08-24', '2026-08-31'].flatMap((monday) =>
+  (['mon', 'tue', 'wed'] as const).map((day) => trained(monday, day)),
