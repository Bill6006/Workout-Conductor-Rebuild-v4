+    startedAt: when,
+    completedAt: when,
+    locationId: 'gym',
+    templateId: 'full-body',
+    endedEarly: false,
+    rating: null,
+    skippedExerciseIds: [],
+    painJoints: [],
+    readiness: null,
+    prs: [],
+    entries: [
