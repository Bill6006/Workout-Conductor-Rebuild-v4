+/**
+ * A set read as a max: load × (1 + (reps + reserve) / 30), for a set with a load, of 12 reps or
+ * fewer, 3 or fewer in reserve (the reps and reserve read well: 34542869); null otherwise.
+ */
+export function setMax(set: {
+  reps: number;
+  weight: number | null;
+  rir: number | null;
