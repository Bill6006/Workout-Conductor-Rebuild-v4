+  if (set.weight === null || set.weight <= 0 || set.rir === null) return null;
+  if (set.reps < 1 || set.reps > FIRST_SET.READ_REPS || set.rir > FIRST_SET.READ_RIR) return null;
+  return set.weight * (1 + (set.reps + set.rir) / 30);
