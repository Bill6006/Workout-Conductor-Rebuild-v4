+
+/**
+ * A lift's rested baseline before a time: the median of its first working set read as a max over
+ * its last three to five sessions with every prime mover rested, and no illness or short night. Null
+ * with fewer than three.
+ */
+export function restedBaseline(
+  exerciseId: string,
+  history: readonly WorkoutRecord[],
+  before: string,
+): number | null {
+  const exercise = getExercise(exerciseId);
+  if (!exercise) return null;
+  const index = exposureIndex(history);
+  const key = `${exerciseId}|${before}`;
+  const kept = index.baselines.get(key);
+  if (kept !== undefined) return kept;
+  const until = Date.parse(before);
+  const maxes: number[] = [];
+  const reads = index.firsts.get(exerciseId) ?? [];
+  for (let at = reads.length - 1; at >= 0; at -= 1) {
+    if (maxes.length >= FIRST_SET.RESTED_MOST) break;
+    const read = reads[at] as FirstRead;
+    if (read.start >= until) continue;
+    read.rested ??= restedAt(exercise, read.record, index);
+    if (read.rested) maxes.push(read.max);
