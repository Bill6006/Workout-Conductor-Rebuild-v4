diff --git a/src/engine/recalibration/feverUnderWay.test.ts b/src/engine/recalibration/feverUnderWay.test.ts
new file mode 100644
index 0000000..8c7e7c5
--- /dev/null
+++ b/src/engine/recalibration/feverUnderWay.test.ts
@@ -0,0 +1,155 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../../core/validation/location';
+import { createDefaultProfile } from '../../core/validation/profile';
+import { REST_TODAY } from '../readiness/checkIn';
+import { emptyCompleted, emptyConstraints, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  Readiness,
+  RecalibrationRequest,
+  RecalibrationSuccess,
+  SessionConstraints,
+} from './types';
+import { allEntries, type GeneratedWorkout } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { RECORD_NOW, record } from '../../test/records';
+
+/**
+ * The first adversarial review of Maintenance 33: a fever reported under way, after a head cold,
+ * gives the full-effort plan back.
+ *
+ * Steps: a hybrid lifter with drop sets on starts the push day (its EZ-bar curl carries a drop set)
+ * and logs the bench press's top set. They check in with a head cold: every set still to come is
+ * held at 2 or more in reserve and the curl's drop set goes. Feeling worse, they update the
+ * check-in to "Fever or aches".
+ *
+ * The rule: the approved proposal, part 2: "Illness is a gate. With fever or whole-body symptoms,
+ * no session. Above-the-neck symptoms are trainable" (Weidner 1997; Dick 2014), and the head cold
+ * keeps "every set at 2 or more in reserve" (`RULES.headColdRir`). A fever is the stricter case: the
+ * day must never be harder under a fever than under a head cold, and `checkIn.ts` says a fever is
+ * "no session today". The drop set goes "On a day that keeps every set short of failure".
+ *
+ * What happens: the fever has no plan change of its own (`readinessAdjustment` returns undefined
+ * for 'body'), so the readiness trigger reads it as a check-in that "takes back an earlier one's
+ * adjustment" and restores the plan: the summary reads "Planned effort back: 6 exercises adjusted",
+ * every set still to come goes back to 1 in reserve, and the EZ-bar curl's drop set (a set to
+ * failure) comes back ("drop set added"), beside the note "Fever or aches all over: rest today".
+ *
+ * Synthetic data only.
+ */
+
+const base = createDefaultProfile(RECORD_NOW);
+const profile = {
+  ...base,
+  bodyweight: 185,
+  programStyle: 'hybrid' as const,
+  techniques: { ...base.techniques, dropSets: true },
+};
+const gym = createDefaultLocations({ gymAccess: true }, RECORD_NOW).find(
+  (place) => place.id === 'gym',
+)!;
+const history = [7, 3].map((daysAgo) =>
+  record(
+    daysAgo,
+    'barbell-bench-press',
+    [
+      [5, 185, 2],
+      [5, 185, 2],
+      [5, 185, 2],
+    ],
+    [4, 6],
+    2,
+  ),
+);
+
+const checkIn = (illness?: Readiness['illness']): Readiness => ({
+  energy: 3,
+  soreness: 2,
+  sleep: 3,
+  motivation: 3,
+  jointDiscomfort: [],
+  timePressure: false,
+  ...(illness ? { illness } : {}),
+});
+
+function readiness(
+  workout: GeneratedWorkout,
+  completed: CompletedWork,
+  constraints: SessionConstraints,
+  value: Readiness,
+): RecalibrationSuccess {
+  const request: RecalibrationRequest = {
+    trigger: { type: 'readiness', readiness: value },
+    workout,
+    completed,
+    lockedEntryIds: [],
+    currentEntryId: completed.currentEntryId,
+    duration: 'default',
+    profile,
+    location: gym,
+    history,
+    constraints,
+    reason: 'test',
+    timestamp: RECORD_NOW,
+  };
+  const result = recalibrate(request);
+  if (!result.ok) throw new Error(result.error);
+  return result;
+}
+
+/** The working and drop sets still to come, as `exercise kind@reserve`. */
+const toCome = (workout: GeneratedWorkout, completed: CompletedWork) => {
+  const done = new Set(completed.sets.map((set) => `${set.entryId}:${set.setIndex}`));
+  return allEntries(workout.blocks).flatMap((entry) =>
+    entry.sets
+      .filter((set) => set.kind !== 'warmup' && !done.has(`${entry.id}:${set.index}`))
+      .map((set) => ({ exerciseId: entry.exerciseId, kind: set.kind, rir: set.targetRir })),
+  );
+};
+
+describe('a fever reported under way after a head cold', () => {
+  it('never gives back a harder day than the head cold had', () => {
+    const plan = generateWorkout({
+      profile,
+      location: gym,
+      history,
+      now: RECORD_NOW,
+      duration: 'default',
+      constraints: { templateId: 'push-arms' },
+    });
+    // The plan carries a drop set on the EZ-bar curl.
+    expect(allEntries(plan.blocks).some((entry) => entry.dropSet)).toBe(true);
+    const bench = allEntries(plan.blocks)[0]!;
+    const top = bench.sets.find((set) => set.kind === 'working')!;
+    const completed: CompletedWork = {
+      ...emptyCompleted(),
+      startedAt: RECORD_NOW,
+      currentEntryId: bench.id,
+      sets: [
+        {
+          entryId: bench.id,
+          exerciseId: bench.exerciseId,
+          setIndex: top.index,
+          kind: 'working',
+          reps: 5,
+          weight: top.targetWeight,
+          rir: top.targetRir,
+          completedAt: RECORD_NOW,
+        },
+      ],
+    };
+
+    const head = readiness(plan, completed, emptyConstraints(), checkIn('head'));
+    const headSets = toCome(head.workout, completed);
+    expect(headSets.some((set) => set.kind === 'drop')).toBe(false);
+    expect(Math.min(...headSets.map((set) => set.rir))).toBeGreaterThanOrEqual(2);
+
+    const fever = readiness(head.workout, completed, head.constraints, checkIn('body'));
+    expect(fever.summary.details).toContain(REST_TODAY);
+    const feverSets = toCome(fever.workout, completed);
+    expect(fever.summary.headline).not.toMatch(/^Planned effort back/);
+    expect(fever.summary.headline).toBe(REST_TODAY);
+    expect(feverSets.some((set) => set.kind === 'drop')).toBe(false);
+    expect(Math.min(...feverSets.map((set) => set.rir))).toBeGreaterThanOrEqual(2);
+  });
+});
diff --git a/src/engine/recalibration/hardStartShortNight.test.ts b/src/engine/recalibration/hardStartShortNight.test.ts
new file mode 100644
index 0000000..f9ce21a
--- /dev/null
+++ b/src/engine/recalibration/hardStartShortNight.test.ts
@@ -0,0 +1,136 @@
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../../core/validation/location';
+import { createDefaultProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { recoveryBalance } from '../planning/weeklyPlan';
+import { readStart } from './badStart';
+import type { CompletedSet, Readiness } from './types';
+import { hoursSince, recoveryWindows } from '../recovery/recovery';
+import { allEntries, type WorkoutEntry } from '../workout/types';
+import { generateWorkout } from '../workoutGenerator/generate';
+import { RECORD_NOW, record, type SetSpec } from '../../test/records';
+
+/**
+ * The first adversarial review of Maintenance 33: the hard start reads each muscle's window without
+ * today's whole-body layer, so it calls a hard start where the coach and the Plan screen say the
+ * muscle is still inside its window.
+ *
+ * Steps: a lifter with their own bench press and incline press targets did cable flies 40 h ago,
+ * 12 reps at 2 in reserve (the chest's window: 36 h). Today's check-in says sleep "Short" (2), every
+ * other answer at the middle: one item worse, so it lowers nothing, but it is a short night. The
+ * first sets of the bench press and the incline press each fall exactly 3 reps short.
+ *
+ * The rule: the report, "The whole-body layer: a short night on today's check-in ... lengthens every
+ * window by 12 h", and "The windows are read where recovery is said: the Plan screen's balance ...,
+ * the hard start's reading (a muscle inside its window lowers what its first set is expected to do
+ * by a step), the 'too soon' card". The proposal, part 1: one shared model "so the two can never
+ * contradict"; readiness-and-soreness.md: "Recent hard work on the same muscle within 24-48 h lowers
+ * the expectation slightly".
+ *
+ * What happens: `readStart` calls `recoveryWindows(context.history, { resets })` without the
+ * check-in it was given, so the chest's window is 36 h and, 40 h on, over: the bench press takes no
+ * step and the two lifts read as a hard start (the rest of the day eased). At the same moment the
+ * coach's and the Plan screen's windows (with the short night) give the chest 48 h, 8 h still to
+ * run. With the flies 30 h ago (inside 36 h) the same sets are no hard start: the step itself works.
+ * (The hard start also reads the log as logged, `state.history`, where the coach and the Plan screen
+ * read it as the rules do, `state.readHistory`.)
+ *
+ * Synthetic data only.
+ */
+
+const profile = {
+  ...createDefaultProfile(RECORD_NOW),
+  bodyweight: 185,
+  programStyle: 'hypertrophy-focus' as const,
+};
+const gym = createDefaultLocations({ gymAccess: true }, RECORD_NOW).find(
+  (place) => place.id === 'gym',
+)!;
+
+const session = (
+  exerciseId: string,
+  daysAgo: number,
+  set: SetSpec,
+  target: [number, number],
+  rir: number,
+): WorkoutRecord => ({
+  ...record(daysAgo, exerciseId, [set, set, set], target, rir),
+  id: `${exerciseId}-${daysAgo}`,
+});
+
+const historyWithFlies = (hoursAgo: number): WorkoutRecord[] => [
+  session('barbell-bench-press', 11, [5, 185, 2], [4, 6], 2),
+  session('barbell-bench-press', 7, [5, 185, 2], [4, 6], 2),
+  session('incline-dumbbell-press', 11, [8, 60, 2], [6, 10], 2),
+  session('incline-dumbbell-press', 7, [8, 60, 2], [6, 10], 2),
+  session('cable-fly', hoursAgo / 24, [12, 40, 2], [10, 15], 2),
+];
+
+const shortNight: Readiness = {
+  energy: 3,
+  soreness: 2,
+  sleep: 2,
+  motivation: 3,
+  jointDiscomfort: [],
+  timePressure: false,
+};
+
+/** A lift's first working set logged exactly 3 reps short of what it asked, `minutes` in. */
+function threeShort(entry: WorkoutEntry, minutes: number): CompletedSet {
+  const set = entry.sets.find((candidate) => candidate.kind === 'working')!;
+  return {
+    entryId: entry.id,
+    exerciseId: entry.exerciseId,
+    setIndex: set.index,
+    kind: 'working',
+    reps: set.targetReps[0] - 3,
+    weight: set.targetWeight,
+    rir: set.targetRir,
+    completedAt: new Date(Date.parse(RECORD_NOW) + minutes * 60_000).toISOString(),
+  };
+}
+
+function start(history: WorkoutRecord[]) {
+  const workout = generateWorkout({
+    profile,
+    location: gym,
+    history,
+    now: RECORD_NOW,
+    duration: 'default',
+    constraints: { templateId: 'push-arms' },
+  });
+  const [bench, incline] = allEntries(workout.blocks);
+  expect([bench!.exerciseId, incline!.exerciseId]).toEqual([
+    'barbell-bench-press',
+    'incline-dumbbell-press',
+  ]);
+  const sets = [threeShort(bench!, 5), threeShort(incline!, 15)];
+  return {
+    sets,
+    reading: readStart(workout.blocks, sets, {
+      profile,
+      history,
+      readiness: shortNight,
+      resets: null,
+    }),
+  };
+}
+
+describe("the hard start's window step on a short night", () => {
+  it('reads the window the coach and the Plan screen read', () => {
+    // The control: the flies inside the chest's own 36 h, the bench press takes the step.
+    expect(start(historyWithFlies(30)).reading.low).toBe(false);
+
+    const history = historyWithFlies(40);
+    const { sets, reading } = start(history);
+    // The coach's window ("too soon" passes the check-in) and the Plan screen's: 48 h, inside.
+    const coach = recoveryWindows(history, { readiness: shortNight, now: RECORD_NOW }).get(
+      'chest',
+    )!;
+    expect(coach.hours).toBe(48);
+    expect(hoursSince(coach, sets[0]!.completedAt)).toBeLessThan(coach.hours);
+    const plan = recoveryBalance(history, sets[0]!.completedAt, { readiness: shortNight });
+    expect(plan.find((row) => row.muscle === 'chest')?.state).toBe('recovering');
+    expect(reading).toEqual({ low: false, lifts: [] });
+  });
+});
diff --git a/src/engine/recalibration/lighter.test.ts b/src/engine/recalibration/lighter.test.ts
new file mode 100644
index 0000000..2f4626c
--- /dev/null
+++ b/src/engine/recalibration/lighter.test.ts
@@ -0,0 +1,277 @@
+import { describe, expect, it } from 'vitest';
+import { requireExercise } from '../../catalog/exercises/catalog';
+import { createDefaultLocations, type LocationProfile } from '../../core/validation/location';
+import { createDefaultProfile, type UserProfile } from '../../core/validation/profile';
+import type { WorkoutRecord } from '../../core/validation/workoutRecord';
+import { record } from '../../test/records';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../workout/types';
+import { generateWorkout, setFloor } from '../workoutGenerator/generate';
+import { emptyCompleted, emptyConstraints, planUnderTheEase, recalibrate } from './recalibrate';
+import type {
+  CompletedWork,
+  RecalibrationRequest,
+  RecalibrationSuccess,
+  RecalibrationTrigger,
+  SessionConstraints,
+} from './types';
+
+/**
+ * Maintenance 33, the owner's decision 2: "too soon" warns, with a one-tap lighter option, never a
+ * block and never by itself. The option lays a hard start's ease on the muscle's lifts (a set fewer
+ * above the floor, a rep more in reserve, never heavier: proposal part 2, "keep the load and add a
+ * rep in reserve or drop a set"), through every rebuild, never on top of a hard start's own; a lift
+ * under way takes it on its sets still to come, for good. Synthetic data only.
+ */
+
+const NOW = '2026-10-21T14:00:00.000Z';
+const places = createDefaultLocations({ gymAccess: true }, NOW);
+const gym = places.find((place) => place.id === 'gym') as LocationProfile;
+const profile: UserProfile = { ...createDefaultProfile(NOW), bodyweight: 185 };
+
+interface Day {
+  workout: GeneratedWorkout;
+  constraints: SessionConstraints;
+  completed: CompletedWork;
+  duration: RecalibrationRequest['duration'];
+  result?: RecalibrationSuccess;
+}
+
+const plan = (history: WorkoutRecord[] = []): Day => ({
+  workout: generateWorkout({
+    profile,
+    location: gym,
+    history,
+    now: NOW,
+    duration: 'default',
+    constraints: { templateId: 'push-arms' },
+  }),
+  constraints: emptyConstraints(),
+  completed: emptyCompleted(),
+  duration: 'default',
+});
+
+function run(day: Day, trigger: RecalibrationTrigger, history: WorkoutRecord[] = []): Day {
+  const result = recalibrate({
+    trigger,
+    workout: day.workout,
+    completed: day.completed,
+    lockedEntryIds: [],
+    currentEntryId: day.completed.currentEntryId,
+    duration: day.duration,
+    profile,
+    location: gym,
+    history,
+    constraints: day.constraints,
+    reason: 'test',
+    timestamp: NOW,
+  });
+  if (!result.ok) throw new Error(result.error);
+  return {
+    workout: result.workout,
+    constraints: result.constraints,
+    completed: day.completed,
+    duration: result.duration,
+    result,
+  };
+}
+
+const working = (entry: WorkoutEntry) => entry.sets.filter((set) => set.kind === 'working');
+const chest = (entry: WorkoutEntry) =>
+  requireExercise(entry.exerciseId).primaryMuscles.includes('chest');
+const byId = (workout: GeneratedWorkout) =>
+  new Map(allEntries(workout.blocks).map((entry) => [entry.id, entry]));
+
+/** The first working set of an entry logged at its targets; it becomes the lift in front. */
+function logFirst(day: Day, entry: WorkoutEntry): Day {
+  const first = working(entry)[0]!;
+  return {
+    ...day,
+    completed: {
+      startedAt: NOW,
+      elapsedSeconds: 6 * 60,
+      currentEntryId: entry.id,
+      sets: entry.sets
+        .filter((set) => set.index <= first.index)
+        .map((set) => ({
+          entryId: entry.id,
+          exerciseId: entry.exerciseId,
+          setIndex: set.index,
+          kind: set.kind,
+          reps: set.targetReps[0],
+          weight: set.targetWeight,
+          rir: set.targetRir,
+          completedAt: NOW,
+        })),
+    },
+  };
+}
+
+/**
+ * Each chest lift a set fewer above its floor and a rep more in reserve at its load, a rep fewer
+ * (the first review of Maintenance 33: the loads came down); every other as planned.
+ */
+function expectLighterChest(before: GeneratedWorkout, after: GeneratedWorkout) {
+  const was = byId(before);
+  let eased = 0;
+  for (const entry of allEntries(after.blocks)) {
+    const plan = was.get(entry.id)!;
+    if (!chest(entry)) {
+      expect(working(entry), entry.exerciseId).toEqual(working(plan));
+      continue;
+    }
+    const count = working(plan).length;
+    expect(working(entry), entry.exerciseId).toHaveLength(
+      count > setFloor(entry.role) ? count - 1 : count,
+    );
+    working(entry).forEach((set, at) => {
+      const asked = working(plan)[at]!;
+      expect(set.targetWeight).toBe(asked.targetWeight);
+      expect(set.targetRir).toBe(Math.min(4, asked.targetRir + 1));
+      if (set.targetRir > asked.targetRir) {
+        expect(set.targetReps).toEqual([
+          Math.max(1, asked.targetReps[0] - 1),
+          asked.targetReps[1] - 1,
+        ]);
+      }
+    });
+    eased += 1;
+  }
+  expect(eased).toBeGreaterThanOrEqual(2);
+}
+
+describe('lighter today for a muscle the "too soon" card names', () => {
+  it('eases the chest’s lifts before the start, and says so', () => {
+    const day = plan();
+    const light = run(day, { type: 'lighter', muscle: 'chest' });
+    expect(light.constraints.lighter).toEqual(['chest']);
+    expectLighterChest(day.workout, light.workout);
+    expect(light.result!.summary.headline).toMatch(/^Lighter today for the chest: /);
+    const bench = allEntries(light.workout.blocks).find(chest)!;
+    expect(bench.progression?.evidence[0]).toMatch(/^Lighter today for the chest: a set fewer/);
+  });
+
+  it('holds through a rebuild of the rest, and a second tap changes nothing', () => {
+    const light = run(plan(), { type: 'lighter', muscle: 'chest' });
+    const harder = run(light, { type: 'intensity', direction: 'harder' });
+    const plainHarder = run(plan(), { type: 'intensity', direction: 'harder' });
+    expectLighterChest(plainHarder.workout, harder.workout);
+    const again = run(light, { type: 'lighter', muscle: 'chest' });
+    expect(again.result!.summary.headline).toBe(
+      'Lighter today for the chest: nothing left to lighten.',
+    );
+    expect(again.workout.blocks).toEqual(light.workout.blocks);
+  });
+
+  it('eases a lift under way on its sets still to come, for good', () => {
+    const day = plan();
+    const bench = allEntries(day.workout.blocks).find(chest)!;
+    const started = logFirst(day, bench);
+    const light = run(started, { type: 'lighter', muscle: 'chest' });
+    const under = byId(light.workout).get(bench.id)!;
+    const done = working(bench)[0]!;
+    // The set done is as it was; the sets still to come a rep more in reserve at their loads, one
+    // fewer.
+    expect(working(under)[0]).toEqual(done);
+    expect(working(under)).toHaveLength(Math.max(setFloor(bench.role), working(bench).length - 1));
+    working(under)
+      .slice(1)
+      .forEach((set, at) => {
+        expect(set.targetRir).toBe(done.targetRir + 1);
+        expect(set.targetWeight).toBe(working(bench)[at + 1]!.targetWeight);
+      });
+    expect(under.eased?.kept).toBe(true);
+    // A rebuild after it never gives it back.
+    const shorter = run(light, { type: 'duration', choice: 45 });
+    expect(working(byId(shorter.workout).get(bench.id)!)).toEqual(working(under));
+  });
+
+  it('never goes on top of a hard start’s own ease: the larger of each part', () => {
+    const day = plan();
+    const [first, second] = allEntries(day.workout.blocks);
+    const started = logFirst(day, first!);
+    const hard = run(started, {
+      type: 'bad-start',
+      low: true,
+      lifts: [first!.exerciseId, second!.exerciseId],
+    });
+    const both = run(hard, { type: 'lighter', muscle: 'chest' });
+    for (const entry of allEntries(both.workout.blocks)) {
+      if (entry.id === first!.id) continue;
+      const plan = byId(day.workout).get(entry.id)!;
+      const count = working(plan).length;
+      expect(working(entry).length, entry.exerciseId).toBeGreaterThanOrEqual(
+        Math.min(count, Math.max(setFloor(entry.role), count - 1)),
+      );
+      working(entry).forEach((set, at) =>
+        expect(set.targetRir).toBeLessThanOrEqual(Math.min(4, working(plan)[at]!.targetRir + 1)),
+      );
+    }
+    // The hard start taken back, the chest stays lighter: today's other settings stay.
+    const back = run(both, {
+      type: 'bad-start',
+      low: false,
+      lifts: [first!.exerciseId, second!.exerciseId],
+    });
+    expect(back.result!.summary.headline).toMatch(/^Your start no longer falls short/);
+    expect(back.result!.summary.headline).toContain("today's other settings stay");
+  });
+
+  it('hands its ease on to a lift swapped in once nothing of it is logged, loads kept', () => {
+    // Heavy enough that the place has a load a step lighter for a rep more in reserve, which the
+    // ease does not take.
+    const lifted = (exerciseId: string, daysAgo: number, weight: number): WorkoutRecord => {
+      const when = new Date(Date.parse(NOW) - daysAgo * 86_400_000).toISOString();
+      const done = record(0, exerciseId, [
+        [8, weight, 2],
+        [8, weight, 2],
+        [8, weight, 2],
+      ]);
+      return {
+        ...done,
+        id: `${exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+        entries: done.entries.map((entry) => ({
+          ...entry,
+          sets: entry.sets.map((set) => ({ ...set, targetReps: [6, 10], targetWeight: weight })),
+        })),
+      };
+    };
+    const history = [7, 3].flatMap((daysAgo) => [
+      lifted('barbell-bench-press', daysAgo, 185),
+      lifted('close-grip-bench-press', daysAgo + 1, 155),
+    ]);
+    const day = plan(history);
+    const bench = allEntries(day.workout.blocks).find(chest)!;
+    const light = run(logFirst(day, bench), { type: 'lighter', muscle: 'chest' }, history);
+    // The set taken back: nothing of the lift is logged, and it keeps the ease.
+    const undone = { ...light, completed: { ...light.completed, sets: [] } };
+    const swap = {
+      type: 'replace',
+      entryId: bench.id,
+      exerciseId: 'close-grip-bench-press',
+    } as const;
+    const eased = byId(run(undone, swap, history).workout).get(bench.id)!;
+    const asPlanned = byId(run(day, swap, history).workout).get(bench.id)!;
+    expect(working(asPlanned)[0]!.targetWeight).toBeGreaterThanOrEqual(135);
+    expect(eased.exerciseId).toBe('close-grip-bench-press');
+    expect(eased.progression?.evidence[0]).toMatch(/^Lighter today for the chest: /);
+    expect(working(eased).length).toBeLessThan(working(asPlanned).length);
+    working(eased).forEach((set, at) => {
+      const was = working(asPlanned)[at]!;
+      expect(set.targetWeight).toBe(was.targetWeight);
+      expect(set.targetRir).toBe(Math.min(4, was.targetRir + 1));
+    });
+  });
+
+  it('is today’s: a saved copy has the plan back', () => {
+    const day = plan();
+    const bench = allEntries(day.workout.blocks).find(chest)!;
+    const light = run(logFirst(day, bench), { type: 'lighter', muscle: 'chest' });
+    const copy = planUnderTheEase(light.workout);
+    for (const entry of allEntries(copy.blocks)) {
+      expect(working(entry), entry.exerciseId).toEqual(working(byId(day.workout).get(entry.id)!));
+      expect(entry.eased).toBeUndefined();
+    }
+  });
+});
diff --git a/src/engine/recalibration/lighterKeepsLoads.test.ts b/src/engine/recalibration/lighterKeepsLoads.test.ts
