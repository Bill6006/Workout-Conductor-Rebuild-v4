+    sorted.length < FIRST_SET.RESTED_LEAST
+      ? null
+      : sorted.length % 2 === 1
+        ? (sorted[middle] as number)
+        : ((sorted[middle - 1] as number) + (sorted[middle] as number)) / 2;
+  index.baselines.set(key, baseline);
+  return baseline;
+}
+
+/**
