diff --git a/src/review-m33c/checkInAfterStartOutlivesStart.store.test.ts b/src/review-m33c/checkInAfterStartOutlivesStart.store.test.ts
new file mode 100644
index 0000000..349f0af
--- /dev/null
+++ b/src/review-m33c/checkInAfterStartOutlivesStart.store.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, it, vi } from 'vitest';
+import { getExercise } from '../catalog/exercises/catalog';
+import { isHold } from '../catalog/exercises/exerciseSchema';
+import type { AppStore } from '../core/state/appStore';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import { topSetRir } from '../engine/progression/backOffs';
+import { prescribeFor } from '../engine/progression/roles';
+import { ESTIMATED_MODES } from '../engine/recalibration/recalibrate';
+import { allEntries, type WorkoutEntry } from '../engine/workout/types';
+import { record } from '../test/records';
+import { TEST_NOW, createTestStore } from '../test/testStore';
+
+/**
+ * The third adversarial review of Maintenance 33: the mark of a check-in told under a hard start
+ * outlives the hard start, and a later reading of the start ignores the check-in.
+ *
+ * Steps: the lifter's first two lifts (targets from their own log) each fall three reps of capacity
+ * short: a hard start, and the rest is eased. They check in: energy "Exhausted" (1) and sleep "Poor"
+ * (1), two items clearly worse; the summary says "Checked in: the rest stays eased for the hard
+ * start." They then see the first lift's set was logged on the wrong exercise and delete it: the
+ * start no longer reads short, and the ease comes off. Their third lift's first set then falls
+ * three reps of capacity short.
+ *
+ * The rule: decision 1: two items clearly worse "lower what the day's first sets are expected to
+ * do" (the report), a rep more short of a lift before it reads as a hard start (`StartContext`); the
+ * second review's mark is for a hard start in force: "The day's check-in was told with a hard start
+ * in force: the start's reading reads none of it, so it never takes the hard start back"
+ * (`SessionConstraints.checkInAfterStart`), "Absent ... for a check-in told before a hard start".
+ * Once the start is read afresh with no hard start in force, the check-in stands before it.
+ *
+ * What happens: nothing takes the mark away but a check-in told again with no hard start in force
+ * (`execute`, `'readiness'`): the bad-start trigger that takes the ease off leaves it. So the
+ * start's reading of the second and third lifts still reads no check-in, and their three-rep falls,
+ * which the exhausted, sleepless check-in excuses by a rep, read as a new hard start: the rest is
+ * eased again. Before the second review's fix (80893d4) the check-in was read and the falls were
+ * excused.
+ *
+ * Synthetic data only.
+ */
+
+async function trained(): Promise<AppStore> {
+  const handle = createTestStore({ minOverlayMs: 0 });
+  await handle.store.hydrate();
+  const profile = createDefaultProfile(TEST_NOW);
+  await handle.store.completeOnboarding(
+    {
+      ...profile,
+      bodyweight: 185,
+      schedule: { ...profile.schedule, availableDays: [...profile.schedule.availableDays, 'wed'] },
+    },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const planned = allEntries(handle.store.getSnapshot().session!.workout.blocks);
+  const db = await handle.store.getDatabase();
+  for (const daysAgo of [9, 5]) {
+    const when = new Date(Date.parse(TEST_NOW) - daysAgo * 86_400_000).toISOString();
+    for (const entry of planned) {
+      const working = entry.sets.find((set) => set.kind === 'working');
+      if (!working) continue;
+      const reps = Math.round((working.targetReps[0] + working.targetReps[1]) / 2);
+      await db.put('workouts', {
+        ...record(
+          daysAgo,
+          entry.exerciseId,
+          [
+            [reps, working.targetWeight ?? null, working.targetRir],
+            [reps, working.targetWeight ?? null, working.targetRir],
+          ],
+          working.targetReps,
+          working.targetRir,
+        ),
+        id: `${entry.exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await handle.store.hydrate();
+  await handle.store.setCoachFocus('chest');
+  return handle.store;
+}
+
+const entries = (store: AppStore) => allEntries(store.getSnapshot().session!.workout.blocks);
+
+/** The lifts the start can judge: targets from the log, at most twelve reps to failure asked. */
+function judgeable(store: AppStore): WorkoutEntry[] {
+  return entries(store).filter((entry) => {
+    const exercise = getExercise(entry.exerciseId);
+    const mode = entry.progression?.mode;
+    const set = entry.sets.find((candidate) => candidate.kind === 'working');
+    return (
+      exercise &&
+      !isHold(exercise) &&
+      mode !== undefined &&
+      !ESTIMATED_MODES.has(mode) &&
+      set !== undefined &&
+      set.targetReps[0] + Math.min(set.targetRir, planRir(store, entry)) <= 12
+    );
+  });
+}
+
+function planRir(store: AppStore, entry: WorkoutEntry): number {
+  const exercise = getExercise(entry.exerciseId)!;
+  const { profile, history } = store.getSnapshot();
+  const rir = prescribeFor(exercise, entry.role, profile!, history).rir;
+  const first = entry.sets.find((set) => set.kind === 'working');
+  return first?.tier === 'top' ? topSetRir(rir) : rir;
+}
+
+/** A lift's first working set three reps of capacity under what the plan asked. */
+async function fallShort(store: AppStore, entryId: string) {
+  const entry = entries(store).find((candidate) => candidate.id === entryId)!;
+  store.skipWarmup(entry.id);
+  const set = entry.sets.find((candidate) => candidate.kind === 'working')!;
+  const reserve = Math.min(set.targetRir, planRir(store, entry));
+  const reps = set.targetReps[0] + reserve - 3;
+  await store.logSet(entry.id, set.index, { weight: set.targetWeight, reps, rir: 0 });
+  return set.index;
+}
+
+describe('a check-in told under a hard start', () => {
+  it('is read again once the hard start is gone', async () => {
+    const store = await trained();
+    store.startWorkout();
+    const [first, second, third] = judgeable(store);
+    const firstSet = await fallShort(store, first!.id);
+    await fallShort(store, second!.id);
+    expect(store.getSnapshot().session!.constraints.badStart).toBe(true);
+
+    await store.recalibrate({
+      type: 'readiness',
+      readiness: {
+        energy: 1,
+        soreness: 2,
+        sleep: 1,
+        motivation: 3,
+        jointDiscomfort: [],
+        timePressure: false,
+      },
+    });
+    expect(store.getSnapshot().session!.lastSummary?.headline).toBe(
+      'Checked in: the rest stays eased for the hard start.',
+    );
+
+    // The first lift's set was logged on the wrong exercise: deleted, the start no longer reads short.
+    store.deleteLoggedSet(first!.id, firstSet);
+    await vi.waitFor(() => expect(store.getSnapshot().session!.constraints.badStart).toBeFalsy());
+
+    // The third lift falls three short, a rep inside what the check-in excuses.
+    await fallShort(store, third!.id);
+    expect(store.getSnapshot().session!.constraints.badStart).toBeFalsy();
+  });
+});
diff --git a/src/review-m33c/feverRestDayHeavierOffer.test.ts b/src/review-m33c/feverRestDayHeavierOffer.test.ts
new file mode 100644
index 0000000..91f1df7
--- /dev/null
+++ b/src/review-m33c/feverRestDayHeavierOffer.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from 'vitest';
+import { conductCoach, type CoachInput } from '../engine/coach/coachConductor';
+import { REST_TODAY } from '../engine/readiness/checkIn';
+import { emptyCompleted, emptyConstraints } from '../engine/recalibration/recalibrate';
+import type { Readiness } from '../engine/recalibration/types';
+import { interpretFatigue } from '../engine/recovery/fatigue';
+import type { StallDiagnosis } from '../engine/strategy/plateau';
+import { gym, plan, profileOf, trained } from '../test/backOffs';
+import { RECORD_NOW } from '../test/records';
+
+/**
+ * The third adversarial review of Maintenance 33: on a fever's rest day the coach still offers to
+ * take a lift heavier today.
+ *
+ * Steps: a hybrid lifter whose dumbbell shoulder press has stalled with its sets ending easy (the
+ * plateau engine's "undershooting" diagnosis: three exposures at the same estimated max, the sets
+ * ending well short of the prescribed effort). Before starting today's push day they check in
+ * "Fever or aches". Today shows the rest day (`REST_TODAY`, no Start) and the coach card beneath it.
+ *
+ * The rule: the readiness model's illness gate (proposal part 2: "With fever or whole-body symptoms,
+ * no session"; `REST_TODAY`: "Fever or aches all over: rest today, and train again once they have
+ * gone"); the second review's fix: "A rest day adds no work" (`restToday`: "a rest day, with no
+ * workout to add to"), whose own test (feverRestDayCoachOffer.store.test.ts) asks that the card on
+ * the rest day carry no change to today's workout at all.
+ *
+ * What happens: the fix holds back only the offers `addsWork` names (a set, a drop set, a range
+ * with a set more, an exercise). The plateau card for the undershooting shoulder press still wins,
+ * with "Work to the prescribed effort, or take the next load step now." and the button "Take 40 lb
+ * today", a heavier load offered on the screen that says to rest today, for a workout that cannot
+ * be started. Nor does the filter hold back a "target-weight" offer of a strategy card, or a
+ * "rep-range" with no set more ("Aim one rep higher", a new rep range for two weeks). With fatigue
+ * high, the card is "Recovery first today" with "Fit to 45 min at held loads": a 45-minute workout
+ * offered for the rest day. Both fail before the second review's fix too (80893d4).
+ *
+ * Synthetic data only.
+ */
+
+const profile = profileOf('hybrid');
+
+const fever: Readiness = {
+  energy: 3,
+  soreness: 2,
+  sleep: 3,
+  motivation: 3,
+  jointDiscomfort: [],
+  timePressure: false,
+  illness: 'body',
+};
+
+const stall: StallDiagnosis = {
+  exerciseId: 'dumbbell-shoulder-press',
+  kind: 'undershooting',
+  exposures: 3,
+  totalExposures: 4,
+  baselineE1rm: 44,
+  latestE1rm: 44,
+  effortMet: 0,
+  effortUnknown: 0,
+  firstDate: RECORD_NOW,
+  lastDate: RECORD_NOW,
+  why: ['Three exposures at the same estimated max, the sets ending easy.'],
+};
+
+function day(readiness: Readiness | null, high = false): CoachInput {
+  const history = trained();
+  const fatigue = interpretFatigue(history, RECORD_NOW);
+  return {
+    workout: plan(history, profile),
+    status: 'preview',
+    duration: 'default',
+    completed: emptyCompleted(),
+    constraints: { ...emptyConstraints(), readiness },
+    profile,
+    history,
+    now: RECORD_NOW,
+    fatigue: high
+      ? {
+          ...fatigue,
+          level: 'high',
+          score: 5,
+          evidence: ['2 of the last 3 sessions rated too hard.'],
+        }
+      : fatigue,
+    strategy: [],
+    stalls: [stall],
+    lastExportAt: RECORD_NOW,
+    workoutCount: 6,
+    location: gym,
+  };
+}
+
+describe('the coach on a fever rest day', () => {
+  it('offers no heavier load for today', () => {
+    // The card on an ordinary day: the next load step, a tap away.
+    const ordinary = conductCoach(day(null))?.signal;
+    expect(ordinary?.action?.label).toBe('Take 40 lb today');
+
+    const rest = conductCoach(day(fever))?.signal;
+    expect(REST_TODAY).toMatch(/rest today/);
+    expect(rest?.action?.kind === 'recalibrate' ? rest.action.trigger.type : null).toBeNull();
+    expect(rest?.why.join(' ') ?? '').not.toMatch(/take the next load step now/);
+  });
+
+  it('offers no workout for today with fatigue high', () => {
+    // An ordinary day with fatigue high: today's workout fitted to 45 minutes at held loads.
+    const ordinary = conductCoach(day(null, true))?.signal;
+    expect(ordinary?.action?.label).toBe('Fit to 45 min at held loads');
+
+    const rest = conductCoach(day(fever, true))?.signal;
+    expect(rest?.action?.kind === 'recalibrate' ? rest.action.trigger.type : null).toBeNull();
+  });
+});
diff --git a/src/review-m33c/hardStartLighterSwapBack.test.ts b/src/review-m33c/hardStartLighterSwapBack.test.ts
new file mode 100644
index 0000000..3278cd1
--- /dev/null
+++ b/src/review-m33c/hardStartLighterSwapBack.test.ts
@@ -0,0 +1,120 @@
+import { describe, expect, it } from 'vitest';
+import { emptyCompleted } from '../engine/recalibration/recalibrate';
+import type { CompletedSet, CompletedWork } from '../engine/recalibration/types';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../engine/workout/types';
+import { BENCH, DB_BENCH, bench, entryOf, plan, profileOf, run } from '../test/backOffs';
+import { RECORD_NOW } from '../test/records';
+
+/**
+ * The third adversarial review of Maintenance 33: with a hard start in force, "Lighter" on a lift
+ * under way is still lost when the lifter swaps the lift and swaps back to it.
+ *
+ * Steps: a hybrid lifter's push day. They lift every working set of the bench press, then the first
+ * set of the incline dumbbell press (three sets of 6-10 at 1 in reserve, 45 lb): the two lifts read
+ * as a hard start, and the rest is eased; the incline press, under way before it, keeps its own sets
+ * (item 42). The "too soon" card names the upper chest, and they tap "Lighter for the upper chest":
+ * the incline press's sets still to come become one at 45 lb for 5-9 at 2. Its bench is taken, so
+ * they swap to the dumbbell bench press, and when it is free they swap back to the incline press.
+ * Without the hard start the same steps bring the incline press back eased (the second review's
+ * fix).
+ *
+ * The rule: the lighter option takes a lift under way "on its sets still to come, for good: the
+ * workout never gives it back" (recalibrate.ts, `lightenUnderWay`); the second review's finding and
+ * fix for the same steps without a hard start ("swapped back, its sets came back at the plan's
+ * reserve with 'Lighter' still in force for its muscle"; the report: "'Lighter' ... comes back eased
+ * on a lift swapped back"); the lighter option "takes the hard start's ease too, never on top of
+ * one: the larger of each part" (`easeTheRest`), so with both in force the lift is eased at least as
+ * "Lighter" eased it.
+ *
+ * What happens: `swapBack` eases what the lift owes only "with no hard start's ease over it"
+ * (`request.constraints.badStart ? [] : request.constraints.lighter`), and the hard start's own ease
+ * never lands on a block begun (`easeTheRest`). So the incline press comes back at 45 lb for 6-10 at
+ * 1, the plan's, eased by neither, with "Lighter" for the upper chest and the hard start both in
+ * force. It fails before the second review's fix too (80893d4), where no swap back kept "Lighter".
+ *
+ * Synthetic data only.
+ */
+
+const profile = profileOf('hybrid');
+const INCLINE = 'incline-dumbbell-press';
+
+const working = (entry: WorkoutEntry) => entry.sets.filter((set) => set.kind === 'working');
+const toCome = (entry: WorkoutEntry, completed: CompletedWork) =>
+  working(entry)
+    .filter(
+      (set) =>
+        !completed.sets.some((done) => done.entryId === entry.id && done.setIndex === set.index),
+    )
+    .map((set) => [set.targetWeight, set.targetReps, set.targetRir]);
+
+const live = (workout: GeneratedWorkout, exerciseId: string) =>
+  allEntries(workout.blocks).find(
+    (entry) => entry.exerciseId === exerciseId && entry.stopped === undefined,
+  )!;
+
+/** Working sets logged as asked, a minute apart. */
+function logged(sets: { entry: WorkoutEntry; index: number }[]): CompletedWork {
+  const done: CompletedSet[] = sets.map(({ entry, index }, at) => {
+    const set = entry.sets.find((each) => each.index === index)!;
+    return {
+      entryId: entry.id,
+      exerciseId: entry.exerciseId,
+      setIndex: index,
+      kind: 'working',
+      reps: set.targetReps[0],
+      weight: set.targetWeight,
+      rir: set.targetRir,
+      completedAt: new Date(Date.parse(RECORD_NOW) + at * 60_000).toISOString(),
+    };
+  });
+  return {
+    ...emptyCompleted(),
+    startedAt: RECORD_NOW,
+    currentEntryId: sets.at(-1)!.entry.id,
+    sets: done,
+  };
+}
+
+describe('"Lighter" under a hard start, swapped and swapped back', () => {
+  it('keeps the lighter sets still to come', () => {
+    const workout = plan(undefined, profile);
+    const press = bench(workout);
+    const incline = entryOf(workout, INCLINE);
+    const completed = logged([
+      ...working(press).map((set) => ({ entry: press, index: set.index })),
+      { entry: incline, index: working(incline)[0]!.index },
+    ]);
+
+    const hard = run({ type: 'bad-start', low: true, lifts: [BENCH, INCLINE] }, workout, {
+      completed,
+      profile,
+    });
+    expect(hard.constraints.badStart).toBe(true);
+    // Under way before the hard start, the incline press keeps its sets.
+    expect(toCome(live(hard.workout, INCLINE), completed)).toEqual([
+      [45, [6, 10], 1],
+      [45, [6, 10], 1],
+    ]);
+    const lighter = run({ type: 'lighter', muscle: 'upper-chest' }, hard.workout, {
+      completed,
+      profile,
+      constraints: hard.constraints,
+    });
+    const eased = toCome(live(lighter.workout, INCLINE), completed);
+    expect(eased).toEqual([[45, [5, 9], 2]]);
+
+    const swapped = run(
+      { type: 'replace', entryId: live(lighter.workout, INCLINE).id, exerciseId: DB_BENCH },
+      lighter.workout,
+      { completed, profile, constraints: lighter.constraints },
+    );
+    const back = run(
+      { type: 'replace', entryId: live(swapped.workout, DB_BENCH).id, exerciseId: INCLINE },
+      swapped.workout,
+      { completed, profile, constraints: swapped.constraints },
+    );
+    expect(back.constraints.badStart).toBe(true);
+    expect(back.constraints.lighter).toEqual(['upper-chest']);
+    expect(toCome(live(back.workout, INCLINE), completed)).toEqual(eased);
+  });
+});
diff --git a/src/review-m33c/illnessTakenBackLiftUnderWay.test.ts b/src/review-m33c/illnessTakenBackLiftUnderWay.test.ts
new file mode 100644
index 0000000..62f1cf0
--- /dev/null
+++ b/src/review-m33c/illnessTakenBackLiftUnderWay.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from 'vitest';
+import { emptyCompleted } from '../engine/recalibration/recalibrate';
+import type { CompletedWork, Readiness } from '../engine/recalibration/types';
+import type { WorkoutEntry } from '../engine/workout/types';
+import { bench, plan, profileOf, run, shape } from '../test/backOffs';
+import { RECORD_NOW } from '../test/records';
+
+/**
+ * The third adversarial review of Maintenance 33: an illness taken back leaves the lift in front of
+ * the lifter at the illness's floor, under "Planned effort back".
+ *
+ * Steps: a hybrid lifter's push day, the bench press first: its top set asks 190 lb for 4-6 at 1 in
+ * reserve, then three back-offs at 180 lb for 4-6 at 2. They log both warm-up sets (no working set
+ * yet) and check in "Head cold": the top set becomes 190 lb for 3-5 at 2, every other lift 2 or more
+ * short of failure. A moment later they see they tapped the wrong answer and update the check-in to
+ * "Unwell: No". In the second case the first answer was "Fever or aches".
+ *
+ * The rule: the check-in's own rule for one that takes back an earlier one ("A check-in that takes
+ * back an earlier one's adjustment brings the full workout back (Maintenance 24); kept as it was,
+ * the plan would stay cut while the check-in says otherwise", recalibrate.ts, `execute`); Today's
+ * rest day: "the plan is kept, so a check-in changed back gives it again" (TodayScreen.tsx); and the
+ * summary itself: "Planned effort back". The illness's floor is the day's ("every set 2 or more
+ * short of failure for the head cold"), not the lift's.
+ *
+ * What happens: since the second review's fix, `heldToTheDay` rewrites a begun lift's sets still to
+ * come to the floor (a rep fewer at the same load) and keeps no record of what they were; the
+ * rebuild keeps a begun lift's sets as they are (`keptEntries`), and with no floor `heldToTheDay`
+ * does nothing. So the bench's top set, not yet lifted, stays at 190 lb for 3-5 at 2 for the rest
+ * of the workout, while every other lift has its planned effort back and the summary says
+ * "Planned effort back: 6 exercises adjusted." Before the second review's fix (80893d4) the
+ * illness never touched a begun lift's working sets, and taking it back left the top set as
+ * planned.
+ *
+ * Synthetic data only.
+ */
+
+const profile = profileOf('hybrid');
+
+const checkIn = (illness?: NonNullable<Readiness['illness']>): Readiness => ({
+  energy: 3,
+  soreness: 2,
+  sleep: 3,
+  motivation: 3,
+  jointDiscomfort: [],
+  timePressure: false,
+  ...(illness ? { illness } : {}),
+});
+
+/** Every warm-up set of a lift logged: the lift is under way, no working set lifted. */
+function warmedUp(entry: WorkoutEntry): CompletedWork {
+  return {
+    ...emptyCompleted(),
+    startedAt: RECORD_NOW,
+    currentEntryId: entry.id,
+    sets: entry.sets
+      .filter((set) => set.kind === 'warmup')
+      .map((set) => ({
+        entryId: entry.id,
+        exerciseId: entry.exerciseId,
+        setIndex: set.index,
+        kind: 'warmup' as const,
+        reps: 5,
+        weight: set.targetWeight,
+        rir: 5,
+        completedAt: RECORD_NOW,
+      })),
+  };
+}
+
+const topSet = (entry: WorkoutEntry) => {
+  const top = entry.sets.find((set) => set.tier === 'top')!;
+  return [top.targetWeight, top.targetReps, top.targetRir];
+};
+
+describe('an illness taken back with a lift under way', () => {
+  for (const illness of ['head', 'body'] as const) {
+    it(`gives the top set not yet lifted its planned effort back (${illness})`, () => {
+      const workout = plan(undefined, profile);
+      const planned = bench(workout);
+      expect(topSet(planned)).toEqual([190, [4, 6], 1]);
+      const completed = warmedUp(planned);
+
+      // The illness holds it at the day's floor (since the second review's fix: 190 lb for 3-5 at 2).
+      const ill = run({ type: 'readiness', readiness: checkIn(illness) }, workout, {
+        completed,
+        profile,
+      });
+
+      const well = run({ type: 'readiness', readiness: checkIn() }, ill.workout, {
+        completed,
+        profile,
+        constraints: ill.constraints,
+      });
+      expect(well.summary.headline).toMatch(/^Planned effort back/);
+      // Nothing of the top set was lifted: with the illness gone it asks what the plan asks.
+      expect(topSet(bench(well.workout))).toEqual([190, [4, 6], 1]);
+      expect(shape(bench(well.workout))).toEqual(shape(planned));
+    });
+  }
+});
diff --git a/src/review-m33c/learnedRecoveryReadLog.screens.test.tsx b/src/review-m33c/learnedRecoveryReadLog.screens.test.tsx
new file mode 100644
index 0000000..617ab10
--- /dev/null
+++ b/src/review-m33c/learnedRecoveryReadLog.screens.test.tsx
@@ -0,0 +1,119 @@
+import { render, screen } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import type { WorkoutRecord } from '../core/validation/workoutRecord';
+import { learnedWindows } from '../engine/recovery/recovery';
+import { LearnedValues } from '../features/settings/LearnedValues';
+import { Providers, createTestStore } from '../test/testStore';
+
+/**
+ * The third adversarial review of Maintenance 33: the learned page's "Your recovery" reads the log
+ * as logged, while every window the app uses reads it as the rules read it, through the lifter's
+ * reserve checks.
+ *
+ * Steps: a hybrid lifter who opted in to reserve checks. Four weekly cable curl sessions end in a
+ * check: 10 reps judged 2 in reserve, 14 in all, an error of 2 reps, so every covered reserve is
+ * read 2 higher. Then 18 more cable curl sessions, three sets of 10 at 40 lb logged at 2 in reserve,
+ * a day or two and a half apart, each first set as good as the last. They open Settings, What the
+ * app has learned.
+ *
+ * The rule: the windows are learned from "each session with hard sets for a muscle" (the learned
+ * page's own words); every engine reads the log as the rules read it (`readHistory`: "the log as the
+ * rules read it ... every engine reads it"; the coach, the Plan screen, the hard start and the
+ * completion read the windows from it); the report: "The learned page shows each muscle its sessions
+ * moved, with a reset." The page shows what the windows in use learned.
+ *
+ * What happens: `LearnedValues` gives `learnedSections` the log as logged (`state.history`), and its
+ * recovery section reads `learnedWindows` from it. There the curls are hard work (2 in reserve) and
+ * the biceps' window learned 12 h shorter: "Biceps: 12 h shorter, from 8 sessions back early and 11
+ * sessions rested." The windows in use read the same sets at 4 in reserve: light work, no window, nothing
+ * learned for the biceps (`learnedWindows(readHistory)` is empty). The page tells the lifter of a
+ * shorter biceps window no screen applies.
+ *
+ * Synthetic data only.
+ */
+
+const NOW = '2026-09-30T12:00:00.000Z';
+const HOUR = 3_600_000;
+
+function curls(at: number, id: string, check: boolean): WorkoutRecord {
+  const when = new Date(at).toISOString();
+  const set = {
+    kind: 'working' as const,
+    reps: 10,
+    weight: 40,
+    rir: 2,
+    completed: true,
+    targetReps: [10, 15] as [number, number],
+    targetRir: 2,
+    targetWeight: 40,
+    loggedAt: when,
+  };
+  return {
+    id,
+    startedAt: when,
+    completedAt: when,
+    locationId: 'gym',
+    templateId: 'pull-arms',
+    endedEarly: false,
+    rating: null,
+    skippedExerciseIds: [],
+    painJoints: [],
+    readiness: null,
+    prs: [],
+    entries: [
+      {
+        exerciseId: 'cable-curl',
+        plannedSets: 3,
+        sets: [
+          { ...set, setIndex: 0 },
+          { ...set, setIndex: 1 },
+          check
+            ? { ...set, setIndex: 2, reserveCheck: { total: 14, style: 'hybrid' } }
+            : { ...set, setIndex: 2 },
+        ],
+      },
+    ],
+  };
+}
+
+function history(): WorkoutRecord[] {
+  const records: WorkoutRecord[] = [];
+  let at = Date.parse(NOW) - 60 * 24 * HOUR;
+  for (let week = 0; week < 4; week += 1) {
+    records.push(curls(at, `check-${week}`, true));
+    at += 7 * 24 * HOUR;
+  }
+  for (let session = 0; session < 18; session += 1) {
+    at += (session % 2 === 0 ? 24 : 60) * HOUR;
+    records.push(curls(at, `curls-${session}`, false));
+  }
+  return records;
+}
+
+describe('the learned page’s recovery windows', () => {
+  it('shows what the windows in use learned', async () => {
+    const { store } = createTestStore({ now: () => NOW });
+    await store.hydrate();
+    await store.completeOnboarding(
+      { ...createDefaultProfile(NOW), programStyle: 'hybrid', reserveCheck: true },
+      createDefaultLocations({ gymAccess: true }, NOW),
+    );
+    const db = await store.getDatabase();
+    for (const record of history()) await db.put('workouts', record);
+    await store.hydrate();
+
+    const { readHistory, learnedResets } = store.getSnapshot();
+    // The windows every screen reads learned nothing for the biceps: the curls are light work there.
+    expect(learnedWindows(readHistory, learnedResets).get('biceps')).toBeUndefined();
+
+    render(
+      <Providers store={store}>
+        <LearnedValues />
+      </Providers>,
+    );
+    const recovery = screen.getByTestId('learned-recovery');
+    expect(recovery.textContent ?? '').not.toMatch(/Biceps: 12 h shorter/);
+  });
+});
diff --git a/src/review-m33c/lighterFirstSetHardStart.store.test.ts b/src/review-m33c/lighterFirstSetHardStart.store.test.ts
new file mode 100644
index 0000000..0c3bc22
--- /dev/null
+++ b/src/review-m33c/lighterFirstSetHardStart.store.test.ts
@@ -0,0 +1,149 @@
+import { describe, expect, it } from 'vitest';
+import { getExercise } from '../catalog/exercises/catalog';
+import { isHold } from '../catalog/exercises/exerciseSchema';
+import type { AppStore } from '../core/state/appStore';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import { topSetRir } from '../engine/progression/backOffs';
+import { prescribeFor } from '../engine/progression/roles';
+import { ESTIMATED_MODES } from '../engine/recalibration/recalibrate';
+import { allEntries, type WorkoutEntry } from '../engine/workout/types';
+import { record } from '../test/records';
+import { TEST_NOW, createTestStore } from '../test/testStore';
+
+/**
+ * The third adversarial review of Maintenance 33: with "Lighter" in force, a first set three reps of
+ * capacity short of what it asked reads two short, and the hard start is missed.
+ *
+ * Steps: a lifter whose first two lifts take their targets from their own log (the bench press, then
+ * the incline dumbbell press). Before starting, they tap "Lighter for the chest" (the "too soon"
+ * card's option): the bench press keeps its loads and asks a rep fewer at a rep more in reserve.
+ * Each lift's first working set then falls three reps of capacity short of what it asked: the bench
+ * press at its load, its eased reps plus its eased reserve less three, with none left; the incline
+ * press likewise (not eased). The control: the same two falls with no "Lighter".
+ *
+ * The rule: the hard start (item 42): the first set of each of the first two lifts that can be
+ * judged, "both well short" (`SHORT_BY_REPS`: three reps of capacity), eases the rest; `shortOf`:
+ * "What the plan asked: no reserve the day's settings added (a check-in, easier, the hard start's
+ * own), whenever they were applied, is counted against the set; the load may not have come down
+ * with it"; and the expectation is lowered by "One step, never two" (`expectsLess`), by the
+ * check-in or the windows only. "Lighter keeps the loads: a set fewer and a rep more in reserve on
+ * its lifts today": at the same load a rep fewer at a rep more in reserve asks the same reps to
+ * failure as the plan.
+ *
+ * What happens: `shortOf` reads the plan's reserve (`Math.min(set.targetRir, planRir)`) against the
+ * eased set's reps (`set.targetReps[0]`): the rep "Lighter" took off the range is counted as a rep
+ * the lifter need not have had, so a set three short of both the plan's ask and the eased ask reads
+ * two short, and no hard start is called; without "Lighter" the same fall at the same load is one.
+ * The same holds for a set the second review's `heldToTheDay` eases at its load on a head-cold day.
+ * It fails before the second review's fix too (80893d4): "Lighter" kept the loads since the first.
+ *
+ * Synthetic data only.
+ */
+
+async function trained(): Promise<AppStore> {
+  const handle = createTestStore({ minOverlayMs: 0 });
+  await handle.store.hydrate();
+  const profile = createDefaultProfile(TEST_NOW);
+  await handle.store.completeOnboarding(
+    {
+      ...profile,
+      bodyweight: 185,
+      schedule: { ...profile.schedule, availableDays: [...profile.schedule.availableDays, 'wed'] },
+    },
+    createDefaultLocations({ gymAccess: true }, TEST_NOW),
+  );
+  const planned = allEntries(handle.store.getSnapshot().session!.workout.blocks);
+  const db = await handle.store.getDatabase();
+  for (const daysAgo of [9, 5]) {
+    const when = new Date(Date.parse(TEST_NOW) - daysAgo * 86_400_000).toISOString();
+    for (const entry of planned) {
+      const working = entry.sets.find((set) => set.kind === 'working');
+      if (!working) continue;
+      const reps = Math.round((working.targetReps[0] + working.targetReps[1]) / 2);
+      await db.put('workouts', {
+        ...record(
+          daysAgo,
+          entry.exerciseId,
+          [
+            [reps, working.targetWeight ?? null, working.targetRir],
+            [reps, working.targetWeight ?? null, working.targetRir],
+          ],
+          working.targetReps,
+          working.targetRir,
+        ),
+        id: `${entry.exerciseId}-${daysAgo}`,
+        startedAt: when,
+        completedAt: when,
+      });
+    }
+  }
+  await handle.store.hydrate();
+  await handle.store.setCoachFocus('chest');
+  return handle.store;
+}
+
+const entries = (store: AppStore) => allEntries(store.getSnapshot().session!.workout.blocks);
+
+function judgeable(store: AppStore): WorkoutEntry[] {
+  return entries(store).filter((entry) => {
+    const exercise = getExercise(entry.exerciseId);
+    const mode = entry.progression?.mode;
+    return (
+      exercise &&
+      !isHold(exercise) &&
+      mode !== undefined &&
+      !ESTIMATED_MODES.has(mode) &&
+      entry.sets.some((set) => set.kind === 'working')
+    );
+  });
+}
+
+function planRir(store: AppStore, entry: WorkoutEntry): number {
+  const exercise = getExercise(entry.exerciseId)!;
+  const { profile, history } = store.getSnapshot();
+  const rir = prescribeFor(exercise, entry.role, profile!, history).rir;
+  const first = entry.sets.find((set) => set.kind === 'working');
+  return first?.tier === 'top' ? topSetRir(rir) : rir;
+}
+
+/**
+ * A lift's first working set three reps of capacity under what it asks at its load: its reps plus
+ * its reserve, as the set shows them, less three, with none left.
+ */
+async function threeShort(store: AppStore, entry: WorkoutEntry) {
+  store.skipWarmup(entry.id);
+  const set = entry.sets.find((candidate) => candidate.kind === 'working')!;
+  const reps = set.targetReps[0] + set.targetRir - 3;
+  await store.logSet(entry.id, set.index, { weight: set.targetWeight, reps, rir: 0 });
+}
+
+describe('the hard start with "Lighter" in force', () => {
+  it('reads a first set three short of what it asked as three short, as without "Lighter"', async () => {
+    // The control: no "Lighter", and the plan's own reserve on each first set.
+    const control = await trained();
+    control.startWorkout();
+    const [first, second] = judgeable(control);
+    expect(first!.exerciseId).toBe('barbell-bench-press');
+    for (const lift of [first!, second!]) {
+      const set = lift.sets.find((candidate) => candidate.kind === 'working')!;
+      expect(set.targetRir).toBe(planRir(control, lift));
+      await threeShort(control, lift);
+    }
+    expect(control.getSnapshot().session!.constraints.badStart).toBe(true);
+
+    const store = await trained();
+    await store.recalibrate({ type: 'lighter', muscle: 'chest' });
+    store.startWorkout();
+    const [bench, incline] = judgeable(store);
+    expect(bench!.exerciseId).toBe('barbell-bench-press');
+    // "Lighter": the same load, a rep fewer at a rep more in reserve: the same reps to failure.
+    const eased = bench!.sets.find((candidate) => candidate.kind === 'working')!;
+    const plain = first!.sets.find((candidate) => candidate.kind === 'working')!;
+    expect(eased.targetWeight).toBe(plain.targetWeight);
+    expect(eased.targetReps[0] + eased.targetRir).toBe(plain.targetReps[0] + plain.targetRir);
+    await threeShort(store, bench!);
+    await threeShort(store, incline!);
+    expect(store.getSnapshot().session!.constraints.badStart).toBe(true);
+  });
+});
diff --git a/src/review-m33c/lighterSwapBackSavedCopy.test.ts b/src/review-m33c/lighterSwapBackSavedCopy.test.ts
new file mode 100644
index 0000000..107eda6
--- /dev/null
+++ b/src/review-m33c/lighterSwapBackSavedCopy.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from 'vitest';
+import { planUnderTheEase } from '../engine/recalibration/recalibrate';
+import type { CompletedWork } from '../engine/recalibration/types';
+import { allEntries, type GeneratedWorkout, type WorkoutEntry } from '../engine/workout/types';
+import { BENCH, DB_BENCH, bench, plan, profileOf, run, shape, topDone } from '../test/backOffs';
+
+/**
+ * The third adversarial review of Maintenance 33: a workout saved after "Lighter", a swap and a swap
+ * back keeps the bench press with its top set alone, and the day's "Lighter today" in its lines.
+ *
+ * Steps: a hybrid lifter's push day: the bench press's top set (190 lb for 4-6 at 1 in reserve) and
+ * three back-offs (180 lb for 4-6 at 2). They log the top set, tap "Lighter for the chest" (the
+ * back-offs still to come become two at 180 lb for 3-5 at 3), swap the bench for the dumbbell bench
+ * press while the bench is taken, swap back when it is free, and save the workout to reuse
+ * ("Save this workout", `saveCurrentWorkout`, which keeps `planUnderTheEase(session.workout)`).
+ * The control: the same steps without "Lighter".
+ *
+ * The rule: the lighter option's ease is today's, and a saved copy gives it back ("Its record is
+ * kept for good: the workout never gives it back, a saved copy does", recalibrate.ts,
+ * `lightenUnderWay`); `planUnderTheEase`: "every lift a hard start eased has back what it had, under
+ * way or not ... A saved workout is a plan for another day, and the ease was today's." Without
+ * "Lighter" the same steps save the bench with its top set and its three back-offs.
+ *
+ * What happens: the second review's fix to `swapBack` records the lift as it stands before what it
+ * owes is put back (`recordOf(stopped, ...)` before `stopped.sets = [...stopped.sets, ...owes]`),
+ * over the record `lightenUnderWay` kept of the whole plan. The saved copy gives that record back:
+ * the bench press with one working set, its top set, and the line "Lighter today for the chest: a
+ * set fewer and a rep more in reserve." first among its reasons, on a plan for another day. Before
+ * the second review's fix (80893d4) the swapped-back bench kept no record, and the copy kept its
+ * sets (at the plan's reserve, the second review's own finding).
+ *
+ * Synthetic data only.
+ */
+
+const profile = profileOf('hybrid');
+
+const live = (workout: GeneratedWorkout, exerciseId: string): WorkoutEntry =>
+  allEntries(workout.blocks).find(
+    (entry) => entry.exerciseId === exerciseId && entry.stopped === undefined,
+  )!;
+
+/** The day's steps, with or without "Lighter", then the saved copy's bench press. */
+function savedBench(lighter: boolean): WorkoutEntry {
+  const workout = plan(undefined, profile);
+  const completed: CompletedWork = topDone(bench(workout), 190);
+  const eased = lighter
+    ? run({ type: 'lighter', muscle: 'chest' }, workout, { completed, profile })
+    : null;
+  const before = eased?.workout ?? workout;
+  const swapped = run(
+    { type: 'replace', entryId: live(before, BENCH).id, exerciseId: DB_BENCH },
+    before,
+    { completed, profile, ...(eased ? { constraints: eased.constraints } : {}) },
+  );
+  const back = run(
+    { type: 'replace', entryId: live(swapped.workout, DB_BENCH).id, exerciseId: BENCH },
+    swapped.workout,
+    { completed, profile, constraints: swapped.constraints },
+  );
+  return live(planUnderTheEase(back.workout), BENCH);
+}
+
+describe('a workout saved after "Lighter" and a swap back', () => {
+  it('keeps the bench press as the plan has it, as the same steps without "Lighter" do', () => {
+    const control = savedBench(false);
+    expect(shape(control)).toEqual([
+      [190, 1, 'top'],
+      [180, 2, 'back-off'],
+      [180, 2, 'back-off'],
+      [180, 2, 'back-off'],
+    ]);
+    const saved = savedBench(true);
+    expect(shape(saved)).toEqual(shape(control));
+    expect(saved.progression?.evidence.join(' ') ?? '').not.toMatch(/Lighter today/);
+  });
+});
