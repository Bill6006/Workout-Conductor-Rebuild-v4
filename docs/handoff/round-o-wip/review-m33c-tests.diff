+import { describe, expect, it } from 'vitest';
+import type { WorkoutRecord } from '../core/validation/workoutRecord';
+import { recoveryWindows } from '../engine/recovery/recovery';
+
+/**
+ * The third adversarial review of Maintenance 33: the long-length adjuster reads the dumbbell fly but
+ * not the cable fly, the fly the plan itself picks on the push day.
+ *
+ * Steps: two sessions of the same chest work at the same reserve, three sets of 12 at 2 in reserve:
+ * one of the Dumbbell Fly, one of the Cable Fly ("Cable Crossover": "Let your arms rise and open
+ * slowly along the same arc until you feel a stretch across your chest").
+ *
+ * The rule: the windows' adjuster for long-length work (recovery-time-course.md: "Eccentric or
+ * long-length (RDL, Nordic, deep fly, overhead extension): +12 h"); recovery.ts `LONG_LENGTH_LIFTS`,
+ * as the second review's fix words it: "the Romanian deadlift, the deep fly, the overhead extension,
+ * and by the same reading the incline curl, each with every implement the catalog has for it"; the
+ * report: "The long-length lifts include every implement of the lifts the research names."
+ *
+ * What happens: the set names `dumbbell-fly` alone of the catalog's three flies (`dumbbell-fly`,
+ * `cable-fly`, `band-fly`, all of the `chest-fly` family), so the same fly on a cable stack windows
+ * the chest 12 h shorter: 36 h after the cable fly against 48 h after the dumbbell fly. (Which flies
+ * load the chest long enough to count is judgement; the fix's own rule is every implement.) It
+ * fails before the second review's fix too (80893d4).
+ *
+ * Synthetic data only.
+ */
+
+const DONE = '2026-09-07T12:00:00.000Z';
+
+function session(exerciseId: string, weight: number): WorkoutRecord {
+  return {
+    id: exerciseId,
+    startedAt: DONE,
+    completedAt: DONE,
+    locationId: 'gym',
+    templateId: null,
+    endedEarly: false,
+    rating: null,
+    skippedExerciseIds: [],
+    painJoints: [],
+    readiness: null,
+    prs: [],
+    entries: [
+      {
+        exerciseId,
+        plannedSets: 3,
+        sets: [0, 1, 2].map((setIndex) => ({
+          kind: 'working' as const,
+          reps: 12,
+          weight,
+          rir: 2,
+          completed: true,
+          setIndex,
+          targetReps: [10, 15] as [number, number],
+          targetRir: 2,
+          targetWeight: weight,
+        })),
+      },
+    ],
+  };
+}
+
+const chest = (record: WorkoutRecord) => recoveryWindows([record], { now: DONE }).get('chest');
+
+describe('long-length work by any of its implements', () => {
+  it('lengthens the chest window after a cable fly as after a dumbbell fly', () => {
+    expect(chest(session('dumbbell-fly', 30))?.reasons).toContain(
+      'work at long lengths: 12 h more',
+    );
+    expect(chest(session('cable-fly', 40))?.hours).toBe(chest(session('dumbbell-fly', 30))?.hours);
+  });
+});
diff --git a/src/review-m33c/midnightRecoveryLine.screens.test.tsx b/src/review-m33c/midnightRecoveryLine.screens.test.tsx
new file mode 100644
index 0000000..70f4dbe
--- /dev/null
+++ b/src/review-m33c/midnightRecoveryLine.screens.test.tsx
@@ -0,0 +1,96 @@
+import { act, render, screen } from '@testing-library/react';
+import { describe, expect, it, vi } from 'vitest';
+import { App } from '../app/App';
+import { createDefaultLocations } from '../core/validation/location';
+import { createDefaultProfile } from '../core/validation/profile';
+import { allEntries } from '../engine/workout/types';
+import { Providers, createTestStore } from '../test/testStore';
+
+const clock = vi.hoisted(() => ({ now: '2026-09-02T23:30:00.000Z' }));
+
+vi.mock('../features/library/useCustomMedia', () => ({ useCustomMedia: () => null }));
+vi.mock('../core/time/clock', async (original) => ({
+  ...(await original<typeof import('../core/time/clock')>()),
+  useNow: () => Date.parse(clock.now),
+  useMomentReached: () => false,
+}));
+
+/**
+ * The third adversarial review of Maintenance 33: a workout that runs past midnight gets one window
+ * on the completion screen and another on the Plan screen a minute later.
+ *
+ * Steps (the device's clock on UTC): Wednesday at 23:30 the lifter checks in with sleep "Poor" (a
+ * short night), starts, and trains the bench press (every working set 5 reps at 185 lb, 2 in
+ * reserve). They finish at 0:20 on Thursday; the completion screen gives the session's recovery
+ * line. A minute later they open Plan, the finished workout still the session.
+ *
+ * The rule: the report: "The windows are read where recovery is said: the Plan screen's balance
+ * ..., the completion screen (each muscle's own window from that session) ... each with the same
+ * day's context"; the first review's fix: "every reader of today's windows reads the same day's
+ * context"; the second review's: "One day context (`dayRecovery`) for every reader of the windows,
+ * the completion with its session's check-in, and a check-in is the day's its session was made on."
+ *
+ * What happens: the two readers apply the second review's day rule differently. `buildCompletion`
+ * passes `dayRecovery` the session's check-in with no `madeAt`, so it is read as today's at 0:20 and
+ * the short night adds 12 h: "Chest and Triceps about 48 h". The Plan screen passes the session's
+ * `createdAt` (Wednesday) as `madeAt`, so a minute later the same check-in is none of Thursday's:
+ * "Chest (36 h left)" for the same work. The coach's "too soon" card and the hard start read it
+ * with no `madeAt` too, so during the workout itself the Plan screen disagrees with them from
+ * midnight on. Before the second review's fixes (80893d4) the two disagreed the other way round
+ * (the completion read no check-in at all).
+ *
+ * Synthetic data only.
+ */
+
+describe('the recovery line of a workout that runs past midnight', () => {
+  it('gives the completion and the Plan screen the same window', async () => {
+    const { store } = createTestStore({ now: () => clock.now });
+    await store.hydrate();
+    await store.completeOnboarding(
+      { ...createDefaultProfile(clock.now), bodyweight: 185 },
+      createDefaultLocations({ gymAccess: true }, clock.now),
+    );
+    await store.recalibrate({
+      type: 'readiness',
+      readiness: {
+        energy: 3,
+        soreness: 2,
+        sleep: 1,
+        motivation: 3,
+        jointDiscomfort: [],
+        timePressure: false,
+      },
+    });
+    store.startWorkout();
+    const entry = allEntries(store.getSnapshot().session!.workout.blocks)[0]!;
+    expect(entry.exerciseId).toBe('barbell-bench-press');
+    for (const set of entry.sets) {
+      if (set.kind === 'working') {
+        await store.logSet(entry.id, set.index, { reps: 5, weight: 185, rir: 2 });
+      }
+    }
+
+    // Thursday, 0:20: finished.
+    clock.now = '2026-09-03T00:20:00.000Z';
+    const completion = await store.finishWorkout(
+      { effort: 'right', pain: false, energyAfter: 4, note: '' },
+      { endedEarly: true },
+    );
+    const said = /Chest and Triceps about (\d+) h/.exec(completion.recoveryNote)?.[1];
+    expect(said).toBeDefined();
+
+    // A minute later, the Plan screen.
+    clock.now = '2026-09-03T00:21:00.000Z';
+    act(() => {
+      window.location.hash = '#/plan';
+    });
+    render(
+      <Providers store={store}>
+        <App />
+      </Providers>,
+    );
+    const balance = await screen.findByTestId('recovery-balance');
+    // A minute after the completion, the chest's window has its hours less one minute left.
+    expect(balance.textContent).toContain(`Chest (${said} h left)`);
+  });
+});
diff --git a/src/review-m33c/readEstimateAfterNewDay.store.test.ts b/src/review-m33c/readEstimateAfterNewDay.store.test.ts
